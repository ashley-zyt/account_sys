<%= form_with model: [:admin, account], class: "admin-form" do |f| %>
  <% if account.errors.any? %>
    <div class="admin-empty-state" style="margin-bottom: 12px;">
      <ul class="admin-list">
        <% account.errors.full_messages.each do |msg| %>
          <li class="admin-list-item">
            <div class="admin-list-title">
              <%= msg %>
            </div>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="admin-two-column">
    <div>
      <div class="admin-field-label">
        账号名
      </div>
      <%= f.text_field :account_name, class: "admin-input" %>
    </div>
    <div>
      <div class="admin-field-label">
        账号主页链接 <span style="color: #ef4444;">*</span>
      </div>
      <%= f.text_field :source_url, class: "admin-input", placeholder: "请输入账号主页 URL", required: true %>
    </div>
    <div>
      <div class="admin-field-label">
        主题 <span style="color: #ef4444;">*</span>
      </div>
      <%= render 'admin/shared/searchable_theme_select', 
        name: 'account[theme]', 
        themes: themes, 
        selected: account.theme, 
        placeholder: '请选择主题',
        include_blank: '请选择主题',
        required: true %>
    </div>
    <div>
      <div class="admin-field-label">
        平台 <span style="color: #ef4444;">*</span>
      </div>
      <%= f.select :platform, Account.platforms.keys.map { |k| [k, k] }, {}, class: "admin-input", required: true %>
    </div>
    <div>
      <div class="admin-field-label">
        状态
      </div>
      <%= f.select :status, Account.statuses.keys.map { |k| [k, k] }, {}, class: "admin-input" %>
    </div>
    <div>
      <div class="admin-field-label">
        工作模式 <span style="color: #ef4444;">*</span>
      </div>
      <%= f.select :work_type, Account.work_types.keys.map { |k| [k, k] }, {}, class: "admin-input", required: true %>
    </div>
    <div>
      <div class="admin-field-label">
        绑定浏览器
      </div>
      <%= f.collection_select :browser_id, Browser.order(:profile_name), :id, :profile_name, { include_blank: "不绑定" }, class: "admin-input" %>
    </div>
    <div>
      <div class="admin-field-label">
        运营人员
      </div>
      <%= f.select :operator, Account::OPERATORS.map { |o| [o, o] }, { include_blank: "请选择运营人员" }, class: "admin-input" %>
    </div>
    <div>
      <div class="admin-field-label">
        备注
      </div>
      <%= f.text_field :remark, class: "admin-input" %>
    </div>
  </div>

  <div style="margin-top: 16px;">
    <button type="submit" class="admin-button-primary">
      保存
    </button>
    <%= link_to "取消", admin_accounts_path, class: "admin-button-secondary" %>
  </div>
<% end %>
