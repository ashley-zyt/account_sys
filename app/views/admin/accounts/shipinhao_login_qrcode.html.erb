<% content_for :page_title do %>
  视频号登录二维码
<% end %>
<% content_for :page_subtitle do %>
  扫码登录视频号账号（profile: domestic01）
<% end %>

<div class="admin-card" style="max-width: 560px;">
  <div class="admin-card-header">
    <div>
      <div class="admin-card-title">
        视频号登录二维码
      </div>
      <div class="admin-card-subtitle">
        使用手机视频号 App 扫码登录
      </div>
    </div>
    <div class="admin-card-header-right">
      <button type="button" onclick="location.reload()" class="admin-button-secondary">
        刷新二维码
      </button>
    </div>
  </div>

  <% if @error %>
    <div style="padding: 40px 24px; text-align: center;">
      <div style="font-size: 32px; margin-bottom: 12px;">⚠️</div>
      <div style="color: var(--danger); font-size: 14px; margin-bottom: 8px;">
        <%= @error %>
      </div>
      <div style="color: var(--text-muted); font-size: 12px;">
        请确认远端接口已返回 base64 编码的 qrcode_image 后重试
      </div>
    </div>
  <% else %>
    <div style="display: flex; flex-direction: column; align-items: center; padding: 24px;">
      <img src="<%= @qrcode_data_uri %>"
           alt="视频号登录二维码"
           style="width: 280px; height: 280px; border: 1px solid var(--border-tertiary); border-radius: 8px;" />

      <div style="margin-top: 16px;">
        <% status_text = case @login_status
           when "waiting" then "等待扫码"
           when "scanned" then "已扫码，等待确认"
           when "success" then "登录成功"
           when "expired" then "二维码已过期"
           when "failed", "error" then "登录失败"
           else (@login_status.presence || "未知状态")
           end %>
        <% status_color = case @login_status
           when "success" then "var(--success)"
           when "expired", "failed", "error" then "var(--danger)"
           when "scanned" then "var(--warning)"
           else "var(--accent)"
           end %>
        <span class="admin-pill-status" style="color: <%= status_color %>; border: 1px solid <%= status_color %>;">
          登录状态：<%= status_text %>
        </span>
      </div>

      <% if @profile_id.present? %>
        <div style="margin-top: 10px; color: var(--text-muted); font-size: 12px;">
          profile_id：<%= @profile_id %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
