<% content_for :page_title do %>
  账号详情
<% end %>
<% content_for :page_subtitle do %>
  <%= @account.account_name %> 的基础信息与近期任务
<% end %>
<% content_for :head do %>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js" data-turbo-track="reload"></script>
<% end %>

<div class="admin-grid">
  <div class="admin-card">
    <div class="admin-card-header">
      <div>
        <div class="admin-card-title">
          基本信息
        </div>
        <div class="admin-card-subtitle">
          账号配置与绑定情况
        </div>
      </div>
      <div class="admin-card-header-right">
        <%= link_to "编辑账号", edit_admin_account_path(@account), class: "admin-button-secondary" %>
      </div>
    </div>

    <div class="admin-two-column">
      <div>
        <div class="admin-field-label">
          账号名
        </div>
        <div class="admin-field-value">
          <%= @account.account_name %>
        </div>
      </div>
      <div>
        <div class="admin-field-label">
          账号主页
        </div>
        <div class="admin-field-value">
          <% if @account.source_url.present? %>
            <%= link_to @account.source_url, @account.source_url, target: "_blank", class: "admin-link-quiet", style: "color: var(--accent);" %>
          <% else %>
            未设置
          <% end %>
        </div>
      </div>
      <div>
        <div class="admin-field-label">
          主题
        </div>
        <div class="admin-field-value">
          <%= @account.theme %>
        </div>
      </div>
      <div>
        <div class="admin-field-label">
          平台
        </div>
        <div class="admin-field-value">
          <%= @account.platform %>
        </div>
      </div>
      <div>
        <div class="admin-field-label">
          工作模式
        </div>
        <div class="admin-field-value">
          <%= @account.work_type %>
        </div>
      </div>
      <div>
        <div class="admin-field-label">
          状态
        </div>
        <div class="admin-field-value">
          <%= @account.status %>
        </div>
      </div>
      <div>
        <div class="admin-field-label">
          创建时间
        </div>
        <div class="admin-field-value">
          <%= @account.created_at&.strftime("%Y-%m-%d %H:%M") %>
        </div>
      </div>
      <div>
        <div class="admin-field-label">
          最后使用时间
        </div>
        <div class="admin-field-value">
          <%= @account.last_used_at&.strftime("%Y-%m-%d %H:%M") || "暂无" %>
        </div>
      </div>
      <div>
        <div class="admin-field-label">
          备注
        </div>
        <div class="admin-field-value">
          <%= @account.remark.presence || "无" %>
        </div>
      </div>
    </div>

    <div class="admin-section-title" style="margin-top: 14px;">
      浏览器绑定
    </div>
    <div class="admin-section-subtitle">
      指纹浏览器及代理信息
    </div>

    <% if @account.browser %>
      <div class="admin-two-column">
        <div>
          <div class="admin-field-label">
            浏览器名称
          </div>
          <div class="admin-field-value">
            <%= @account.browser.profile_name %>
          </div>
        </div>
        <div>
          <div class="admin-field-label">
            云端 ID
          </div>
          <div class="admin-field-value">
            <%= @account.browser.cloud_id %>
          </div>
        </div>
        <div>
          <div class="admin-field-label">
            运营机器 IP
          </div>
          <div class="admin-field-value">
            <% if @account.browser.machine_ip.present? %>
              <span class="admin-pill-status" style="background: rgba(59, 130, 246, 0.1); color: #3b82f6;">
                <%= @account.browser.machine_ip %>
              </span>
            <% else %>
              <span class="admin-label-muted">未设置</span>
            <% end %>
          </div>
        </div>
      </div>
    <% else %>
      <div class="admin-empty-state">
        当前账号未绑定浏览器。
      </div>
    <% end %>

    <div class="admin-section-title" style="margin-top: 14px;">
      养号配置
    </div>
    <div class="admin-section-subtitle">
      自动养号任务设置
    </div>

    <% if @account.warmup_profile %>
      <div class="admin-two-column">
        <div>
          <div class="admin-field-label">
            养号开关
          </div>
          <div class="admin-field-value">
            <%= link_to toggle_warmup_admin_account_path(@account), data: { turbo_method: :post, turbo_confirm: "确定要#{ @account.warmup_profile.warmup_enabled ? '停止' : '启用' }养号吗？" } do %>
              <% if @account.warmup_profile.warmup_enabled %>
                <span class="admin-pill-status" style="background: rgba(34, 197, 94, 0.1); color: #22c55e; cursor: pointer;">
                  <span class="admin-pill-status-dot"></span>
                  已启用（点击停止）
                </span>
              <% else %>
                <span class="admin-pill-status" style="background: rgba(156, 163, 175, 0.1); color: #9ca3af; cursor: pointer;">
                  <span class="admin-pill-status-dot"></span>
                  已停止（点击启用）
                </span>
              <% end %>
            <% end %>
          </div>
        </div>
        <div>
          <div class="admin-field-label">
            最后养号时间
          </div>
          <div class="admin-field-value">
            <%= @account.warmup_profile.last_warmup_at&.strftime("%Y-%m-%d %H:%M") || "暂无" %>
          </div>
        </div>
        <div>
          <div class="admin-field-label">
            养号状态
          </div>
          <div class="admin-field-value">
            <% if @account.warmup_profile.warmup_status == 'success' %>
              <span class="admin-pill-status" style="background: rgba(34, 197, 94, 0.1); color: #22c55e;">成功</span>
            <% elsif @account.warmup_profile.warmup_status == 'failed' %>
              <span class="admin-pill-status" style="background: rgba(239, 68, 68, 0.1); color: #ef4444;">失败</span>
            <% else %>
              <span class="admin-pill-status" style="background: rgba(156, 163, 175, 0.1); color: #9ca3af;">未执行</span>
            <% end %>
          </div>
        </div>
        <div>
          <div class="admin-field-label">
            运营机器
          </div>
          <div class="admin-field-value">
            <% if @account.browser&.machine_ip.present? %>
              <span class="admin-pill-status" style="background: rgba(59, 130, 246, 0.1); color: #3b82f6;">
                <%= @account.browser.machine_ip %>
              </span>
            <% else %>
              <span class="admin-label-muted">未设置</span>
            <% end %>
          </div>
        </div>
      </div>
    <% else %>
      <div class="admin-empty-state">
        暂无养号配置。
      </div>
    <% end %>
  </div>

  <div class="admin-card">
    <div class="admin-card-header">
      <div>
        <div class="admin-card-title">
          近期任务日志
        </div>
        <div class="admin-card-subtitle">
          该账号最近 10 条任务执行日志
        </div>
      </div>
      <div class="admin-card-header-right">
        <%= link_to "查看全部日志", admin_task_logs_path(q: { account_id_eq: @account.id }), class: "admin-button-secondary" %>
      </div>
    </div>

    <% if @recent_task_logs.any? %>
      <div class="admin-table-wrapper admin-table-scroll">
        <table class="admin-table">
          <thead>
            <tr>
              <th>
                任务类型
              </th>
              <th>
                任务 UUID
              </th>
              <th>
                浏览器
              </th>
              <th>
                状态
              </th>
              <th>
                执行时间
              </th>
              <th>
                错误信息
              </th>
            </tr>
          </thead>
          <tbody>
            <% @recent_task_logs.each do |log| %>
              <tr>
                <td>
                  <% task_type = log.task_type %>
                  <% if task_type == "搬运任务" %>
                    <span class="admin-pill-status" style="background: rgba(34, 197, 94, 0.1); color: #22c55e;">
                      搬运任务
                    </span>
                  <% elsif task_type == "剪映任务" %>
                    <span class="admin-pill-status" style="background: rgba(59, 130, 246, 0.1); color: #3b82f6;">
                      剪映任务
                    </span>
                  <% elsif task_type == "运营任务" %>
                    <span class="admin-pill-status" style="background: rgba(168, 85, 247, 0.1); color: #a855f7;">
                      运营任务
                    </span>
                  <% elsif task_type == "Heygen任务" %>
                    <span class="admin-pill-status" style="background: rgba(236, 72, 153, 0.1); color: #ec4899;">
                      Heygen任务
                    </span>
                  <% else %>
                    <span class="admin-label-muted">
                      <%= task_type %>
                    </span>
                  <% end %>
                </td>
                <td>
                  <%= link_to truncate(log.task_uuid, length: 15), admin_task_log_path(log), class: "admin-link-quiet", title: log.task_uuid %>
                </td>
                <td>
                  <% br = log.display_browser %>
                  <% if br %>
                    <%= link_to br.profile_name, admin_browser_path(br), class: "admin-link-quiet", style: "color: var(--accent);" %>
                  <% else %>
                    <span class="admin-label-muted">未绑定</span>
                  <% end %>
                </td>
                <td>
                  <% if log.status == "success" %>
                    <span class="admin-pill-status admin-pill-status-success">
                      <span class="admin-pill-status-dot"></span>
                      成功
                    </span>
                  <% else %>
                    <span class="admin-pill-status admin-pill-status-failed">
                      <span class="admin-pill-status-dot"></span>
                      失败
                    </span>
                  <% end %>
                </td>
                <td>
                  <span class="admin-label-muted">
                    <%= log.run_at&.strftime("%Y-%m-%d %H:%M") %>
                  </span>
                </td>
                <td>
                  <span class="admin-label-muted" title="<%= log.error_msg %>">
                    <%= truncate(log.error_msg.to_s, length: 40) %>
                  </span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="admin-empty-state">
        暂无相关日志。
      </div>
    <% end %>
  </div>
</div>

<%# 粉丝量/发帖量历史趋势 %>
<div class="admin-card" style="margin-top: 16px;">
  <div class="admin-card-header">
    <div>
      <div class="admin-card-title">
        粉丝量历史趋势
      </div>
      <div class="admin-card-subtitle">
        近 30 天粉丝数与发帖数变化
      </div>
    </div>
    <div class="admin-card-header-right">
      <% if @follower_history.any? %>
        <span class="admin-label-muted">最新粉丝：<strong style="color: var(--text-primary);"><%= number_with_delimiter(@follower_history.last.followers_count || 0) %></strong></span>
      <% end %>
    </div>
  </div>

  <% if @follower_history.any? %>
    <div style="position: relative; height: 260px; padding: 12px;">
      <canvas id="followerHistoryChart"></canvas>
    </div>
  <% else %>
    <div class="admin-empty-state">
      暂无历史数据，请先运行采集。
    </div>
  <% end %>
</div>

<div class="admin-card" style="margin-top: 16px;">
  <div class="admin-card-header">
    <div>
      <div class="admin-card-title">
        最近发文数据
      </div>
      <div class="admin-card-subtitle">
        采集到的最近 10 条发文统计数据
      </div>
    </div>
    <div class="admin-card-header-right">
      <%= link_to "查看全部", admin_post_stats_path(q: { account_id_eq: @account.id }), class: "admin-button-secondary" %>
    </div>
  </div>

  <% if @recent_post_stats.any? %>
    <div class="admin-table-wrapper admin-table-scroll">
      <table class="admin-table">
        <thead>
          <tr>
            <th>发文日期</th>
            <th>标题</th>
            <th>浏览</th>
            <th>点赞</th>
            <th>评论</th>
            <th>转发</th>
            <th>链接</th>
          </tr>
        </thead>
        <tbody>
          <% @recent_post_stats.each do |stat| %>
            <tr>
              <td>
                <span class="admin-label-muted">
                  <%= stat.post_date&.strftime("%Y-%m-%d") %>
                </span>
              </td>
              <td>
                <span title="<%= stat.title %>">
                  <%= truncate(stat.title.to_s, length: 25) %>
                </span>
              </td>
              <td>
                <span class="admin-label-muted">
                  <%= stat.views_count || 0 %>
                </span>
              </td>
              <td>
                <span class="admin-label-muted">
                  <%= stat.likes_count || 0 %>
                </span>
              </td>
              <td>
                <span class="admin-label-muted">
                  <%= stat.comments_count || 0 %>
                </span>
              </td>
              <td>
                <span class="admin-label-muted">
                  <%= stat.shares_count || 0 %>
                </span>
              </td>
              <td>
                <% if stat.url.present? %>
                  <%= link_to "查看", stat.url, target: "_blank", class: "admin-link-quiet", style: "color: var(--accent);", title: stat.url %>
                <% else %>
                  <span class="admin-label-muted">—</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="admin-empty-state">
      暂无发文数据。
    </div>
  <% end %>
</div>

<div class="admin-card" style="margin-top: 16px;">
  <div class="admin-card-header">
    <div>
      <div class="admin-card-title">
        最近养号记录
      </div>
      <div class="admin-card-subtitle">
        该账号最近 10 条养号任务记录
      </div>
    </div>
    <div class="admin-card-header-right">
      <%= link_to "查看全部", admin_warmup_tasks_path(q: { account_id_eq: @account.id }), class: "admin-button-secondary" %>
    </div>
  </div>

  <% if @recent_warmup_tasks.any? %>
    <div class="admin-table-wrapper admin-table-scroll">
      <table class="admin-table">
        <thead>
          <tr>
            <th>平台</th>
            <th>状态</th>
            <th>执行时间</th>
            <th>耗时(分)</th>
            <th>运营机器</th>
            <th>错误信息</th>
          </tr>
        </thead>
        <tbody>
          <% @recent_warmup_tasks.each do |task| %>
            <tr>
              <td>
                <span class="admin-label-muted">
                  <%= task.platform %>
                </span>
              </td>
              <td>
                <% if task.status == "success" %>
                  <span class="admin-pill-status admin-pill-status-success">
                    <span class="admin-pill-status-dot"></span>
                    成功
                  </span>
                <% elsif task.status == "failed" %>
                  <span class="admin-pill-status admin-pill-status-failed">
                    <span class="admin-pill-status-dot"></span>
                    失败
                  </span>
                <% elsif task.status == "executing" %>
                  <span class="admin-pill-status" style="background: rgba(59, 130, 246, 0.1); color: #3b82f6;">
                    <span class="admin-pill-status-dot"></span>
                    执行中
                  </span>
                <% else %>
                  <span class="admin-pill-status" style="background: rgba(156, 163, 175, 0.1); color: #9ca3af;">
                    <span class="admin-pill-status-dot"></span>
                    待执行
                  </span>
                <% end %>
              </td>
              <td>
                <span class="admin-label-muted">
                  <%= task.executed_at&.strftime("%Y-%m-%d %H:%M") || "—" %>
                </span>
              </td>
              <td>
                <span class="admin-label-muted">
                  <%= task.duration_minutes || "—" %>
                </span>
              </td>
              <td>
                <% if task.machine.present? %>
                  <span class="admin-pill-status" style="background: rgba(59, 130, 246, 0.1); color: #3b82f6;">
                    <%= task.machine %>
                  </span>
                <% else %>
                  <span class="admin-label-muted">—</span>
                <% end %>
              </td>
              <td>
                <span class="admin-label-muted" title="<%= task.error_msg %>">
                  <%= truncate(task.error_msg.to_s, length: 40) %>
                </span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="admin-empty-state">
      暂无养号记录。
    </div>
  <% end %>
</div>

<% if @follower_history.any? %>
<script data-turbo-track="reload">
document.addEventListener('DOMContentLoaded', function() {
  const ctx = document.getElementById('followerHistoryChart');
  if (!ctx) return;

  const labels = <%= raw @follower_history.pluck(:stat_date).map { |d| d.strftime('%m-%d') }.to_json %>;
  const followersData = <%= raw @follower_history.pluck(:followers_count).map { |v| v || 0 }.to_json %>;
  const postsData = <%= raw @follower_history.pluck(:total_posts_count).map { |v| v || 0 }.to_json %>;

  new Chart(ctx, {
    type: 'line',
    data: {
      labels: labels,
      datasets: [
        {
          label: '粉丝数',
          data: followersData,
          borderColor: '#3b82f6',
          backgroundColor: 'rgba(59, 130, 246, 0.1)',
          fill: true,
          tension: 0.3,
          yAxisID: 'y',
          pointRadius: 3,
          pointHoverRadius: 5
        },
        {
          label: '发帖数',
          data: postsData,
          borderColor: '#22c55e',
          backgroundColor: 'rgba(34, 197, 94, 0.05)',
          fill: false,
          tension: 0.3,
          yAxisID: 'y1',
          pointRadius: 3,
          pointHoverRadius: 5
        }
      ]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      interaction: {
        mode: 'index',
        intersect: false
      },
      plugins: {
        legend: {
          position: 'top',
          labels: {
            usePointStyle: true,
            padding: 20
          }
        },
        tooltip: {
          backgroundColor: 'rgba(15, 23, 42, 0.9)',
          padding: 12,
          cornerRadius: 8,
          titleFont: { size: 13, weight: '600' },
          bodyFont: { size: 12 }
        }
      },
      scales: {
        x: {
          grid: {
            display: false
          },
          ticks: {
            color: '#64748b',
            font: { size: 11 }
          }
        },
        y: {
          type: 'linear',
          display: true,
          position: 'left',
          title: {
            display: true,
            text: '粉丝数',
            color: '#3b82f6',
            font: { size: 11, weight: '500' }
          },
          grid: {
            color: 'rgba(226, 232, 240, 0.5)'
          },
          ticks: {
            color: '#64748b',
            font: { size: 11 }
          }
        },
        y1: {
          type: 'linear',
          display: true,
          position: 'right',
          title: {
            display: true,
            text: '发帖数',
            color: '#22c55e',
            font: { size: 11, weight: '500' }
          },
          grid: {
            drawOnChartArea: false
          },
          ticks: {
            color: '#64748b',
            font: { size: 11 }
          }
        }
      }
    }
  });
});
</script>
<% end %>

