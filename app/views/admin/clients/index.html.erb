<% content_for :page_title do %>
  客户列表
<% end %>
<% content_for :page_subtitle do %>
  客户托管模块的客户管理
<% end %>

<div class="admin-card">
  <div class="admin-card-header">
    <div>
      <div class="admin-card-title">客户列表</div>
      <div class="admin-card-subtitle">客户托管模块的客户信息</div>
    </div>
    <div class="admin-card-header-right">
      <span class="admin-tag">共 <%= @clients.total_count %> 条</span>
      <%= link_to "添加客户", new_admin_client_path, class: "admin-button-primary" %>
    </div>
  </div>

  <% if @clients.any? %>
    <div class="admin-table-wrapper admin-table-scroll">
      <table class="admin-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>名称</th>
            <th>联系人</th>
            <th>联系方式</th>
            <th>状态</th>
            <th>备注</th>
            <th>创建时间</th>
            <th>操作</th>
          </tr>
        </thead>
        <tbody>
          <% status_labels = { "active" => "合作中", "paused" => "暂停", "terminated" => "终止" } %>
          <% @clients.each do |c| %>
            <tr>
              <td><span class="admin-label-muted"><%= c.id %></span></td>
              <td><%= c.name %></td>
              <td><%= c.contact || '-' %></td>
              <td><%= c.contact_info || '-' %></td>
              <td><span class="admin-label-muted"><%= status_labels[c.status] || c.status %></span></td>
              <td><span class="admin-label-muted" title="<%= c.remark.to_s %>"><%= truncate(c.remark.to_s, length: 20) %></span></td>
              <td><span class="admin-label-muted"><%= c.created_at&.strftime('%m-%d %H:%M') %></span></td>
              <td>
                <div style="display: flex; gap: 8px;">
                  <%= link_to "编辑", edit_admin_client_path(c), class: "admin-link-quiet", style: "color: var(--accent);" %>
                  <%= link_to "删除", admin_client_path(c), data: { turbo_method: :delete, turbo_confirm: "确定删除该客户吗？" }, class: "admin-link-quiet", style: "color: var(--danger);" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <div class="admin-pagination">
      <%= paginate @clients %>
    </div>
  <% else %>
    <div class="admin-empty-state">暂无客户数据。</div>
  <% end %>
</div>
