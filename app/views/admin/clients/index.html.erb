<% content_for :page_title do %>
  客户列表
<% end %>
<% content_for :page_subtitle do %>
  客户托管模块的客户管理
<% end %>

<div class="admin-card">
  <div class="admin-card-header">
    <div>
      <div class="admin-card-title">客户列表</div>
      <div class="admin-card-subtitle">客户托管模块的客户信息</div>
    </div>
    <div class="admin-card-header-right">
      <span class="admin-tag">共 <%= @clients.total_count %> 条</span>
      <button type="button" class="admin-button-primary" onclick="openNewClientModal()">添加客户</button>
    </div>
  </div>

  <% if @clients.any? %>
    <div class="admin-table-wrapper admin-table-scroll">
      <table class="admin-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>名称</th>
            <th>联系人</th>
            <th>联系方式</th>
            <th>状态</th>
            <th>备注</th>
            <th>创建时间</th>
            <th>操作</th>
          </tr>
        </thead>
        <tbody>
          <% status_labels = { "active" => "合作中", "paused" => "暂停", "terminated" => "终止" } %>
          <% @clients.each do |c| %>
            <tr>
              <td><span class="admin-label-muted"><%= c.id %></span></td>
              <td><%= c.name %></td>
              <td><%= c.contact || '-' %></td>
              <td><%= c.contact_info || '-' %></td>
              <td><span class="admin-label-muted"><%= status_labels[c.status] || c.status %></span></td>
              <td><span class="admin-label-muted" title="<%= c.remark.to_s %>"><%= truncate(c.remark.to_s, length: 20) %></span></td>
              <td><span class="admin-label-muted"><%= c.created_at&.strftime('%m-%d %H:%M') %></span></td>
              <td>
                <div style="display: flex; gap: 8px;">
                  <button type="button" onclick="openEditClientModal(<%= c.id %>)" class="admin-link-quiet" style="color: var(--accent); background: none; border: none; cursor: pointer; padding: 0;">编辑</button>
                  <%= link_to "删除", admin_client_path(c), data: { turbo_method: :delete, turbo_confirm: "确定删除该客户吗？" }, class: "admin-link-quiet", style: "color: var(--danger);" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <div class="admin-pagination">
      <%= paginate @clients %>
    </div>
  <% else %>
    <div class="admin-empty-state">暂无客户数据。</div>
  <% end %>
</div>

<div id="client-modal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.7); z-index: 1000; justify-content: center; align-items: center;">
  <div style="background: #1e293b; border-radius: 12px; width: 520px; max-width: 90%; max-height: 90%; overflow: hidden;">
    <iframe id="client-iframe" style="width: 100%; height: 100%; border: none; min-height: 520px;" src=""></iframe>
  </div>
</div>

<script>
  var clientModal = document.getElementById('client-modal');
  var clientIframe = document.getElementById('client-iframe');

  function openNewClientModal() {
    clientIframe.src = '<%= new_modal_admin_clients_path %>';
    clientModal.style.display = 'flex';
  }

  function openEditClientModal(id) {
    clientIframe.src = '/admin/clients/' + id + '/edit_modal';
    clientModal.style.display = 'flex';
  }

  function closeClientModal(refresh) {
    clientModal.style.display = 'none';
    clientIframe.src = '';
    if (refresh) { location.reload(); }
  }

  clientModal.addEventListener('click', function(e) {
    if (e.target === clientModal) { closeClientModal(false); }
  });
</script>
