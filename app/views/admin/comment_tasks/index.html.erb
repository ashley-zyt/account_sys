<% content_for :page_title do %>
  评论任务
<% end %>
<% content_for :page_subtitle do %>
  大V评论互动的评论任务与执行结果
<% end %>

<%= render "admin/shared/select_widgets" %>

<div class="admin-card">
  <div class="admin-card-header">
    <div>
      <div class="admin-card-title">评论任务列表</div>
      <div class="admin-card-subtitle">查看每个账号对发文评论的执行结果</div>
    </div>
    <div class="admin-card-header-right">
      <span class="admin-tag">共 <%= @comment_tasks.total_count %> 条</span>
    </div>
  </div>

  <div class="admin-filter-form">
    <%= search_form_for [:admin, @q], class: "admin-filter-form" do |f| %>
      <div class="admin-filter-group">
        <label class="admin-filter-label">状态</label>
        <% labels = { "pending" => "待评论", "queued" => "已下发", "running" => "执行中", "success" => "成功", "failed" => "失败" } %>
        <%= f.searchable_select :status_eq, CommentTask.statuses.map { |k, v| [labels[k.to_s] || k.to_s, v] }, { include_blank: "所有状态" }, class: "admin-input admin-filter-input" %>
      </div>
      <div style="margin-left: auto;">
        <%= f.submit "筛选", class: "admin-button-primary" %>
        <%= link_to "重置", admin_comment_tasks_path, class: "admin-button-secondary" %>
      </div>
    <% end %>
  </div>

  <% if @comment_tasks.any? %>
    <div class="admin-table-wrapper admin-table-scroll">
      <table class="admin-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>发文 ID</th>
            <th>发文标题</th>
            <th>账号</th>
            <th>评论内容</th>
            <th>状态</th>
            <th>失败原因</th>
            <th>执行时间</th>
            <th>创建时间</th>
            <th>操作</th>
          </tr>
        </thead>
        <tbody>
          <% @comment_tasks.each do |t| %>
            <tr>
              <td>
                <span class="admin-label-muted"><%= t.id %></span>
              </td>
              <td>
                <% post = t.influencer_post %>
                <button type="button"
                        class="admin-link-quiet"
                        style="background:none;border:none;padding:0;cursor:pointer;color:var(--accent);"
                        onclick="showPostModal(this)"
                        data-post-id="<%= post&.post_id.to_s %>"
                        data-title="<%= post&.title.to_s %>"
                        data-source-url="<%= post&.source_url.to_s %>"
                        data-influencer="<%= post&.influencer&.username.to_s %>"
                        data-posted-at="<%= post&.posted_at&.strftime('%Y-%m-%d %H:%M') %>">
                  <%= post&.post_id || post&.id || '-' %>
                </button>
              </td>
              <td>
                <span class="admin-label-muted" title="<%= t.influencer_post&.title.to_s %>"><%= truncate(t.influencer_post&.title.to_s, length: 20) %></span>
              </td>
              <td>
                <% if t.account %>
                  <%= link_to truncate(t.account.account_name, length: 20), admin_account_path(t.account), class: "admin-link-quiet" %>
                <% else %>
                  <span class="admin-label-muted">-</span>
                <% end %>
              </td>
              <td>
                <span class="admin-label-muted" title="<%= t.comment_content.to_s %>"><%= truncate(t.comment_content.to_s, length: 20) %></span>
              </td>
              <td>
                <% case t.status %>
                <% when "pending" %>
                  <span class="admin-pill-status admin-pill-status-pending"><span class="admin-pill-status-dot"></span>待评论</span>
                <% when "queued" %>
                  <span class="admin-pill-status admin-pill-status-pending"><span class="admin-pill-status-dot"></span>已下发</span>
                <% when "running" %>
                  <span class="admin-pill-status admin-pill-status-pending"><span class="admin-pill-status-dot"></span>执行中</span>
                <% when "success" %>
                  <span class="admin-pill-status admin-pill-status-success"><span class="admin-pill-status-dot"></span>成功</span>
                <% when "failed" %>
                  <span class="admin-pill-status admin-pill-status-failed"><span class="admin-pill-status-dot"></span>失败</span>
                <% end %>
              </td>
              <td>
                <span class="admin-label-muted"><%= truncate(t.error_msg.to_s, length: 30) %></span>
              </td>
              <td>
                <span class="admin-label-muted"><%= t.executed_at&.strftime('%m-%d %H:%M') || '-' %></span>
              </td>
              <td>
                <span class="admin-label-muted"><%= t.created_at&.strftime('%m-%d %H:%M') %></span>
              </td>
              <td>
                <% if %w[pending failed].include?(t.status) %>
                  <%= link_to "执行", execute_admin_comment_task_path(t), data: { turbo_method: :post, turbo_confirm: "确定手动执行该评论任务吗？" }, class: "admin-link-quiet", style: "color: var(--success);" %>
                <% else %>
                  <span class="admin-label-muted">-</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <div class="admin-pagination">
      <%= paginate @comment_tasks %>
    </div>
  <% else %>
    <div class="admin-empty-state">暂无评论任务数据。</div>
  <% end %>
</div>

<div id="post-modal-backdrop" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.55); z-index:9999; align-items:center; justify-content:center; padding:20px;">
  <div style="background:#0f172a; border:1px solid #334155; border-radius:10px; max-width:640px; width:100%; max-height:80vh; overflow:auto; padding:24px; color:#e2e8f0;">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
      <div style="font-size:16px; font-weight:600;">发文详情</div>
      <button type="button" onclick="hidePostModal()" style="background:none;border:none;color:#94a3b8;font-size:22px;cursor:pointer;line-height:1;">&times;</button>
    </div>
    <div id="post-modal-body"></div>
  </div>
</div>

<script>
  function showPostModal(btn) {
    var d = btn.dataset;
    var html = '';
    html += '<div style="margin-bottom:14px;"><div style="color:#64748b;font-size:12px;margin-bottom:4px;">发文 ID</div><div>' + (esc(d.postId) || '-') + '</div></div>';
    html += '<div style="margin-bottom:14px;"><div style="color:#64748b;font-size:12px;margin-bottom:4px;">大V</div><div>' + (esc(d.influencer) || '-') + '</div></div>';
    html += '<div style="margin-bottom:14px;"><div style="color:#64748b;font-size:12px;margin-bottom:4px;">发文时间</div><div>' + (esc(d.postedAt) || '-') + '</div></div>';
    html += '<div style="margin-bottom:14px;"><div style="color:#64748b;font-size:12px;margin-bottom:4px;">发文内容</div><div style="white-space:pre-wrap;line-height:1.6;">' + (esc(d.title) || '-') + '</div></div>';
    if (d.sourceUrl) {
      html += '<div><a href="' + esc(d.sourceUrl) + '" target="_blank" rel="noopener" style="color:#3b82f6;">查看原文 ↗</a></div>';
    }
    document.getElementById('post-modal-body').innerHTML = html;
    document.getElementById('post-modal-backdrop').style.display = 'flex';
  }
  function hidePostModal() {
    document.getElementById('post-modal-backdrop').style.display = 'none';
  }
  function esc(s) {
    return String(s == null ? '' : s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
  }
  document.getElementById('post-modal-backdrop').addEventListener('click', function(e) {
    if (e.target === this) hidePostModal();
  });
</script>
