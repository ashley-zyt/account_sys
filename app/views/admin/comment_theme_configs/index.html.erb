<% content_for :page_title do %>
  评论 Prompt 配置
<% end %>
<% content_for :page_subtitle do %>
  每个主题对应一类评论互动 prompt（针对大V发文生成互动性评论）
<% end %>

<div class="admin-card">
  <div class="admin-card-header">
    <div>
      <div class="admin-card-title">评论 Prompt 列表</div>
      <div class="admin-card-subtitle">维护「主题 → 评论 prompt」映射</div>
    </div>
    <div class="admin-card-header-right">
      <span class="admin-tag">共 <%= @configs.total_count %> 条</span>
      <%= link_to "添加 Prompt", new_admin_comment_theme_config_path, class: "admin-button-primary" %>
    </div>
  </div>

  <% if @configs.any? %>
    <div class="admin-table-wrapper admin-table-scroll">
      <table class="admin-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>主题</th>
            <th>Prompt</th>
            <th>创建时间</th>
            <th>操作</th>
          </tr>
        </thead>
        <tbody>
          <% @configs.each do |c| %>
            <tr>
              <td><span class="admin-label-muted"><%= c.id %></span></td>
              <td><%= c.theme %></td>
              <td>
                <span class="admin-label-muted" title="<%= c.prompt.to_s %>"><%= truncate(c.prompt.to_s, length: 50) %></span>
              </td>
              <td><span class="admin-label-muted"><%= c.created_at&.strftime('%m-%d %H:%M') %></span></td>
              <td>
                <div style="display: flex; gap: 8px;">
                  <%= link_to "编辑", edit_admin_comment_theme_config_path(c), class: "admin-link-quiet", style: "color: var(--accent);" %>
                  <%= link_to "删除", admin_comment_theme_config_path(c), data: { turbo_method: :delete, turbo_confirm: "确定删除该 Prompt 配置吗？" }, class: "admin-link-quiet", style: "color: var(--danger);" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <div class="admin-pagination">
      <%= paginate @configs %>
    </div>
  <% else %>
    <div class="admin-empty-state">暂无评论 Prompt 配置。</div>
  <% end %>
</div>
