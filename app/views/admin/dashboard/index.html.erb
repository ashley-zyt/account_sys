<% content_for :page_title do %>
  仪表盘
<% end %>
<% content_for :page_subtitle do %>
  账号与任务运行情况一览
<% end %>

<div class="admin-card" style="margin-bottom: 16px;">
  <div class="admin-card-header">
    <div>
      <div class="admin-card-title">
        今日概览
      </div>
      <div class="admin-card-subtitle">
        今天系统发布执行的整体情况
      </div>
    </div>
  </div>
  <div class="admin-metric-row">
    <div class="admin-metric">
      <div class="admin-metric-label">
        今日发布
      </div>
      <div class="admin-metric-value">
        <%= @today_logs_count %>
      </div>
      <div class="admin-metric-trend">
        全部任务
      </div>
    </div>
    <div class="admin-metric">
      <div class="admin-metric-label">
        今日成功
      </div>
      <div class="admin-metric-value">
        <%= @today_success_count %>
      </div>
      <div class="admin-metric-trend admin-metric-trend-up">
        已发布
      </div>
    </div>
    <div class="admin-metric">
      <div class="admin-metric-label">
        今日失败
      </div>
      <div class="admin-metric-value">
        <%= @today_errors_count %>
      </div>
      <div class="admin-metric-trend admin-metric-trend-down">
        需关注
      </div>
    </div>
    <div class="admin-metric">
      <div class="admin-metric-label">
        成功率
      </div>
      <div class="admin-metric-value">
        <%= @today_success_rate %>%
      </div>
      <div class="admin-metric-trend">
        今日
      </div>
    </div>
    <div class="admin-metric">
      <div class="admin-metric-label">
        待发布
      </div>
      <div class="admin-metric-value">
        <%= @pending_publish_count %>
      </div>
      <div class="admin-metric-trend">
        已分配
      </div>
    </div>
  </div>
</div>

<div class="admin-card" style="margin-bottom: 16px;">
  <div class="admin-card-header">
    <div>
      <div class="admin-card-title">
        账号资产矩阵
      </div>
      <div class="admin-card-subtitle">
        各工作模式账号状态一览
      </div>
    </div>
    <div class="admin-card-header-right">
      <%= link_to admin_accounts_path, class: "admin-tag admin-tag-accent" do %>
        总计 <%= @account_matrix_totals[:total] %> 个
      <% end %>
    </div>
  </div>

  <div class="admin-table-wrapper" style="border: none; background: transparent; padding: 0;">
    <table class="admin-table">
      <thead>
        <tr>
          <th>工作模式</th>
          <th style="text-align: center;">正常</th>
          <th style="text-align: center;">未登录</th>
          <th style="text-align: center;">封禁</th>
          <th style="text-align: center;">总计</th>
        </tr>
      </thead>
      <tbody>
        <% @account_matrix.each_with_index do |row, index| %>
          <% mode = row[:mode] %>
          <tr>
            <td>
              <span style="margin-right: 6px;"><%= mode.icon %></span><%= mode.name %>
              <button type="button" onclick="openPlatformModal(<%= index %>)" style="margin-left: 10px; background: transparent; border: 1px solid var(--border-secondary); color: var(--accent); border-radius: 4px; padding: 2px 8px; font-size: 11px; cursor: pointer;">详情</button>
            </td>
            <td style="text-align: center;">
              <%= link_to row[:active], admin_accounts_path(q: { work_type_eq: mode.enum_value, status_eq: 0 }), class: "admin-link-quiet", style: "color: var(--success); font-weight: 600;" %>
            </td>
            <td style="text-align: center;">
              <%= link_to row[:unlogged], admin_accounts_path(q: { work_type_eq: mode.enum_value, status_eq: 1 }), class: "admin-link-quiet", style: "color: var(--warning); font-weight: 600;" %>
            </td>
            <td style="text-align: center;">
              <%= link_to row[:banned], admin_accounts_path(q: { work_type_eq: mode.enum_value, status_eq: 2 }), class: "admin-link-quiet", style: "color: var(--danger); font-weight: 600;" %>
            </td>
            <td style="text-align: center; font-weight: 600;">
              <%= link_to row[:total], admin_accounts_path(q: { work_type_eq: mode.enum_value }), class: "admin-link-quiet", style: "font-weight: 600;" %>
            </td>
          </tr>
        <% end %>
        <tr style="background: rgba(15, 23, 42, 0.3); font-weight: 600;">
          <td>合计</td>
          <td style="text-align: center; color: var(--success);"><%= @account_matrix_totals[:active] %></td>
          <td style="text-align: center; color: var(--warning);"><%= @account_matrix_totals[:unlogged] %></td>
          <td style="text-align: center; color: var(--danger);"><%= @account_matrix_totals[:banned] %></td>
          <td style="text-align: center;"><%= @account_matrix_totals[:total] %></td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

<div class="admin-card" style="margin-bottom: 16px;">
  <div class="admin-card-header">
    <div>
      <div class="admin-card-title">
        浏览器健康
      </div>
      <div class="admin-card-subtitle">
        指纹浏览器池状态
      </div>
    </div>
    <div class="admin-card-header-right">
      <%= link_to admin_browsers_path, class: "admin-tag admin-tag-accent" do %>
        查看全部
      <% end %>
    </div>
  </div>
  <div class="admin-metric-row">
    <%= link_to admin_browsers_path, class: "admin-metric admin-link-card" do %>
      <div class="admin-metric-label">
        正常
      </div>
      <div class="admin-metric-value">
        <%= @browsers_normal %>
      </div>
      <div class="admin-metric-trend admin-metric-trend-up">
        可用
      </div>
    <% end %>
    <%= link_to admin_browsers_path(q: { status_eq: 1 }), class: "admin-metric admin-link-card" do %>
      <div class="admin-metric-label">
        网络问题
      </div>
      <div class="admin-metric-value">
        <%= @browsers_network_error %>
      </div>
      <div class="admin-metric-trend">
        需检查
      </div>
    <% end %>
    <%= link_to admin_browsers_path(q: { status_eq: 2 }), class: "admin-metric admin-link-card" do %>
      <div class="admin-metric-label">
        无效(账号失效)
      </div>
      <div class="admin-metric-value">
        <%= @browsers_invalid %>
      </div>
      <div class="admin-metric-trend admin-metric-trend-down">
        不可用
      </div>
    <% end %>
  </div>
</div>

<div class="admin-grid-full">
  <div class="admin-card">
    <div class="admin-card-header">
      <div>
        <div class="admin-card-title">
          低库存资源预警
        </div>
        <div class="admin-card-subtitle">
          仅展示可用天数不足 10 天（含无库存/无法估算）的工作模式 × 主题 × 平台组合，按紧急程度排序
        </div>
      </div>
      <div class="admin-card-header-right">
        <% total_alerts = @low_stock_alerts.sum { |g| g[:themes].sum { |t| t[:platforms].size } } %>
        <span class="admin-tag admin-tag-danger">
          <%= total_alerts %> 项预警
        </span>
      </div>
    </div>

    <div class="admin-table-wrapper">
      <table class="admin-table">
        <thead>
          <tr>
            <th>工作模式</th>
            <th>主题</th>
            <th>平台</th>
            <th style="text-align: center;">正常账号</th>
            <th style="text-align: center;">剩余资源</th>
            <th style="text-align: center;">可用天数</th>
          </tr>
        </thead>
        <tbody>
          <% has_alerts = @low_stock_alerts.any? { |g| g[:themes].any? } %>
          <% if has_alerts %>
            <% @low_stock_alerts.each do |group| %>
              <% next if group[:themes].empty? %>
              <% total_rows = group[:themes].sum { |t| t[:platforms].size } %>
              <% group[:themes].each_with_index do |theme_group, theme_idx| %>
                <% theme_rowspan = theme_group[:platforms].size %>
                <% theme_group[:platforms].each_with_index do |row, platform_idx| %>
                  <tr>
                    <% if theme_idx == 0 && platform_idx == 0 %>
                      <td rowspan="<%= total_rows %>" style="vertical-align: top; font-weight: 600;">
                        <%= group[:work_type] %>
                      </td>
                    <% end %>
                    <% if platform_idx == 0 %>
                      <td rowspan="<%= theme_rowspan %>" style="vertical-align: top;">
                        <span class="admin-label-muted"><%= theme_group[:theme] || '-' %></span>
                      </td>
                    <% end %>
                    <td>
                      <span class="admin-label-muted"><%= row[:platform]&.capitalize || '-' %></span>
                    </td>
                    <td style="text-align: center; font-weight: 600;">
                      <% if row[:active_accounts] == 0 %>
                        <span style="color: var(--danger);" title="该主题×平台组合下无正常账号，无法消耗资源">
                          0
                        </span>
                      <% else %>
                        <span style="color: var(--success);"><%= row[:active_accounts] %></span>
                      <% end %>
                    </td>
                    <td style="text-align: center; font-weight: 600;">
                      <%= row[:pending] %>
                    </td>
                    <td style="text-align: center; font-weight: 600;">
                      <% if row[:pending] == 0 %>
                        <span style="color: var(--danger);" title="该主题×平台组合无待分配资源，需立即补充">
                          无库存
                        </span>
                      <% elsif row[:available_days] <= 3 %>
                        <span style="color: var(--danger);" title="剩余可用不足3天，建议尽快补充资源">
                          <%= row[:available_days] %> 天
                        </span>
                      <% else %>
                        <span style="color: var(--warning);" title="剩余可用不足10天">
                          <%= row[:available_days] %> 天
                        </span>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              <% end %>
            <% end %>
          <% else %>
            <tr>
              <td colspan="6" style="padding: 24px; text-align: center;" class="admin-label-muted">
                <div style="font-size: 32px; margin-bottom: 8px;">✓</div>
                所有工作模式资源充足，暂无低库存预警
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<div class="admin-grid-full">
  <div class="admin-card">
    <div class="admin-card-header">
      <div>
        <div class="admin-card-title">
          近1周报错次数排行榜
        </div>
        <div class="admin-card-subtitle">
          正常状态账号的错误统计排行（按报错次数降序）
        </div>
      </div>
      <div class="admin-card-header-right">
        <span class="admin-tag admin-tag-danger">
          Top <%= @abnormal_accounts.size %>
        </span>
      </div>
    </div>

    <div class="admin-table-wrapper">
      <table class="admin-table">
        <thead>
          <tr>
            <th>排名</th>
            <th>账号名</th>
            <th>平台</th>
            <th>工作模式</th>
            <th>近1周报错次数</th>
            <th>最近报错时间</th>
            <th>最近报错信息</th>
            <th>操作</th>
          </tr>
        </thead>
        <tbody>
          <% if @abnormal_accounts.any? %>
            <% @abnormal_accounts.each_with_index do |item, index| %>
              <tr>
                <td>
                  <span class="admin-pill-status" style="<%= index < 3 ? 'background: rgba(234, 179, 8, 0.1); color: #eab308; font-weight: 700;' : 'background: rgba(156, 163, 175, 0.1); color: #6b7280;' %>">
                    <%= index + 1 %>
                  </span>
                </td>
                <td>
                  <%= link_to item[:account].account_name, admin_account_path(item[:account]), class: "admin-link-quiet", style: "color: var(--accent);" %>
                </td>
                <td>
                  <span class="admin-label-muted"><%= item[:account].platform.to_s.titleize %></span>
                </td>
                <td>
                  <span class="admin-label-muted"><%= item[:account].work_type.to_s.titleize %></span>
                </td>
                <td>
                  <span class="admin-pill-status" style="background: rgba(239, 68, 68, 0.1); color: #ef4444; font-weight: 600;">
                    <%= item[:error_count] %> 次
                  </span>
                </td>
                <td>
                  <span class="admin-label-muted"><%= item[:last_failure_time]&.strftime("%m-%d %H:%M") || '-' %></span>
                </td>
                <td>
                  <span class="admin-label-muted" style="max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="<%= item[:last_error] %>">
                    <%= item[:last_error] || '-' %>
                  </span>
                </td>
                <td>
                  <div style="display: flex; gap: 8px;">
                    <%= link_to "详情", admin_account_path(item[:account]), class: "admin-link-quiet", style: "color: var(--accent);" %>
                    <%= link_to "日志", admin_task_logs_path(q: { account_id_eq: item[:account].id, status_eq: 1 }), class: "admin-link-quiet", style: "color: var(--danger);" %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="8" style="padding: 24px; text-align: center;" class="admin-label-muted">
                <div style="font-size: 32px; margin-bottom: 8px;">✓</div>
                近1周暂无报错的账号，系统运行正常
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>


<div id="platform-modal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.7); z-index: 1000; justify-content: center; align-items: center;">
  <div style="background: #1e293b; border-radius: 12px; width: 560px; max-width: 92%; max-height: 82%; overflow: auto; padding: 20px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
      <div id="platform-modal-title" style="font-size: 15px; font-weight: 500;"></div>
      <button type="button" onclick="closePlatformModal()" style="background: transparent; border: none; color: var(--text-muted); font-size: 22px; cursor: pointer; line-height: 1;">×</button>
    </div>
    <table class="admin-table">
      <thead>
        <tr>
          <th>平台</th>
          <th style="text-align: center;">正常</th>
          <th style="text-align: center;">未登录</th>
          <th style="text-align: center;">封禁</th>
          <th style="text-align: center;">总计</th>
        </tr>
      </thead>
      <tbody id="platform-modal-body"></tbody>
    </table>
  </div>
</div>

<script>
  window.__accountPlatforms = <%= raw @account_matrix.map { |r| { name: r[:mode].name, icon: r[:mode].icon, platforms: r[:platforms] } }.to_json %>;

  function openPlatformModal(idx) {
    var data = window.__accountPlatforms[idx];
    if (!data) return;
    document.getElementById('platform-modal-title').textContent = data.icon + ' ' + data.name + ' · 平台分布';
    var rows = data.platforms.map(function (p) {
      var label = p.platform.charAt(0).toUpperCase() + p.platform.slice(1);
      return '<tr>' +
        '<td>' + label + '</td>' +
        '<td style="text-align: center; color: var(--success); font-weight: 600;">' + p.active + '</td>' +
        '<td style="text-align: center; color: var(--warning); font-weight: 600;">' + p.unlogged + '</td>' +
        '<td style="text-align: center; color: var(--danger); font-weight: 600;">' + p.banned + '</td>' +
        '<td style="text-align: center; font-weight: 600;">' + p.total + '</td>' +
        '</tr>';
    }).join('');
    document.getElementById('platform-modal-body').innerHTML = rows;
    document.getElementById('platform-modal').style.display = 'flex';
  }

  function closePlatformModal() {
    document.getElementById('platform-modal').style.display = 'none';
  }

  document.addEventListener('DOMContentLoaded', function () {
    var modal = document.getElementById('platform-modal');
    if (modal) {
      modal.addEventListener('click', function (e) {
        if (e.target === modal) closePlatformModal();
      });
    }
  });
</script>
