<% content_for :page_title do %>
  数据预警
<% end %>
<% content_for :page_subtitle do %>
  账号数据异常集中监控：零浏览、封禁、浏览量骤降、连续发布失败
<% end %>

<div class="data-alerts-page" data-controller="alert-tabs">
  <%# ===== 预警总览（指标卡 = Tab 切换按钮） ===== %>
  <div class="admin-grid-full">
    <div class="admin-card">
      <div class="admin-card-header">
        <div>
          <div class="admin-card-title">
            预警总览
          </div>
          <div class="admin-card-subtitle">
            点击指标卡切换下方预警列表；点击账号名或操作链接可查看详情（不跳转页面）
          </div>
        </div>
      </div>

      <div class="admin-metric-row">
        <button type="button"
                class="admin-metric alert-tab"
                data-alert-tabs-target="tab"
                data-alert-tabs-name="zero-views"
                data-alert-tabs-has-alert="<%= @zero_views_accounts.any? %>"
                data-action="alert-tabs#select"
                data-alert-tabs-name-param="zero-views">
          <div class="admin-metric-label">
            连续3次0浏览
          </div>
          <div class="admin-metric-value" style="color: <%= @zero_views_accounts.any? ? 'var(--danger)' : 'var(--success)' %>;">
            <%= @zero_views_accounts.size %>
          </div>
          <div class="admin-metric-trend <%= @zero_views_accounts.any? ? 'admin-metric-trend-down' : 'admin-metric-trend-up' %>">
            <%= @zero_views_accounts.any? ? "需关注" : "正常" %>
          </div>
        </button>
        <button type="button"
                class="admin-metric alert-tab"
                data-alert-tabs-target="tab"
                data-alert-tabs-name="banned"
                data-alert-tabs-has-alert="<%= @recent_banned_accounts.any? %>"
                data-action="alert-tabs#select"
                data-alert-tabs-name-param="banned">
          <div class="admin-metric-label">
            最近封禁
          </div>
          <div class="admin-metric-value" style="color: <%= @recent_banned_accounts.any? ? 'var(--danger)' : 'var(--success)' %>;">
            <%= @recent_banned_accounts.size %>
          </div>
          <div class="admin-metric-trend <%= @recent_banned_accounts.any? ? 'admin-metric-trend-down' : 'admin-metric-trend-up' %>">
            <%= @recent_banned_accounts.any? ? "不可用" : "正常" %>
          </div>
        </button>
        <button type="button"
                class="admin-metric alert-tab"
                data-alert-tabs-target="tab"
                data-alert-tabs-name="views-drop"
                data-alert-tabs-has-alert="<%= @views_drop_accounts.any? %>"
                data-action="alert-tabs#select"
                data-alert-tabs-name-param="views-drop">
          <div class="admin-metric-label">
            浏览量骤降
          </div>
          <div class="admin-metric-value" style="color: <%= @views_drop_accounts.any? ? 'var(--warning)' : 'var(--success)' %>;">
            <%= @views_drop_accounts.size %>
          </div>
          <div class="admin-metric-trend <%= @views_drop_accounts.any? ? 'admin-metric-trend-down' : 'admin-metric-trend-up' %>">
            <%= @views_drop_accounts.any? ? "需关注" : "正常" %>
          </div>
        </button>
        <button type="button"
                class="admin-metric alert-tab"
                data-alert-tabs-target="tab"
                data-alert-tabs-name="fail-streak"
                data-alert-tabs-has-alert="<%= @fail_streak_accounts.any? %>"
                data-action="alert-tabs#select"
                data-alert-tabs-name-param="fail-streak">
          <div class="admin-metric-label">
            连续发布失败
          </div>
          <div class="admin-metric-value" style="color: <%= @fail_streak_accounts.any? ? 'var(--danger)' : 'var(--success)' %>;">
            <%= @fail_streak_accounts.size %>
          </div>
          <div class="admin-metric-trend <%= @fail_streak_accounts.any? ? 'admin-metric-trend-down' : 'admin-metric-trend-up' %>">
            <%= @fail_streak_accounts.any? ? "需排查" : "正常" %>
          </div>
        </button>
      </div>
    </div>
  </div>

  <%# ===== Tab 1: 连续3次0浏览 ===== %>
  <div class="admin-grid-full" data-alert-tabs-target="panel" data-alert-tabs-name="zero-views">
    <div class="admin-card">
      <div class="admin-card-header">
        <div>
          <div class="admin-card-title">
            连续3次浏览量为0的账号
          </div>
          <div class="admin-card-subtitle">
            运营中账号最近连续 <%= Admin::DataAlertsController::ZERO_VIEWS_STREAK %> 条发文浏览量均为0（疑似限流/降权），按连续条数降序
          </div>
        </div>
        <div class="admin-card-header-right">
          <span class="admin-tag admin-tag-accent">
            <%= @zero_views_accounts.size %> 个账号
          </span>
        </div>
      </div>

      <div data-controller="table-pagination" data-table-pagination-size-value="10">
        <div class="admin-table-wrapper alert-table-scroll">
          <table class="admin-table">
            <thead>
              <tr>
                <th>账号名</th>
                <th>平台</th>
                <th>主题</th>
                <th>工作模式</th>
                <th>状态</th>
                <th>运营人员</th>
                <th>连续0浏览</th>
                <th>最近发文日期</th>
                <th>操作</th>
              </tr>
            </thead>
            <tbody data-table-pagination-target="body">
              <% if @zero_views_accounts.any? %>
              <% @zero_views_accounts.each do |item| %>
                <tr>
                  <td>
                    <span class="admin-link-quiet alert-ellipsis" style="color: var(--accent); cursor: pointer;" title="<%= item[:account].account_name %>" data-drawer-trigger data-drawer-id-param="<%= item[:account].id %>" data-drawer-tab-param="overview">
                      <%= item[:account].account_name %>
                    </span>
                  </td>
                  <td>
                    <span class="admin-label-muted"><%= item[:account].platform.to_s.titleize %></span>
                  </td>
                  <td>
                    <span class="admin-label-muted"><%= item[:account].theme || '-' %></span>
                  </td>
                  <td>
                    <span class="admin-label-muted"><%= item[:account].work_type.to_s.titleize %></span>
                  </td>
                  <td>
                    <span class="admin-pill-status" style="background: rgba(34, 197, 94, 0.12); color: #4ade80; font-weight: 500;">
                      <span class="admin-pill-status-dot" style="background: var(--success);"></span>
                      <%= item[:account].status %>
                    </span>
                  </td>
                  <td>
                    <span class="admin-label-muted"><%= item[:account].operator || '-' %></span>
                  </td>
                  <td>
                    <span class="admin-pill-status" style="background: rgba(239, 68, 68, 0.1); color: #ef4444; font-weight: 600;">
                      <%= item[:streak] %> 条
                    </span>
                  </td>
                  <td class="alert-nowrap">
                    <span class="admin-label-muted"><%= item[:recent_posts].map { |p| p.post_date.strftime("%m-%d") }.join(" / ") %></span>
                  </td>
                  <td class="alert-nowrap">
                    <div style="display: flex; gap: 10px;">
                      <span class="admin-link-quiet" style="color: var(--accent); cursor: pointer;" data-drawer-trigger data-drawer-id-param="<%= item[:account].id %>" data-drawer-tab-param="overview">详情</span>
                      <span class="admin-link-quiet" style="color: var(--accent); cursor: pointer;" data-drawer-trigger data-drawer-id-param="<%= item[:account].id %>" data-drawer-tab-param="posts">发文数据</span>
                    </div>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="9" style="padding: 24px; text-align: center;" class="admin-label-muted">
                  <div style="font-size: 32px; margin-bottom: 8px;">✓</div>
                  暂无连续0浏览的账号
                </td>
              </tr>
            <% end %>
            </tbody>
          </table>
        </div>
        <div class="pg-bar">
          <div class="pg-info" data-table-pagination-target="info"></div>
          <div class="pg-actions">
            <button type="button" class="pg-btn" data-table-pagination-target="prevBtn" data-action="table-pagination#prev">上一页</button>
            <button type="button" class="pg-btn" data-table-pagination-target="nextBtn" data-action="table-pagination#next">下一页</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%# ===== Tab 2: 最近封禁 ===== %>
  <div class="admin-grid-full" data-alert-tabs-target="panel" data-alert-tabs-name="banned">
    <div class="admin-card">
      <div class="admin-card-header">
        <div>
          <div class="admin-card-title">
            最近被封禁账号
          </div>
          <div class="admin-card-subtitle">
            状态为「封禁/停用」的账号，按状态更新时间倒序（最多 <%= Admin::DataAlertsController::BANNED_LIST_LIMIT %> 条）
          </div>
        </div>
        <div class="admin-card-header-right">
          <span class="admin-tag admin-tag-accent">
            <%= @recent_banned_accounts.size %> 个账号
          </span>
        </div>
      </div>

      <div data-controller="table-pagination" data-table-pagination-size-value="10">
        <div class="admin-table-wrapper alert-table-scroll">
          <table class="admin-table">
            <thead>
              <tr>
                <th>账号名</th>
                <th>平台</th>
                <th>主题</th>
                <th>工作模式</th>
                <th>状态</th>
                <th>运营人员</th>
                <th>封禁时间</th>
                <th>备注</th>
                <th>操作</th>
              </tr>
            </thead>
            <tbody data-table-pagination-target="body">
              <% if @recent_banned_accounts.any? %>
              <% @recent_banned_accounts.each do |account| %>
                <tr>
                  <td>
                    <span class="admin-link-quiet alert-ellipsis" style="color: var(--accent); cursor: pointer;" title="<%= account.account_name %>" data-drawer-trigger data-drawer-id-param="<%= account.id %>" data-drawer-tab-param="overview">
                      <%= account.account_name %>
                    </span>
                  </td>
                  <td>
                    <span class="admin-label-muted"><%= account.platform.to_s.titleize %></span>
                  </td>
                  <td>
                    <span class="admin-label-muted"><%= account.theme || '-' %></span>
                  </td>
                  <td>
                    <span class="admin-label-muted"><%= account.work_type.to_s.titleize %></span>
                  </td>
                  <td>
                    <span class="admin-pill-status" style="background: rgba(239, 68, 68, 0.12); color: #ef4444; font-weight: 500;">
                      <span class="admin-pill-status-dot" style="background: var(--danger);"></span>
                      <%= account.status %>
                    </span>
                  </td>
                  <td>
                    <span class="admin-label-muted"><%= account.operator || '-' %></span>
                  </td>
                  <td class="alert-nowrap">
                    <span class="admin-label-muted" style="color: var(--danger);"><%= account.updated_at.strftime("%Y-%m-%d %H:%M") %></span>
                  </td>
                  <td>
                    <span class="admin-label-muted" style="max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="<%= account.remark %>">
                      <%= account.remark || '-' %>
                    </span>
                  </td>
                  <td class="alert-nowrap">
                    <span class="admin-link-quiet" style="color: var(--accent); cursor: pointer;" data-drawer-trigger data-drawer-id-param="<%= account.id %>" data-drawer-tab-param="overview">详情</span>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="9" style="padding: 24px; text-align: center;" class="admin-label-muted">
                  <div style="font-size: 32px; margin-bottom: 8px;">✓</div>
                  暂无被封禁的账号
                </td>
              </tr>
            <% end %>
            </tbody>
          </table>
        </div>
        <div class="pg-bar">
          <div class="pg-info" data-table-pagination-target="info"></div>
          <div class="pg-actions">
            <button type="button" class="pg-btn" data-table-pagination-target="prevBtn" data-action="table-pagination#prev">上一页</button>
            <button type="button" class="pg-btn" data-table-pagination-target="nextBtn" data-action="table-pagination#next">下一页</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%# ===== Tab 3: 浏览量骤降 ===== %>
  <div class="admin-grid-full" data-alert-tabs-target="panel" data-alert-tabs-name="views-drop">
    <div class="admin-card">
      <div class="admin-card-header">
        <div>
          <div class="admin-card-title">
            发文浏览量骤降的账号
          </div>
          <div class="admin-card-subtitle">
            近7天单篇平均浏览量 较 前7天 降幅 ≥ 50%，且前7天均值 ≥ <%= Admin::DataAlertsController::VIEWS_DROP_BASELINE %>，按降幅降序
          </div>
        </div>
        <div class="admin-card-header-right">
          <span class="admin-tag admin-tag-accent">
            <%= @views_drop_accounts.size %> 个账号
          </span>
        </div>
      </div>

      <div data-controller="table-pagination" data-table-pagination-size-value="10">
        <div class="admin-table-wrapper alert-table-scroll">
          <table class="admin-table">
            <thead>
              <tr>
                <th>账号名</th>
                <th>平台</th>
                <th>主题</th>
                <th>工作模式</th>
                <th>状态</th>
                <th>运营人员</th>
                <th>前7天均浏览</th>
                <th>近7天均浏览</th>
                <th>降幅</th>
                <th>操作</th>
              </tr>
            </thead>
            <tbody data-table-pagination-target="body">
              <% if @views_drop_accounts.any? %>
              <% @views_drop_accounts.each do |item| %>
                <tr>
                  <td>
                    <span class="admin-link-quiet alert-ellipsis" style="color: var(--accent); cursor: pointer;" title="<%= item[:account].account_name %>" data-drawer-trigger data-drawer-id-param="<%= item[:account].id %>" data-drawer-tab-param="posts">
                      <%= item[:account].account_name %>
                    </span>
                  </td>
                  <td>
                    <span class="admin-label-muted"><%= item[:account].platform.to_s.titleize %></span>
                  </td>
                  <td>
                    <span class="admin-label-muted"><%= item[:account].theme || '-' %></span>
                  </td>
                  <td>
                    <span class="admin-label-muted"><%= item[:account].work_type.to_s.titleize %></span>
                  </td>
                  <td>
                    <span class="admin-pill-status" style="background: rgba(34, 197, 94, 0.12); color: #4ade80; font-weight: 500;">
                      <span class="admin-pill-status-dot" style="background: var(--success);"></span>
                      <%= item[:account].status %>
                    </span>
                  </td>
                  <td>
                    <span class="admin-label-muted"><%= item[:account].operator || '-' %></span>
                  </td>
                  <td>
                    <span class="admin-label-muted" style="font-weight: 600;"><%= item[:prev_avg] %></span>
                  </td>
                  <td>
                    <span class="admin-label-muted" style="font-weight: 600;"><%= item[:recent_avg] %></span>
                  </td>
                  <td>
                    <span class="admin-pill-status" style="background: rgba(234, 179, 8, 0.1); color: #eab308; font-weight: 600;">
                      -<%= item[:drop_percent] %>%
                    </span>
                  </td>
                  <td class="alert-nowrap">
                    <div style="display: flex; gap: 10px;">
                      <span class="admin-link-quiet" style="color: var(--accent); cursor: pointer;" data-drawer-trigger data-drawer-id-param="<%= item[:account].id %>" data-drawer-tab-param="overview">详情</span>
                      <span class="admin-link-quiet" style="color: var(--accent); cursor: pointer;" data-drawer-trigger data-drawer-id-param="<%= item[:account].id %>" data-drawer-tab-param="posts">发文数据</span>
                    </div>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="10" style="padding: 24px; text-align: center;" class="admin-label-muted">
                  <div style="font-size: 32px; margin-bottom: 8px;">✓</div>
                  暂无浏览量骤降的账号
                </td>
              </tr>
            <% end %>
            </tbody>
          </table>
        </div>
        <div class="pg-bar">
          <div class="pg-info" data-table-pagination-target="info"></div>
          <div class="pg-actions">
            <button type="button" class="pg-btn" data-table-pagination-target="prevBtn" data-action="table-pagination#prev">上一页</button>
            <button type="button" class="pg-btn" data-table-pagination-target="nextBtn" data-action="table-pagination#next">下一页</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%# ===== Tab 4: 连续发布失败 ===== %>
  <div class="admin-grid-full" data-alert-tabs-target="panel" data-alert-tabs-name="fail-streak">
    <div class="admin-card">
      <div class="admin-card-header">
        <div>
          <div class="admin-card-title">
            连续发布失败的账号
          </div>
          <div class="admin-card-subtitle">
            近 <%= Admin::DataAlertsController::FAIL_LOOKBACK_DAYS %> 天内最近连续 <%= Admin::DataAlertsController::FAIL_STREAK %> 次及以上任务执行失败的运营中账号，按连续失败次数降序
          </div>
        </div>
        <div class="admin-card-header-right">
          <span class="admin-tag admin-tag-accent">
            <%= @fail_streak_accounts.size %> 个账号
          </span>
        </div>
      </div>

      <div data-controller="table-pagination" data-table-pagination-size-value="10">
        <div class="admin-table-wrapper alert-table-scroll">
          <table class="admin-table">
            <thead>
              <tr>
                <th>账号名</th>
                <th>平台</th>
                <th>工作模式</th>
                <th>状态</th>
                <th>运营人员</th>
                <th>连续失败</th>
                <th>最近失败时间</th>
                <th>最近错误信息</th>
                <th>操作</th>
              </tr>
            </thead>
            <tbody data-table-pagination-target="body">
              <% if @fail_streak_accounts.any? %>
              <% @fail_streak_accounts.each do |item| %>
                <tr>
                  <td>
                    <span class="admin-link-quiet alert-ellipsis" style="color: var(--accent); cursor: pointer;" title="<%= item[:account].account_name %>" data-drawer-trigger data-drawer-id-param="<%= item[:account].id %>" data-drawer-tab-param="logs">
                      <%= item[:account].account_name %>
                    </span>
                  </td>
                  <td>
                    <span class="admin-label-muted"><%= item[:account].platform.to_s.titleize %></span>
                  </td>
                  <td>
                    <span class="admin-label-muted"><%= item[:account].work_type.to_s.titleize %></span>
                  </td>
                  <td>
                    <span class="admin-pill-status" style="background: rgba(34, 197, 94, 0.12); color: #4ade80; font-weight: 500;">
                      <span class="admin-pill-status-dot" style="background: var(--success);"></span>
                      <%= item[:account].status %>
                    </span>
                  </td>
                  <td>
                    <span class="admin-label-muted"><%= item[:account].operator || '-' %></span>
                  </td>
                  <td>
                    <span class="admin-pill-status" style="background: rgba(239, 68, 68, 0.1); color: #ef4444; font-weight: 600;">
                      <%= item[:streak] %> 次
                    </span>
                  </td>
                  <td class="alert-nowrap">
                    <span class="admin-label-muted"><%= item[:last_failed_at]&.strftime("%m-%d %H:%M") || '-' %></span>
                  </td>
                  <td>
                    <span class="admin-label-muted" style="max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="<%= item[:last_error] %>">
                      <%= item[:last_error] || '-' %>
                    </span>
                  </td>
                  <td class="alert-nowrap">
                    <div style="display: flex; gap: 10px;">
                      <span class="admin-link-quiet" style="color: var(--accent); cursor: pointer;" data-drawer-trigger data-drawer-id-param="<%= item[:account].id %>" data-drawer-tab-param="overview">详情</span>
                      <span class="admin-link-quiet" style="color: var(--danger); cursor: pointer;" data-drawer-trigger data-drawer-id-param="<%= item[:account].id %>" data-drawer-tab-param="logs">日志</span>
                    </div>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="9" style="padding: 24px; text-align: center;" class="admin-label-muted">
                  <div style="font-size: 32px; margin-bottom: 8px;">✓</div>
                  暂无连续发布失败的账号
                </td>
              </tr>
            <% end %>
            </tbody>
          </table>
        </div>
        <div class="pg-bar">
          <div class="pg-info" data-table-pagination-target="info"></div>
          <div class="pg-actions">
            <button type="button" class="pg-btn" data-table-pagination-target="prevBtn" data-action="table-pagination#prev">上一页</button>
            <button type="button" class="pg-btn" data-table-pagination-target="nextBtn" data-action="table-pagination#next">下一页</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%# ===== 右侧抽屉 ===== %>
  <div class="drawer-backdrop" data-drawer-role="backdrop"></div>
  <div class="drawer-panel" data-drawer-role="panel">
    <div class="drawer-header">
      <div class="drawer-title">账号详情</div>
      <button type="button" class="drawer-close" data-drawer-role="close" title="关闭 (ESC)">✕</button>
    </div>
    <div class="drawer-tabs">
      <button type="button"
              class="drawer-tab"
              data-drawer-role="tab"
              data-drawer-tab-name="overview">概览</button>
      <button type="button"
              class="drawer-tab"
              data-drawer-role="tab"
              data-drawer-tab-name="posts">发文数据</button>
      <button type="button"
              class="drawer-tab"
              data-drawer-role="tab"
              data-drawer-tab-name="logs">任务日志</button>
    </div>
    <div class="drawer-body" data-drawer-role="content">
      <div style="padding: 40px 20px; text-align: center; color: var(--text-muted); font-size: 12px;">
        点击列表中的账号名或操作链接查看详情
      </div>
    </div>
  </div>
</div>

<script>
(function() {
  var DRAWER_URL = '<%= account_admin_data_alerts_path %>';
  var currentTab = 'overview';

  function $(sel) { return document.querySelector(sel); }
  function $$(sel) { return Array.from(document.querySelectorAll(sel)); }

  function openDrawer(accountId, tab) {
    currentTab = tab || 'overview';
    var panel = $('[data-drawer-role="panel"]');
    var backdrop = $('[data-drawer-role="backdrop"]');
    var content = $('[data-drawer-role="content"]');

    // 激活对应 Tab 按钮
    $$('[data-drawer-role="tab"]').forEach(function(btn) {
      btn.classList.toggle('drawer-tab-active', btn.dataset.drawerTabName === currentTab);
    });

    // 显示抽屉
    panel.classList.add('drawer-open');
    backdrop.classList.add('drawer-backdrop-visible');
    document.body.style.overflow = 'hidden';

    // 加载内容
    content.innerHTML = '<div style="padding: 60px 20px; text-align: center; color: var(--text-muted); font-size: 13px;">加载中...</div>';

    var url = DRAWER_URL + (DRAWER_URL.indexOf('?') >= 0 ? '&' : '?') + 'id=' + encodeURIComponent(accountId);
    fetch(url, {
      headers: { 'Accept': 'text/html' },
      credentials: 'same-origin'
    })
    .then(function(resp) {
      if (!resp.ok) throw new Error('HTTP ' + resp.status);
      return resp.text();
    })
    .then(function(html) {
      content.innerHTML = html;
      activateTab(currentTab);
    })
    .catch(function(e) {
      content.innerHTML = '<div style="padding: 40px 20px; text-align: center; color: var(--danger); font-size: 13px;">加载失败：' + e.message + '</div>';
    });
  }

  function closeDrawer() {
    var panel = $('[data-drawer-role="panel"]');
    var backdrop = $('[data-drawer-role="backdrop"]');
    panel.classList.remove('drawer-open');
    backdrop.classList.remove('drawer-backdrop-visible');
    document.body.style.overflow = '';
  }

  function activateTab(tabName) {
    currentTab = tabName;
    $$('[data-drawer-role="tab"]').forEach(function(btn) {
      btn.classList.toggle('drawer-tab-active', btn.dataset.drawerTabName === tabName);
    });
    $$('[data-drawer-panel]').forEach(function(panel) {
      panel.style.display = panel.dataset.drawerPanel === tabName ? '' : 'none';
    });
  }

  // 事件委托：点击触发元素
  document.addEventListener('click', function(e) {
    var trigger = e.target.closest('[data-drawer-trigger]');
    if (trigger) {
      e.preventDefault();
      var id = trigger.dataset.drawerIdParam;
      var tab = trigger.dataset.drawerTabParam || 'overview';
      openDrawer(id, tab);
      return;
    }

    // 关闭按钮
    if (e.target.closest('[data-drawer-role="close"]')) {
      closeDrawer();
      return;
    }

    // 遮罩点击关闭
    if (e.target.matches('[data-drawer-role="backdrop"]')) {
      closeDrawer();
      return;
    }

    // Tab 切换
    var tabBtn = e.target.closest('[data-drawer-role="tab"]');
    if (tabBtn) {
      activateTab(tabBtn.dataset.drawerTabName);
      return;
    }
  });

  // ESC 关闭
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeDrawer();
  });
})();
</script>
