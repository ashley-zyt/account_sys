<!DOCTYPE html>
<html>
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #0f172a; color: #e2e8f0; padding: 20px; }
    .modal-title { font-size: 18px; font-weight: 600; margin-bottom: 16px; color: #f1f5f9; }
    .account-info { font-size: 13px; color: #94a3b8; margin-bottom: 16px; line-height: 1.6; }
    .form-group { margin-bottom: 16px; }
    .form-label { display: block; font-size: 13px; font-weight: 500; color: #94a3b8; margin-bottom: 6px; }
    .form-input { width: 100%; padding: 10px 12px; font-size: 14px; background: #1e293b; border: 1px solid #334155; border-radius: 6px; color: #e2e8f0; outline: none; }
    .form-hint { font-size: 11px; color: #64748b; margin-top: 4px; }
    .auth-url-box { background: #1e293b; border: 1px solid #334155; border-radius: 6px; padding: 10px 12px; margin-bottom: 12px; }
    .auth-url-label { font-size: 12px; color: #94a3b8; margin-bottom: 6px; }
    .auth-url-row { display: flex; align-items: center; gap: 8px; }
    .auth-url-text { flex: 1; min-width: 0; font-size: 12px; color: #e2e8f0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .btn-copy { flex-shrink: 0; padding: 4px 10px; font-size: 12px; color: #3b82f6; background: #1e293b; border: 1px solid #334155; border-radius: 6px; cursor: pointer; text-decoration: none; }
    .btn-copy:hover { background: #334155; }
    .btn { display: inline-block; padding: 8px 16px; font-size: 13px; font-weight: 500; border: none; border-radius: 6px; cursor: pointer; text-decoration: none; }
    .btn-primary { background: #3b82f6; color: white; }
    .btn-secondary { background: #334155; color: #e2e8f0; }
    .btn-success { background: #16a34a; color: white; }
    .auth-actions { display: flex; gap: 10px; margin-top: 8px; }
    .notice { color: #4ade80; font-size: 13px; margin-bottom: 12px; }
    .alert { color: #f87171; font-size: 13px; margin-bottom: 12px; }
  </style>
</head>
<body>
  <div class="modal-title">渠道 + 授权</div>

  <div class="account-info">
    客户：<%= @hosting_account.client&.name || '-' %><br>
    平台：<%= @hosting_account.platform %> ｜ 主题：<%= @hosting_account.theme || '-' %> ｜ 资源队列：<%= WorkMode.find(@hosting_account.resource_queue)&.name || @hosting_account.resource_queue || '-' %>
  </div>

  <% if flash[:notice].present? %>
    <div class="notice"><%= flash[:notice] %></div>
  <% end %>
  <% if flash[:alert].present? %>
    <div class="alert"><%= flash[:alert] %></div>
  <% end %>

  <% if flash[:hosting_auth_url].present? %>
    <div class="auth-url-box">
      <div class="auth-url-label">postpeer 授权链接</div>
      <div class="auth-url-row">
        <span class="auth-url-text"><%= flash[:hosting_auth_url] %></span>
        <button type="button" class="btn-copy" onclick="copyAuthUrl(this)" data-url="<%= flash[:hosting_auth_url] %>">复制</button>
        <a href="<%= flash[:hosting_auth_url] %>" target="_blank" rel="noopener" class="btn-copy">打开</a>
      </div>
    </div>
  <% end %>
  <% if flash[:hosting_postforme_auth_url].present? %>
    <div class="auth-url-box">
      <div class="auth-url-label">postforme 授权链接</div>
      <div class="auth-url-row">
        <span class="auth-url-text"><%= flash[:hosting_postforme_auth_url] %></span>
        <button type="button" class="btn-copy" onclick="copyAuthUrl(this)" data-url="<%= flash[:hosting_postforme_auth_url] %>">复制</button>
        <a href="<%= flash[:hosting_postforme_auth_url] %>" target="_blank" rel="noopener" class="btn-copy">打开</a>
      </div>
    </div>
  <% end %>
  <% if flash[:hosting_x_auth_url].present? %>
    <div class="auth-url-box">
      <div class="auth-url-label">X 授权链接</div>
      <div class="auth-url-row">
        <span class="auth-url-text"><%= flash[:hosting_x_auth_url] %></span>
        <button type="button" class="btn-copy" onclick="copyAuthUrl(this)" data-url="<%= flash[:hosting_x_auth_url] %>">复制</button>
        <a href="<%= flash[:hosting_x_auth_url] %>" target="_blank" rel="noopener" class="btn-copy">打开</a>
      </div>
    </div>
  <% end %>

  <div class="form-group">
    <label class="form-label">授权（渠道：<%= @hosting_account.publish_channel %>）</label>
    <div class="auth-actions">
      <% case @hosting_account.publish_channel %>
      <% when 'postpeer' %>
        <%= link_to "发起授权", start_postpeer_auth_admin_hosting_account_path(@hosting_account), data: { turbo_method: :post }, class: "btn btn-primary" %>
        <button type="button" class="btn btn-success" onclick="confirmAuth('<%= confirm_postpeer_auth_admin_hosting_account_path(@hosting_account) %>')">确认授权</button>
      <% when 'postforme' %>
        <%= link_to "发起授权", start_postforme_auth_admin_hosting_account_path(@hosting_account), data: { turbo_method: :post }, class: "btn btn-primary" %>
        <button type="button" class="btn btn-success" onclick="confirmAuth('<%= confirm_postforme_auth_admin_hosting_account_path(@hosting_account) %>')">确认授权</button>
      <% when 'x_api' %>
        <%= link_to "发起授权", start_x_auth_admin_hosting_account_path(@hosting_account), data: { turbo_method: :post }, class: "btn btn-primary" %>
        <div style="display: flex; gap: 8px; margin-top: 8px; width: 100%;">
          <input type="text" id="x-auth-code" placeholder="粘贴授权码或整段回调 URL" style="flex: 1; min-width: 0; padding: 8px 12px; font-size: 13px; background: #1e293b; border: 1px solid #334155; border-radius: 6px; color: #e2e8f0; outline: none;" />
          <button type="button" class="btn btn-success" onclick="completeXAuth()">完成认证</button>
        </div>
      <% else %>
        <span style="font-size: 13px; color: #64748b;">未配置发布渠道</span>
      <% end %>
    </div>
  </div>

  <script>
    function copyAuthUrl(btn) {
      var url = btn.getAttribute('data-url');
      if (!url) return;
      function done() {
        btn.textContent = '已复制';
        setTimeout(function() { btn.textContent = '复制'; }, 1500);
      }
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(url).then(done).catch(function() { fallbackCopy(url, done); });
      } else {
        fallbackCopy(url, done);
      }
    }

    function fallbackCopy(text, done) {
      var ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      try { document.execCommand('copy'); } catch (e) {}
      document.body.removeChild(ta);
      done();
    }

    function confirmAuth(url) {
      var csrf = document.querySelector('meta[name="csrf-token"]').content;
      fetch(url, {
        method: 'POST',
        headers: { 'X-CSRF-Token': csrf, 'Accept': 'application/json' }
      })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        if (data.success) {
          if (window.parent && window.parent.closeChannelModal) { window.parent.closeChannelModal(true); }
        } else {
          alert(data.message || '确认授权失败');
        }
      })
      .catch(function() { alert('确认授权失败，请重试'); });
    }

    function completeXAuth() {
      var code = document.getElementById('x-auth-code').value.trim();
      if (!code) { alert('请先粘贴授权码或整段回调 URL'); return; }
      var csrf = document.querySelector('meta[name="csrf-token"]').content;
      fetch('<%= complete_x_auth_admin_hosting_account_path(@hosting_account) %>', {
        method: 'POST',
        headers: { 'X-CSRF-Token': csrf, 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ code: code })
      })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        if (data.success) {
          if (window.parent && window.parent.closeChannelModal) { window.parent.closeChannelModal(true); }
        } else {
          alert(data.message || '认证失败');
        }
      })
      .catch(function() { alert('认证失败，请重试'); });
    }
  </script>
</body>
</html>
