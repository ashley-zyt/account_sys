<!DOCTYPE html>
<html>
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
  <%= render "admin/shared/select_widgets" %>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #0f172a; color: #e2e8f0; padding: 20px; }
    .modal-title { font-size: 18px; font-weight: 600; margin-bottom: 20px; color: #f1f5f9; }
    .form-group { margin-bottom: 16px; }
    .form-label { display: block; font-size: 13px; font-weight: 500; color: #94a3b8; margin-bottom: 6px; }
    .form-input { width: 100%; padding: 10px 12px; font-size: 14px; background: #1e293b; border: 1px solid #334155; border-radius: 6px; color: #e2e8f0; outline: none; }
    .form-input:focus { border-color: #3b82f6; }
    textarea.form-input { resize: vertical; min-height: 60px; }
    .form-actions { display: flex; gap: 10px; margin-top: 24px; }
    .btn { padding: 10px 20px; font-size: 14px; font-weight: 500; border: none; border-radius: 6px; cursor: pointer; }
    .btn-primary { background: #3b82f6; color: white; }
    .btn-secondary { background: #334155; color: #e2e8f0; }
    .error-message { color: #f87171; font-size: 13px; margin-bottom: 12px; display: none; }
    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0 16px; }
    .form-group-full { grid-column: 1 / -1; }
  </style>
</head>
<body>
  <div class="modal-title">编辑托管账号</div>
  <div id="hosting-error" class="error-message"></div>

  <form id="hosting-form">
    <input type="hidden" name="_method" value="PATCH">
    <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">

    <div class="form-grid">
      <div class="form-group">
        <label class="form-label">客户 <span style="color: #f87171;">*</span></label>
        <%= admin_searchable_select "hosting_account[client_id]", @clients.map { |c| [c.name, c.id] }, selected: @hosting_account.client_id, placeholder: "请选择客户", required: true %>
      </div>
      <div class="form-group">
        <label class="form-label">平台 <span style="color: #f87171;">*</span></label>
        <select name="hosting_account[platform]" id="hosting-platform" class="form-input">
          <option value="twitter" <%= "selected" if @hosting_account.platform == "twitter" %>>twitter</option>
          <option value="youtube" <%= "selected" if @hosting_account.platform == "youtube" %>>youtube</option>
          <option value="tiktok" <%= "selected" if @hosting_account.platform == "tiktok" %>>tiktok</option>
          <option value="instagram" <%= "selected" if @hosting_account.platform == "instagram" %>>instagram</option>
          <option value="facebook" <%= "selected" if @hosting_account.platform == "facebook" %>>facebook</option>
        </select>
      </div>
      <div class="form-group">
        <label class="form-label">主题</label>
        <%= admin_searchable_select "hosting_account[theme]", @themes.map { |t| [t, t] }, selected: @hosting_account.theme, placeholder: "请选择主题" %>
      </div>
      <div class="form-group">
        <label class="form-label">资源队列</label>
        <%= admin_searchable_select "hosting_account[resource_queue]", @resource_queues, selected: @hosting_account.resource_queue, placeholder: "请选择资源队列" %>
      </div>
      <div class="form-group">
        <label class="form-label">用户名</label>
        <input type="text" name="hosting_account[username]" class="form-input" value="<%= @hosting_account.username %>" placeholder="账号用户名" />
      </div>
      <div class="form-group">
        <label class="form-label">主页链接</label>
        <input type="text" name="hosting_account[homepage_url]" class="form-input" value="<%= @hosting_account.homepage_url %>" placeholder="https://..." />
      </div>
      <div class="form-group">
        <label class="form-label">状态</label>
        <select name="hosting_account[status]" class="form-input">
          <option value="active" <%= "selected" if @hosting_account.status == "active" %>>托管中</option>
          <option value="paused" <%= "selected" if @hosting_account.status == "paused" %>>暂停</option>
          <option value="terminated" <%= "selected" if @hosting_account.status == "terminated" %>>终止</option>
        </select>
      </div>
      <div class="form-group form-group-full">
        <label class="form-label">备注</label>
        <textarea name="hosting_account[remark]" class="form-input" rows="2" placeholder="备注信息"><%= @hosting_account.remark %></textarea>
      </div>
    </div>

    <div class="form-actions">
      <button type="button" class="btn btn-secondary" onclick="closeModal()">取消</button>
      <button type="submit" class="btn btn-primary">保存</button>
    </div>
  </form>

  <script>
    document.getElementById('hosting-form').addEventListener('submit', function(e) {
      e.preventDefault();
      var form = this;
      var formData = new FormData(form);
      var csrfToken = document.querySelector('meta[name="csrf-token"]').content;
      var errorDiv = document.getElementById('hosting-error');
      errorDiv.style.display = 'none';
      errorDiv.textContent = '';

      fetch('<%= admin_hosting_account_path(@hosting_account) %>', {
        method: 'POST',
        headers: { 'X-CSRF-Token': csrfToken, 'Accept': 'application/json' },
        body: formData
      })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        if (data.success) {
          if (window.parent && window.parent.closeHostingModal) { window.parent.closeHostingModal(true); }
        } else {
          errorDiv.textContent = data.message || '保存失败';
          errorDiv.style.display = 'block';
        }
      })
      .catch(function() {
        errorDiv.textContent = '保存失败，请重试';
        errorDiv.style.display = 'block';
      });
    });

    function closeModal() {
      if (window.parent && window.parent.closeHostingModal) { window.parent.closeHostingModal(false); }
    }
  </script>
</body>
</html>
