<% content_for :page_title do %>
  托管账号
<% end %>
<% content_for :page_subtitle do %>
  客户托管的账号（独立于自有账号体系）
<% end %>

<% if flash[:hosting_auth_url].present? %>
  <div class="admin-card" style="margin-bottom: 12px;">
    <div class="admin-card-header">
      <div>
        <div class="admin-card-title">postpeer 授权链接</div>
        <div class="admin-card-subtitle">复制链接在浏览器打开完成 OAuth，完成后回本页点「确认授权」</div>
      </div>
    </div>
    <div style="padding: 0 20px 20px;">
      <a href="<%= flash[:hosting_auth_url] %>" target="_blank" rel="noopener"><%= flash[:hosting_auth_url] %></a>
    </div>
  </div>
<% end %>

<% if flash[:hosting_postforme_auth_url].present? %>
  <div class="admin-card" style="margin-bottom: 12px;">
    <div class="admin-card-header">
      <div>
        <div class="admin-card-title">postforme 授权链接</div>
        <div class="admin-card-subtitle">复制链接在浏览器打开完成 OAuth，完成后回本页点「确认授权」</div>
      </div>
    </div>
    <div style="padding: 0 20px 20px;">
      <a href="<%= flash[:hosting_postforme_auth_url] %>" target="_blank" rel="noopener"><%= flash[:hosting_postforme_auth_url] %></a>
    </div>
  </div>
<% end %>

<% if flash[:hosting_x_auth_url].present? %>
  <div class="admin-card" style="margin-bottom: 12px;">
    <div class="admin-card-header">
      <div>
        <div class="admin-card-title">X 授权链接</div>
        <div class="admin-card-subtitle">打开链接完成授权后，浏览器会跳转到 localhost?code=xxx，复制整段地址（或 code）后点「完成认证」</div>
      </div>
    </div>
    <div style="padding: 0 20px 20px;">
      <a href="<%= flash[:hosting_x_auth_url] %>" target="_blank" rel="noopener"><%= flash[:hosting_x_auth_url] %></a>
    </div>
  </div>
<% end %>

<div class="admin-card">
  <div class="admin-card-header">
    <div>
      <div class="admin-card-title">托管账号列表</div>
      <div class="admin-card-subtitle">每个托管账号指定资源队列、主题、平台与发布渠道</div>
    </div>
    <div class="admin-card-header-right">
      <span class="admin-tag">共 <%= @hosting_accounts.total_count %> 条</span>
      <button type="button" class="admin-button-primary" onclick="openNewHostingModal()">添加托管账号</button>
    </div>
  </div>

  <% if @hosting_accounts.any? %>
    <div class="admin-table-wrapper admin-table-scroll">
      <table class="admin-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>客户</th>
            <th>平台</th>
            <th>主题</th>
            <th>资源队列</th>
            <th>发布渠道</th>
            <th>授权</th>
            <th>状态</th>
            <th>创建时间</th>
            <th>操作</th>
          </tr>
        </thead>
        <tbody>
          <% status_labels = { "active" => "托管中", "paused" => "暂停", "terminated" => "终止" } %>
          <% @hosting_accounts.each do |a| %>
            <tr>
              <td><span class="admin-label-muted"><%= a.id %></span></td>
              <td><%= a.client&.name || '-' %></td>
              <td><%= a.platform %></td>
              <td><%= a.theme || '-' %></td>
              <td><%= WorkMode.find(a.resource_queue)&.name || a.resource_queue || '-' %></td>
              <td><%= a.publish_channel || '-' %></td>
              <td>
                <% 
                  auth_labels = { "pending" => "未授权", "authorizing" => "授权中", "authorized" => "已授权", "failed" => "失败" }
                  auth_status = case a.publish_channel
                    when 'postpeer'  then a.postpeer_account&.auth_status
                    when 'postforme' then a.postforme_account&.auth_status
                    when 'x_api'     then a.x_credential&.auth_status
                  end
                %>
                <span class="admin-label-muted"><%= auth_status ? (auth_labels[auth_status] || auth_status) : '未授权' %></span>
              </td>
              <td><span class="admin-label-muted"><%= status_labels[a.status] || a.status %></span></td>
              <td><span class="admin-label-muted"><%= a.created_at&.strftime('%m-%d %H:%M') %></span></td>
              <td>
                <div style="display: flex; gap: 8px;">
                  <button type="button" onclick="openEditHostingModal(<%= a.id %>)" class="admin-link-quiet" style="color: var(--accent); background: none; border: none; cursor: pointer; padding: 0;">编辑</button>
                  <%= link_to "生成任务", create_task_admin_hosting_account_path(a), data: { turbo_method: :post, turbo_confirm: "从资源队列取一条成品生成托管发布任务？" }, class: "admin-link-quiet", style: "color: var(--accent);" %>
                  <% if a.publish_channel == 'postpeer' %>
                    <%= link_to "授权", start_postpeer_auth_admin_hosting_account_path(a), data: { turbo_method: :post }, class: "admin-link-quiet", style: "color: var(--accent);" %>
                    <%= link_to "确认授权", confirm_postpeer_auth_admin_hosting_account_path(a), data: { turbo_method: :post }, class: "admin-link-quiet", style: "color: var(--success);" %>
                  <% elsif a.publish_channel == 'postforme' %>
                    <%= link_to "授权", start_postforme_auth_admin_hosting_account_path(a), data: { turbo_method: :post }, class: "admin-link-quiet", style: "color: var(--accent);" %>
                    <%= link_to "确认授权", confirm_postforme_auth_admin_hosting_account_path(a), data: { turbo_method: :post }, class: "admin-link-quiet", style: "color: var(--success);" %>
                  <% elsif a.publish_channel == 'x_api' %>
                    <%= link_to "授权", start_x_auth_admin_hosting_account_path(a), data: { turbo_method: :post }, class: "admin-link-quiet", style: "color: var(--accent);" %>
                    <button type="button" onclick="completeXAuth(<%= a.id %>)" class="admin-link-quiet" style="color: var(--success); background: none; border: none; cursor: pointer; padding: 0;">完成认证</button>
                  <% end %>
                  <%= link_to "删除", admin_hosting_account_path(a), data: { turbo_method: :delete, turbo_confirm: "确定删除该托管账号吗？" }, class: "admin-link-quiet", style: "color: var(--danger);" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <div class="admin-pagination">
      <%= paginate @hosting_accounts %>
    </div>
  <% else %>
    <div class="admin-empty-state">暂无托管账号数据。</div>
  <% end %>
</div>

<div id="hosting-modal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.7); z-index: 1000; justify-content: center; align-items: center;">
  <div style="background: #1e293b; border-radius: 12px; width: 560px; max-width: 90%; max-height: 90%; overflow: hidden;">
    <iframe id="hosting-iframe" style="width: 100%; height: 420px; border: none;" src=""></iframe>
  </div>
</div>

<script>
  var hostingModal = document.getElementById('hosting-modal');
  var hostingIframe = document.getElementById('hosting-iframe');

  hostingIframe.onload = function() {
    try {
      var doc = hostingIframe.contentDocument || hostingIframe.contentWindow.document;
      var h = doc.body.scrollHeight;
      var max = Math.floor(window.innerHeight * 0.85);
      hostingIframe.style.height = Math.min(h, max) + 'px';
    } catch (e) {}
  };

  function openNewHostingModal() {
    hostingIframe.src = '<%= new_modal_admin_hosting_accounts_path %>';
    hostingModal.style.display = 'flex';
  }

  function openEditHostingModal(id) {
    hostingIframe.src = '/admin/hosting_accounts/' + id + '/edit_modal';
    hostingModal.style.display = 'flex';
  }

  function closeHostingModal(refresh) {
    hostingModal.style.display = 'none';
    hostingIframe.src = '';
    if (refresh) { location.reload(); }
  }

  function completeXAuth(id) {
    var code = prompt('请粘贴 X 授权码或整段回调 URL：');
    if (!code || code.trim() === '') return;
    var form = document.createElement('form');
    form.method = 'POST';
    form.action = '/admin/hosting_accounts/' + id + '/complete_x_auth';
    var codeInput = document.createElement('input');
    codeInput.type = 'hidden';
    codeInput.name = 'code';
    codeInput.value = code;
    form.appendChild(codeInput);
    var csrf = document.querySelector('meta[name="csrf-token"]');
    if (csrf) {
      var csrfInput = document.createElement('input');
      csrfInput.type = 'hidden';
      csrfInput.name = 'authenticity_token';
      csrfInput.value = csrf.content;
      form.appendChild(csrfInput);
    }
    document.body.appendChild(form);
    form.submit();
  }

  hostingModal.addEventListener('click', function(e) {
    if (e.target === hostingModal) { closeHostingModal(false); }
  });
</script>
