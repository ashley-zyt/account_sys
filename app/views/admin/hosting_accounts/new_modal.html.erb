<!DOCTYPE html>
<html>
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
  <%= render "admin/shared/select_widgets" %>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #0f172a; color: #e2e8f0; padding: 20px; }
    .modal-title { font-size: 18px; font-weight: 600; margin-bottom: 20px; color: #f1f5f9; }
    .form-group { margin-bottom: 16px; }
    .form-label { display: block; font-size: 13px; font-weight: 500; color: #94a3b8; margin-bottom: 6px; }
    .form-input { width: 100%; padding: 10px 12px; font-size: 14px; background: #1e293b; border: 1px solid #334155; border-radius: 6px; color: #e2e8f0; outline: none; }
    .form-input:focus { border-color: #3b82f6; }
    textarea.form-input { resize: vertical; min-height: 60px; }
    .form-actions { display: flex; gap: 10px; margin-top: 24px; }
    .btn { padding: 10px 20px; font-size: 14px; font-weight: 500; border: none; border-radius: 6px; cursor: pointer; }
    .btn-primary { background: #3b82f6; color: white; }
    .btn-secondary { background: #334155; color: #e2e8f0; }
    .error-message { color: #f87171; font-size: 13px; margin-bottom: 12px; display: none; }
    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0 16px; }
    .form-group-full { grid-column: 1 / -1; }
  </style>
</head>
<body>
  <div class="modal-title">新增托管账号</div>
  <div id="hosting-error" class="error-message"></div>

  <form id="hosting-form">
    <div class="form-grid">
      <div class="form-group">
        <label class="form-label">客户 <span style="color: #f87171;">*</span></label>
        <%= admin_searchable_select "hosting_account[client_id]", @clients.map { |c| [c.name, c.id] }, placeholder: "请选择客户", required: true %>
      </div>
      <div class="form-group">
        <label class="form-label">平台 <span style="color: #f87171;">*</span></label>
        <select name="hosting_account[platform]" id="hosting-platform" class="form-input">
          <option value="twitter">twitter</option>
          <option value="youtube">youtube</option>
          <option value="tiktok">tiktok</option>
          <option value="instagram">instagram</option>
          <option value="facebook">facebook</option>
        </select>
      </div>
      <div class="form-group">
        <label class="form-label">主题</label>
        <%= admin_searchable_select "hosting_account[theme]", @themes.map { |t| [t, t] }, placeholder: "请选择主题" %>
      </div>
      <div class="form-group">
        <label class="form-label">资源队列</label>
        <%= admin_searchable_select "hosting_account[resource_queue]", @resource_queues, placeholder: "请选择资源队列" %>
      </div>
      <div class="form-group">
        <label class="form-label">发布渠道</label>
        <select name="hosting_account[publish_channel]" id="hosting-publish-channel" class="form-input"></select>
      </div>
      <div class="form-group">
        <label class="form-label">状态</label>
        <select name="hosting_account[status]" class="form-input">
          <option value="active">托管中</option>
          <option value="paused">暂停</option>
          <option value="terminated">终止</option>
        </select>
      </div>
      <div class="form-group form-group-full">
        <label class="form-label">备注</label>
        <textarea name="hosting_account[remark]" class="form-input" rows="2" placeholder="备注信息"></textarea>
      </div>
    </div>

    <div class="form-actions">
      <button type="button" class="btn btn-secondary" onclick="closeModal()">取消</button>
      <button type="submit" class="btn btn-primary">保存</button>
    </div>
  </form>

  <script>
    var CHANNEL_OPTIONS = {
      twitter:   [['x_api', 'x_api']],
      youtube:   [['postpeer', 'postpeer'], ['postforme', 'postforme']],
      tiktok:    [['postpeer', 'postpeer'], ['postforme', 'postforme']],
      instagram: [['postpeer', 'postpeer'], ['postforme', 'postforme']],
      facebook:  [['postpeer', 'postpeer'], ['postforme', 'postforme']]
    };

    function renderChannels(platform, selected) {
      var opts = CHANNEL_OPTIONS[platform] || [];
      var sel = document.getElementById('hosting-publish-channel');
      sel.innerHTML = '';
      opts.forEach(function(pair) {
        var o = document.createElement('option');
        o.value = pair[1];
        o.textContent = pair[0];
        if (pair[1] === selected) { o.selected = true; }
        sel.appendChild(o);
      });
    }

    var platformSel = document.getElementById('hosting-platform');
    platformSel.addEventListener('change', function() { renderChannels(this.value, null); });
    renderChannels(platformSel.value, null);

    document.getElementById('hosting-form').addEventListener('submit', function(e) {
      e.preventDefault();
      var form = this;
      var formData = new FormData(form);
      var csrfToken = document.querySelector('meta[name="csrf-token"]').content;
      var errorDiv = document.getElementById('hosting-error');
      errorDiv.style.display = 'none';
      errorDiv.textContent = '';

      fetch('<%= admin_hosting_accounts_path %>', {
        method: 'POST',
        headers: { 'X-CSRF-Token': csrfToken, 'Accept': 'application/json' },
        body: formData
      })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        if (data.success) {
          if (window.parent && window.parent.closeHostingModal) { window.parent.closeHostingModal(true); }
        } else {
          errorDiv.textContent = data.message || '保存失败';
          errorDiv.style.display = 'block';
        }
      })
      .catch(function() {
        errorDiv.textContent = '保存失败，请重试';
        errorDiv.style.display = 'block';
      });
    });

    function closeModal() {
      if (window.parent && window.parent.closeHostingModal) { window.parent.closeHostingModal(false); }
    }
  </script>
</body>
</html>
