<% content_for :page_title do %>
  托管发布任务
<% end %>
<% content_for :page_subtitle do %>
  客户托管账号的发布任务与结果
<% end %>

<div class="admin-card">
  <div class="admin-card-header">
    <div>
      <div class="admin-card-title">托管发布任务列表</div>
      <div class="admin-card-subtitle">从资源队列取成品、分配给托管账号发布的记录</div>
    </div>
    <div class="admin-card-header-right">
      <span class="admin-tag">共 <%= @hosting_publish_tasks.total_count %> 条</span>
    </div>
  </div>

  <% if @hosting_publish_tasks.any? %>
    <div class="admin-table-wrapper admin-table-scroll">
      <table class="admin-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>资源</th>
            <th>平台</th>
            <th>主题</th>
            <th>托管账号</th>
            <th>客户</th>
            <th>发布渠道</th>
            <th>状态</th>
            <th>失败原因</th>
            <th>执行时间</th>
            <th>创建时间</th>
            <th>操作</th>
          </tr>
        </thead>
        <tbody>
          <% status_labels = { "pending" => "待发布", "executing" => "执行中", "success" => "成功", "failed" => "失败" } %>
          <% @hosting_publish_tasks.each do |t| %>
            <tr>
              <td><span class="admin-label-muted"><%= t.id %></span></td>
              <td>
                <span class="admin-label-muted"><%= t.resource_type.present? ? "#{t.resource_type}##{t.resource_id}" : '-' %></span>
              </td>
              <td><%= t.platform || '-' %></td>
              <td><%= t.theme || '-' %></td>
              <td><span class="admin-label-muted"><%= t.hosting_account_id %></span></td>
              <td><%= t.client&.name || '-' %></td>
              <td><%= t.publish_channel || '-' %></td>
              <td>
                <span class="admin-label-muted"><%= status_labels[t.status] || t.status %></span>
              </td>
              <td><span class="admin-label-muted" title="<%= t.error_msg.to_s %>"><%= truncate(t.error_msg.to_s, length: 20) %></span></td>
              <td><span class="admin-label-muted"><%= t.executed_at&.strftime('%m-%d %H:%M') || '-' %></span></td>
              <td><span class="admin-label-muted"><%= t.created_at&.strftime('%m-%d %H:%M') %></span></td>
              <td>
                <% if %w[pending failed].include?(t.status) %>
                  <%= link_to "发布", publish_admin_hosting_publish_task_path(t), data: { turbo_method: :post, turbo_confirm: "确定执行发布该托管任务吗？" }, class: "admin-link-quiet", style: "color: var(--success);" %>
                <% else %>
                  <span class="admin-label-muted">-</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <div class="admin-pagination">
      <%= paginate @hosting_publish_tasks %>
    </div>
  <% else %>
    <div class="admin-empty-state">暂无托管发布任务数据。</div>
  <% end %>
</div>
