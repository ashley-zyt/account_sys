<% content_for :page_title do %>
  发文列表
<% end %>
<% content_for :page_subtitle do %>
  已拉取的大V发文，用于评论互动
<% end %>

<%= render "admin/shared/select_widgets" %>

<div class="admin-card">
  <div class="admin-card-header">
    <div>
      <div class="admin-card-title">发文列表</div>
      <div class="admin-card-subtitle">查看已拉取的大V发文（过滤转发）</div>
    </div>
    <div class="admin-card-header-right">
      <span class="admin-tag">共 <%= @influencer_posts.total_count %> 条</span>
    </div>
  </div>

  <div class="admin-filter-form">
    <%= search_form_for [:admin, @q], class: "admin-filter-form" do |f| %>
      <div class="admin-filter-group">
        <label class="admin-filter-label">大V</label>
        <%= f.searchable_select :influencer_id_eq, @influencers.map { |i| [i.username, i.id] }, { include_blank: "所有大V" }, class: "admin-input admin-filter-input" %>
      </div>
      <div class="admin-filter-group">
        <label class="admin-filter-label">发文内容</label>
        <%= f.search_field :title_cont, class: "admin-input admin-filter-input", placeholder: "搜索发文内容..." %>
      </div>
      <div style="margin-left: auto;">
        <%= f.submit "筛选", class: "admin-button-primary" %>
        <%= link_to "重置", admin_influencer_posts_path, class: "admin-button-secondary" %>
      </div>
    <% end %>
  </div>

  <% if @influencer_posts.any? %>
    <div class="admin-table-wrapper admin-table-scroll">
      <table class="admin-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>大V</th>
            <th>发文 ID</th>
            <th>发文内容</th>
            <th>发文时间</th>
            <th>评论任务数</th>
            <th>创建时间</th>
          </tr>
        </thead>
        <tbody>
          <% @influencer_posts.each do |post| %>
            <tr>
              <td>
                <span class="admin-label-muted"><%= post.id %></span>
              </td>
              <td><%= post.influencer&.username || '-' %></td>
              <td>
                <span class="admin-label-muted"><%= post.post_id %></span>
              </td>
              <td>
                <span class="admin-label-muted" title="<%= post.title %>"><%= truncate(post.title.to_s, length: 50) %></span>
              </td>
              <td>
                <span class="admin-label-muted"><%= post.posted_at&.strftime('%m-%d %H:%M') || '-' %></span>
              </td>
              <td>
                <span class="admin-label-muted"><%= post.comment_tasks.count %></span>
              </td>
              <td>
                <span class="admin-label-muted"><%= post.created_at&.strftime('%m-%d %H:%M') %></span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <div class="admin-pagination">
      <%= paginate @influencer_posts %>
    </div>
  <% else %>
    <div class="admin-empty-state">暂无发文数据。</div>
  <% end %>
</div>
