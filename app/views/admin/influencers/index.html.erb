<% content_for :page_title do %>
  大V管理
<% end %>
<% content_for :page_subtitle do %>
  X 平台领域大V列表，用于评论互动
<% end %>

<%= render "admin/shared/select_widgets" %>

<div class="admin-card">
  <div class="admin-card-header">
    <div>
      <div class="admin-card-title">大V列表</div>
      <div class="admin-card-subtitle">维护参与评论互动的大V</div>
    </div>
    <div class="admin-card-header-right">
      <span class="admin-tag">共 <%= @influencers.total_count %> 条</span>
      <%= link_to "添加大V", new_admin_influencer_path, class: "admin-button-primary" %>
    </div>
  </div>

  <div class="admin-filter-form">
    <%= search_form_for [:admin, @q], class: "admin-filter-form" do |f| %>
      <div class="admin-filter-group">
        <label class="admin-filter-label">用户名</label>
        <%= f.search_field :username_cont, class: "admin-input admin-filter-input", placeholder: "搜索用户名..." %>
      </div>
      <div class="admin-filter-group">
        <label class="admin-filter-label">主题</label>
        <%= f.searchable_select :theme_eq, @themes.map { |t| [t.name, t.name] }, { include_blank: "所有主题" }, class: "admin-input admin-filter-input" %>
      </div>
      <div class="admin-filter-group">
        <label class="admin-filter-label">启用</label>
        <%= f.searchable_select :enabled_eq, [["启用", true], ["停用", false]], { include_blank: "全部" }, class: "admin-input admin-filter-input" %>
      </div>
      <div style="margin-left: auto;">
        <%= f.submit "筛选", class: "admin-button-primary" %>
        <%= link_to "重置", admin_influencers_path, class: "admin-button-secondary" %>
      </div>
    <% end %>
  </div>

  <% if @influencers.any? %>
    <div class="admin-table-wrapper admin-table-scroll">
      <table class="admin-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>用户名</th>
            <th>用户 ID</th>
            <th>账号链接</th>
            <th>平台</th>
            <th>主题</th>
            <th>启用</th>
            <th>发文数</th>
            <th>备注</th>
            <th>创建时间</th>
            <th>操作</th>
          </tr>
        </thead>
        <tbody>
          <% @influencers.each do |inf| %>
            <tr>
              <td>
                <span class="admin-label-muted"><%= inf.id %></span>
              </td>
              <td><%= inf.username %></td>
              <td>
                <span class="admin-label-muted"><%= inf.user_id.presence || '-' %></span>
              </td>
              <td>
                <% if inf.account_url.present? %>
                  <%= link_to truncate(inf.account_url, length: 28), inf.account_url, target: "_blank", class: "admin-link-quiet", title: inf.account_url %>
                <% else %>
                  <span class="admin-label-muted">-</span>
                <% end %>
              </td>
              <td>
                <span class="admin-label-muted"><%= inf.platform %></span>
              </td>
              <td>
                <span class="admin-label-muted"><%= inf.theme || '-' %></span>
              </td>
              <td>
                <% if inf.enabled %>
                  <span class="admin-pill-status admin-pill-status-success"><span class="admin-pill-status-dot"></span>启用</span>
                <% else %>
                  <span class="admin-pill-status admin-pill-status-failed"><span class="admin-pill-status-dot"></span>停用</span>
                <% end %>
              </td>
              <td>
                <span class="admin-label-muted"><%= inf.influencer_posts.count %></span>
              </td>
              <td>
                <span class="admin-label-muted"><%= truncate(inf.remark.to_s, length: 30) %></span>
              </td>
              <td>
                <span class="admin-label-muted"><%= inf.created_at&.strftime('%m-%d %H:%M') %></span>
              </td>
              <td>
                <div style="display: flex; gap: 8px;">
                  <%= link_to "编辑", edit_admin_influencer_path(inf), class: "admin-link-quiet", style: "color: var(--accent);" %>
                  <%= link_to "删除", admin_influencer_path(inf), data: { turbo_method: :delete, turbo_confirm: "确定删除该大V吗？" }, class: "admin-link-quiet", style: "color: var(--danger);" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <div class="admin-pagination">
      <%= paginate @influencers %>
    </div>
  <% else %>
    <div class="admin-empty-state">暂无大V数据。</div>
  <% end %>
</div>
