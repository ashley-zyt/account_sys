<%= render "admin/shared/select_widgets" %>

<% if kol.errors.any? %>
  <div id="kol-form-error-overlay" style="position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 10000; display: flex; align-items: center; justify-content: center; padding: 20px;">
    <div style="background: #1e293b; border: 1px solid rgba(239,68,68,0.5); border-radius: 12px; max-width: 480px; width: 100%; padding: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.4);">
      <div style="font-size: 16px; font-weight: 600; color: #f87171; margin-bottom: 12px;">保存失败，请检查以下问题</div>
      <ul style="list-style: disc; padding-left: 18px; margin: 0 0 16px; color: #e2e8f0; font-size: 13px; line-height: 1.6;">
        <% kol.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
      <div style="text-align: right;">
        <button type="button" onclick="document.getElementById('kol-form-error-overlay').remove()" style="padding: 8px 18px; background: #3b82f6; color: #fff; border: none; border-radius: 6px; cursor: pointer; font-size: 13px;">知道了</button>
      </div>
    </div>
  </div>
<% end %>

<%= form_with model: [:admin, kol], class: "admin-form" do |f| %>
  <div class="admin-two-column">
    <div>
      <div class="admin-field-label">KOL 名称 / 常用用户名 <span style="color: #ef4444;">*</span></div>
      <%= f.text_field :name, class: "admin-input", required: true %>
    </div>
    <div>
      <div class="admin-field-label">所属领域</div>
      <%= render "admin/shared/combobox",
            name: "kol[domain_name]",
            value: kol.domain&.name,
            list_id: "kol-domain-list",
            options: @domains.map(&:name),
            placeholder: "选择或输入领域（不存在则创建）" %>
    </div>
    <div>
      <div class="admin-field-label">粉丝量级</div>
      <% selected_tier = (kol.follower_min.present? || kol.follower_max.present?) ? "#{kol.follower_min},#{kol.follower_max}" : nil %>
      <%= select_tag "kol[follower_tier]",
            options_for_select(Kol::FOLLOWER_TIERS.map { |t| [t[:label], "#{t[:min]},#{t[:max]}"] }, selected_tier),
            include_blank: "未设置", class: "admin-input" %>
    </div>
    <div>
      <div class="admin-field-label">所在国家/地区</div>
      <%= f.text_field :country, class: "admin-input" %>
    </div>
    <div>
      <div class="admin-field-label">使用语言</div>
      <%= render "admin/shared/combobox",
            name: "kol[language_name]",
            value: kol.language&.name,
            list_id: "kol-language-list",
            options: @languages.map(&:name),
            placeholder: "选择或输入语言（不存在则创建）" %>
    </div>
    <div>
      <div class="admin-field-label">归属人（负责人） <span style="color: #ef4444;">*</span></div>
      <%= render "admin/shared/searchable_select",
            name: "kol[owner]",
            options: Account::OPERATORS.map { |o| [o, o] },
            selected: kol.owner,
            selected_label: kol.owner,
            placeholder: "请选择负责人",
            include_blank: "请选择负责人" %>
    </div>
    <div>
      <div class="admin-field-label">当前状态</div>
      <%= render "admin/shared/searchable_select",
            name: "kol[status]",
            options: Kol::STATUS_LABELS.map { |k, v| [v, k] },
            selected: kol.status,
            selected_label: kol.status_label,
            placeholder: "选择状态" %>
    </div>
    <div>
      <div class="admin-field-label">备注</div>
      <%= f.text_field :notes, class: "admin-input" %>
    </div>
  </div>

  <div class="admin-section-title" style="margin-top: 16px;">联系方式 / 多平台名片夹</div>
  <div class="admin-section-subtitle">录入各平台主页链接，并可为支持私信的渠道启用触达、设定优先级</div>

  <div id="kol-contacts">
    <%= f.fields_for :kol_contacts do |cf| %>
      <%= render "kol_contact_fields", f: cf %>
    <% end %>
  </div>

  <button type="button" id="add-kol-contact" class="admin-button-secondary" style="margin-bottom: 16px;">+ 添加联系方式</button>

  <template id="kol-contact-template">
    <%= f.fields_for :kol_contacts, KolContact.new, child_index: "NEW_RECORD" do |cf| %>
      <%= render "kol_contact_fields", f: cf %>
    <% end %>
  </template>

  <div class="admin-section-title" style="margin-top: 16px;">需要填写的变量</div>
  <div class="admin-section-subtitle">根据所选领域自动匹配；这些内容录入之前，不会自动发消息。</div>
  <div id="kol-variables-section"></div>

  <script type="application/json" id="kol-variable-data">
    <%= raw({ templates: @template_var_data, variables: @all_variables_data }.to_json) %>
  </script>

  <script>
    (function () {
      var dataEl = document.getElementById('kol-variable-data');
      var section = document.getElementById('kol-variables-section');
      if (!dataEl || !section) return;

      var data = JSON.parse(dataEl.textContent);
      var templates = data.templates || [];
      var variables = data.variables || [];
      var domainInput = document.querySelector('input[name="kol[domain_name]"]');

      function esc(s) {
        return String(s == null ? '' : s)
          .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
      }

      // 录入时按「领域名 + 首次建联」筛选所需变量（平台在发送时才参与匹配）
      function neededIdentifiers(domainName) {
        var needed = {};
        templates.forEach(function (t) {
          if (t.domain_name === domainName) {
            t.variables.forEach(function (v) { needed[v] = true; });
          }
        });
        return Object.keys(needed);
      }

      function render() {
        var domainName = domainInput ? domainInput.value.trim() : '';
        var needed = neededIdentifiers(domainName);
        var list = variables.filter(function (v) { return needed.indexOf(v.identifier) !== -1; });

        if (list.length === 0) {
          section.innerHTML = '<div class="admin-empty-state">根据当前领域暂无需要填写的变量。</div>';
          return;
        }

        var html = '<div class="admin-two-column">';
        list.forEach(function (v) {
          html += '<div>' +
            '<div class="admin-field-label">' + esc(v.name) + '（' + esc(v.identifier) + '）</div>' +
            '<input type="text" name="kol_variables[' + esc(v.identifier) + ']" class="admin-input" value="' + esc(v.value) + '" placeholder="' + esc(v.description) + '">' +
            '</div>';
        });
        html += '</div>';
        section.innerHTML = html;
      }

      if (domainInput) {
        domainInput.addEventListener('input', render);
        domainInput.addEventListener('change', render);
      }
      render();
    })();
  </script>

  <div style="margin-top: 16px;">
    <button type="submit" class="admin-button-primary">保存</button>
    <%= link_to "取消", admin_kols_path, class: "admin-button-secondary" %>
  </div>
<% end %>

<script>
  (function () {
    var container = document.getElementById('kol-contacts');
    var addBtn = document.getElementById('add-kol-contact');
    var template = document.getElementById('kol-contact-template');
    if (!container || !addBtn || !template) return;

    addBtn.addEventListener('click', function () {
      var idx = new Date().getTime();
      var html = template.innerHTML.replace(/NEW_RECORD/g, idx);
      container.insertAdjacentHTML('beforeend', html);
    });
  })();
</script>
