<div class="kol-chat">
  <% messages.group_by { |m| m.kol_contact_id }.each do |contact_id, msgs| %>
    <% contact = msgs.first&.kol_contact %>
    <div style="border: 1px solid rgba(148,163,184,0.25); border-radius: 8px; padding: 12px; margin-bottom: 12px; background: rgba(148,163,184,0.03);">
      <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 10px; padding-bottom: 8px; border-bottom: 1px solid rgba(148,163,184,0.15); flex-wrap: wrap;">
        <span style="font-weight: 600; color: #e2e8f0; font-size: 13px;"><%= contact&.platform_icon || "🔗" %> <%= contact&.platform || "未指定渠道" %></span>
        <% if contact && (contact.nickname.presence || contact.url.presence) %>
          <span class="admin-label-muted" style="font-size: 12px;"><%= contact.nickname.presence || contact.url %></span>
        <% end %>
        <span style="margin-left: auto; font-size: 11px; color: #94a3b8;"><%= msgs.size %> 条</span>
      </div>

      <% msgs.each do |m| %>
        <div class="kol-chat-row <%= m.outgoing? ? "out" : "in" %>">
          <div class="kol-bubble <%= m.outgoing? ? "out" : "in" %>">
            <div class="kol-bubble-meta">
              <span><%= m.kol_contact&.platform_icon %> <%= m.platform %></span>
              <span><%= m.outgoing? ? (m.account&.account_name || "我方") : "KOL" %></span>
              <% if m.outgoing? %><span><%= m.manual? ? "人工" : "自动" %></span><% end %>
              <span><%= m.occurred_at&.strftime("%m-%d %H:%M") || m.created_at&.strftime("%m-%d %H:%M") %></span>
            </div>
            <div class="kol-bubble-content"><%= m.content %></div>
            <div style="margin-top: 4px; display: flex; gap: 6px; flex-wrap: wrap;">
              <% if m.sent_failed? %>
                <span class="admin-pill-status" style="background: rgba(239,68,68,0.1); color: #ef4444; font-size: 11px;">发送失败</span>
              <% elsif m.sent_success? %>
                <span class="admin-pill-status" style="background: rgba(34,197,94,0.1); color: #22c55e; font-size: 11px;">发送成功</span>
              <% elsif m.queued? %>
                <span class="admin-pill-status" style="background: rgba(156,163,175,0.1); color: #9ca3af; font-size: 11px;">待发送</span>
              <% elsif m.ignored? %>
                <span class="admin-pill-status" style="background: rgba(100,116,139,0.15); color: #94a3b8; font-size: 11px;">已放弃</span>
              <% elsif m.replied? %>
                <span class="admin-pill-status" style="background: rgba(168,85,247,0.1); color: #a855f7; font-size: 11px;">已回复</span>
              <% end %>
              <% if m.is_auto_reply? %>
                <span class="admin-pill-status" style="background: rgba(245,158,11,0.1); color: #f59e0b; font-size: 11px;">自动回复</span>
              <% end %>
              <% if m.sent_failed? && m.error_msg.present? %>
                <span class="admin-label-muted" style="font-size: 11px;" title="<%= m.error_msg %>"><%= truncate(m.error_msg, length: 40) %></span>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
