<%
  colors = {
    "reserved"            => "148,163,184",
    "pending"             => "59,130,246",
    "contacting"          => "245,158,11",
    "replied_unprocessed" => "239,68,68",
    "negotiating"         => "14,165,233",
    "cooperating"         => "34,197,94",
    "failed"              => "239,68,68",
    "unresponsive"        => "100,116,139"
  }
  label = Kol::STATUS_LABELS[status.to_s] || status.to_s
  rgb = colors[status.to_s] || "148,163,184"
%>
<span class="admin-pill-status" style="background: rgba(<%= rgb %>, 0.12); color: rgb(<%= rgb %>);">
  <span class="admin-pill-status-dot"></span>
  <%= label %>
</span>
