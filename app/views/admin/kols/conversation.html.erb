<style>
  .kol-chat { display: flex; flex-direction: column; gap: 10px; padding: 4px; }
  .kol-chat-row { display: flex; }
  .kol-chat-row.out { justify-content: flex-end; }
  .kol-chat-row.in { justify-content: flex-start; }
  .kol-bubble { max-width: 80%; padding: 10px 12px; border-radius: 12px; font-size: 13px; line-height: 1.55; }
  .kol-bubble.out { background: rgba(59,130,246,0.14); border: 1px solid rgba(59,130,246,0.32); color: #e2e8f0; }
  .kol-bubble.in { background: rgba(148,163,184,0.12); border: 1px solid rgba(148,163,184,0.26); color: #e2e8f0; }
  .kol-bubble-meta { display: flex; gap: 8px; align-items: center; font-size: 11px; color: #94a3b8; margin-bottom: 4px; flex-wrap: wrap; }
  .kol-bubble-content { white-space: pre-wrap; word-break: break-word; }
  .kol-contact-tabs { display: flex; gap: 6px; overflow-x: auto; padding: 4px 2px 10px; border-bottom: 1px solid rgba(148,163,184,0.15); margin-bottom: 10px; }
  .kol-contact-tab { display: flex; flex-direction: column; align-items: flex-start; gap: 2px; padding: 6px 10px; border: 1px solid rgba(148,163,184,0.25); border-radius: 8px; background: transparent; color: #cbd5e1; font-size: 12px; cursor: pointer; white-space: nowrap; }
  .kol-contact-tab.active { background: rgba(59,130,246,0.15); border-color: rgba(59,130,246,0.5); color: #60a5fa; }
  .kol-contact-tab-name { font-size: 11px; color: #94a3b8; max-width: 140px; overflow: hidden; text-overflow: ellipsis; }
  .kol-contact-tab.active .kol-contact-tab-name { color: #93c5fd; }
  .kol-contact-panel { display: none; }
  .kol-contact-panel.active { display: block; }

  .kol-actions { margin-top: 14px; border-top: 1px solid rgba(148,163,184,0.18); padding-top: 12px; display: flex; flex-direction: column; gap: 14px; }
  .kol-actions-title { font-size: 12px; font-weight: 600; color: #94a3b8; margin-bottom: 8px; }
  .kol-reply-box, .kol-status-box, .kol-note-box { display: flex; flex-direction: column; gap: 8px; }
  .kol-reply-account { color: #60a5fa; font-weight: 600; }
  .kol-status-pills { display: flex; flex-wrap: wrap; gap: 6px; }
  .kol-status-pill { padding: 5px 10px; font-size: 12px; border-radius: 6px; border: 1px solid rgba(148,163,184,0.3); background: transparent; color: #cbd5e1; cursor: pointer; }
  .kol-status-pill:hover { border-color: #475569; }
  .kol-status-pill.active { background: rgba(59,130,246,0.15); border-color: rgba(59,130,246,0.5); color: #60a5fa; }
  .kol-note-box { flex-direction: row; align-items: center; }
  .kol-note-box .admin-input { flex: 1; }
</style>

<% if @contacts.any? %>
  <div class="kol-contact-tabs">
    <% @contacts.each_with_index do |c, i| %>
      <button type="button" class="kol-contact-tab <%= 'active' if c.id == @active_contact_id %>" data-contact-id="<%= c.id %>">
        <span><%= c.platform_icon %> <%= c.platform %></span>
        <span class="kol-contact-tab-name"><%= c.nickname.presence || c.url.presence || "无名称" %></span>
      </button>
    <% end %>
  </div>

  <% @contacts.each_with_index do |c, i| %>
    <% msgs = @messages.select { |m| m.kol_contact_id == c.id } %>
    <div class="kol-contact-panel <%= 'active' if c.id == @active_contact_id %>" data-contact-panel="<%= c.id %>">
      <% if msgs.any? %>
        <div class="kol-chat">
          <% msgs.each do |m| %>
            <%= render "message_bubble", m: m %>
          <% end %>
        </div>
      <% else %>
        <div class="admin-empty-state">该渠道暂无消息记录。</div>
      <% end %>
    </div>
  <% end %>
<% else %>
  <div class="admin-empty-state">暂无会话记录。</div>
<% end %>

<div class="kol-actions" data-kol-id="<%= @kol.id %>">
  <% if @kol.replied_unprocessed? || @kol.negotiating? %>
    <div class="kol-reply-box">
      <div class="kol-actions-title">快捷回复</div>
      <div style="font-size: 12px; color: #94a3b8;">回复账号：<span class="kol-reply-account"><%= @reply_account&.account_name || "未分配" %></span></div>
      <div style="display: flex; gap: 6px; align-items: flex-end;">
        <div style="flex: 1;">
          <%= render "admin/shared/searchable_select",
                name: "reply_template_id",
                options: @reply_templates.map { |t| [t[:label], t[:id]] },
                selected: nil,
                selected_label: nil,
                placeholder: "选择模板（可选）",
                include_blank: "手动输入" %>
        </div>
        <button type="button" class="admin-button-secondary" onclick="kolApplyTemplate(<%= @kol.id %>)">套用</button>
      </div>
      <textarea id="kol-reply-content" class="admin-input" rows="3" placeholder="输入回复内容"></textarea>
      <div style="display: flex; gap: 8px;">
        <button type="button" class="admin-button-primary" onclick="kolReply(<%= @kol.id %>)">发送回复</button>
        <% if @kol.replied_unprocessed? %>
          <button type="button" class="admin-button-secondary" onclick="kolMarkAutoReply(<%= @kol.id %>)">标记为自动回复</button>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="kol-status-box">
    <div class="kol-actions-title">快捷状态</div>
    <div class="kol-status-pills">
      <% Kol::STATUS_LABELS.each do |k, v| %>
        <button type="button" class="kol-status-pill <%= 'active' if @kol.status.to_s == k %>" onclick="kolQuickStatus(<%= @kol.id %>, '<%= k %>')"><%= v %></button>
      <% end %>
    </div>
  </div>

  <div class="kol-note-box">
    <input type="text" id="kol-note-input" class="admin-input" placeholder="追加备注...">
    <button type="button" class="admin-button-secondary" onclick="kolSaveNote(<%= @kol.id %>)">保存备注</button>
  </div>
</div>

<script type="application/json" id="kol-reply-templates">
<%= raw @reply_templates.to_json %>
</script>
