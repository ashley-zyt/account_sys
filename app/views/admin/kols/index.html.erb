<% content_for :page_title do %>
  KOL 管理
<% end %>
<% content_for :page_subtitle do %>
  KOL 自动化触达与全生命周期管理
<% end %>

<%
  kol_summary = [
    { label: "全部 KOL", value: @status_counts.values.sum, color: "#94a3b8", url: admin_kols_path },
    { label: "待回复", value: (@status_counts["replied_unprocessed"] || 0), color: "#f87171", url: admin_kols_path(q: { status_eq: "replied_unprocessed" }) },
    { label: "联系中", value: (@status_counts["contacting"] || 0), color: "#fbbf24", url: admin_kols_path(q: { status_eq: "contacting" }) },
    { label: "洽谈中", value: (@status_counts["negotiating"] || 0), color: "#22d3ee", url: admin_kols_path(q: { status_eq: "negotiating" }) },
    { label: "已合作", value: (@status_counts["cooperating"] || 0), color: "#34d399", url: admin_kols_path(q: { status_eq: "cooperating" }) },
    { label: "未回复", value: (@status_counts["unresponsive"] || 0), color: "#64748b", url: admin_kols_path(q: { status_eq: "unresponsive" }) },
    { label: "待补全变量", value: @variables_incomplete_count, color: "#fb923c", url: admin_kols_path(q: { variables_incomplete_eq: "true" }) }
  ]
%>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 12px; margin-bottom: 16px;">
  <% kol_summary.each do |s| %>
    <%= link_to s[:url], style: "display: block; background: #0f172a; border: 1px solid rgba(148,163,184,0.2); border-radius: 10px; padding: 14px 16px; border-left: 3px solid #{s[:color]}; text-decoration: none; transition: border-color 0.15s;" do %>
      <div style="font-size: 12px; color: #94a3b8; margin-bottom: 6px;"><%= s[:label] %></div>
      <div style="font-size: 26px; font-weight: 700; color: <%= s[:color] %>;"><%= s[:value] %></div>
    <% end %>
  <% end %>
</div>

<%= render "admin/shared/select_widgets" %>

<div class="admin-card">
  <div class="admin-card-header">
    <div>
      <div class="admin-card-title">KOL 列表</div>
      <div class="admin-card-subtitle">线索录入 → 智能触达 → 人工跟进</div>
    </div>
    <div class="admin-card-header-right">
      <span class="admin-tag">共 <%= @kols.total_count %> 条</span>
      <%= link_to "录入 KOL", new_admin_kol_path, class: "admin-button-primary" %>
      <%= link_to "消息模板", admin_message_templates_path, class: "admin-button-secondary" %>
    </div>
  </div>

  <div class="admin-filter-form">
    <%= search_form_for [:admin, @q], class: "admin-filter-form" do |f| %>
      <div class="admin-filter-group">
        <label class="admin-filter-label">名称</label>
        <%= f.search_field :name_cont, class: "admin-input admin-filter-input", placeholder: "搜索 KOL 名称..." %>
      </div>
      <div class="admin-filter-group">
        <label class="admin-filter-label">领域</label>
        <%= render "admin/shared/searchable_select",
              name: "q[domain_id_eq]",
              options: @domains.map { |d| [d.name, d.id] },
              selected: params.dig(:q, :domain_id_eq),
              selected_label: @domains.find { |d| d.id.to_s == params.dig(:q, :domain_id_eq).to_s }&.name,
              placeholder: "所有领域",
              include_blank: "所有领域" %>
      </div>
      <div class="admin-filter-group">
        <label class="admin-filter-label">归属人</label>
        <%= render "admin/shared/searchable_select",
              name: "q[owner_eq]",
              options: Account::OPERATORS.map { |o| [o, o] },
              selected: params.dig(:q, :owner_eq),
              selected_label: params.dig(:q, :owner_eq),
              placeholder: "所有人员",
              include_blank: "所有人员" %>
      </div>
      <div class="admin-filter-group">
        <label class="admin-filter-label">状态</label>
        <%= render "admin/shared/searchable_select",
              name: "q[status_eq]",
              options: Kol::STATUS_LABELS.map { |k, v| [v, k] },
              selected: params.dig(:q, :status_eq),
              selected_label: Kol::STATUS_LABELS[params.dig(:q, :status_eq)],
              placeholder: "所有状态",
              include_blank: "所有状态" %>
      </div>
      <div class="admin-filter-group">
        <label class="admin-filter-label">语言</label>
        <%= render "admin/shared/searchable_select",
              name: "q[language_id_eq]",
              options: @languages.map { |l| [l.name, l.id] },
              selected: params.dig(:q, :language_id_eq),
              selected_label: @languages.find { |l| l.id.to_s == params.dig(:q, :language_id_eq).to_s }&.name,
              placeholder: "所有语言",
              include_blank: "所有语言" %>
      </div>
      <div style="margin-left: auto;">
        <%= f.submit "筛选", class: "admin-button-primary" %>
        <%= link_to "重置", admin_kols_path, class: "admin-button-secondary" %>
      </div>
    <% end %>
  </div>

  <% if @kols.any? %>
    <div class="admin-table-wrapper admin-table-scroll">
      <table class="admin-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>名称</th>
            <th>领域</th>
            <th>国家/地区</th>
            <th>语言</th>
            <th>归属人</th>
            <th>状态</th>
            <th>渠道</th>
            <th>最近触达</th>
            <th>下次动作</th>
            <th>操作</th>
          </tr>
        </thead>
        <tbody>
          <% @kols.each do |kol| %>
            <tr>
              <td><%= kol.id %></td>
              <td>
                <%= link_to kol.name, admin_kol_path(kol), class: "admin-link-quiet", style: "color: var(--text-primary);" %>
                <% if kol.replied_unprocessed? %>
                  <span class="admin-pill-status" style="background: rgba(239,68,68,0.15); color: #f87171; font-size: 11px; margin-left: 6px;">待回复</span>
                <% end %>
                <% if kol.variables_incomplete? %>
                  <span class="admin-pill-status" style="background: rgba(245,158,11,0.1); color: #f59e0b; font-size: 11px; margin-left: 6px;">待补全变量</span>
                <% end %>
              </td>
              <td><span class="admin-label-muted"><%= kol.domain&.name || "-" %></span></td>
              <td><span class="admin-label-muted"><%= kol.country.presence || "-" %></span></td>
              <td><span class="admin-label-muted"><%= kol.language&.name || "-" %></span></td>
              <td><span class="admin-label-muted"><%= kol.owner %></span></td>
              <td><%= render "status_badge", status: kol.status %></td>
              <td>
                <%
                  contacts = kol.kol_contacts
                  replied_count = contacts.count { |c| c.replied? }
                  contacted_count = contacts.count { |c| c.contacting? || c.replied? || c.unresponsive? }
                %>
                <span class="admin-label-muted"><%= "#{contacted_count} 已联系 · #{replied_count} 回复" %></span>
              </td>
              <td><span class="admin-label-muted"><%= kol.last_contacted_at&.strftime("%m-%d %H:%M") || "-" %></span></td>
              <td><span class="admin-label-muted"><%= kol.next_action_at&.strftime("%m-%d %H:%M") || "-" %></span></td>
              <td>
                <div style="display: flex; gap: 8px; align-items: center;">
                  <button type="button"
                          class="<%= kol.replied_unprocessed? ? 'admin-button-primary' : 'admin-button-secondary' %>"
                          style="padding: 4px 10px; font-size: 12px;"
                          data-kol-drawer-trigger
                          data-kol-url="<%= conversation_admin_kol_path(kol) %>"
                          data-kol-name="<%= kol.name %>"><%= kol.replied_unprocessed? ? "查看回复" : "会话" %></button>
                  <%= link_to "详情", admin_kol_path(kol), class: "admin-link-quiet", style: "color: var(--accent);" %>
                  <%= link_to "编辑", edit_admin_kol_path(kol), class: "admin-link-quiet", style: "color: var(--success);" %>
                  <%= link_to "删除", admin_kol_path(kol), data: { turbo_method: :delete, turbo_confirm: "确定要删除该 KOL 吗？" }, class: "admin-link-quiet", style: "color: var(--danger);" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <div class="admin-pagination">
      <%= paginate @kols %>
    </div>
  <% else %>
    <div class="admin-empty-state">暂无 KOL 数据。</div>
  <% end %>
</div>

<div class="drawer-backdrop" data-drawer-role="backdrop"></div>
<div class="drawer-panel" data-drawer-role="panel">
  <div class="drawer-header">
    <div class="drawer-title" data-drawer-role="title">会话</div>
    <button type="button" class="drawer-close" data-drawer-role="close">✕</button>
  </div>
  <div class="drawer-body" data-drawer-role="content">
    <div style="padding: 40px 20px; text-align: center; color: var(--text-muted); font-size: 12px;">点击列表中的「会话」查看对话</div>
  </div>
</div>

<script>
(function() {
  function openKolDrawer(url, name) {
    var panel = document.querySelector('[data-drawer-role="panel"]');
    var backdrop = document.querySelector('[data-drawer-role="backdrop"]');
    var content = document.querySelector('[data-drawer-role="content"]');
    var title = document.querySelector('[data-drawer-role="title"]');
    if (title) title.textContent = '会话 · ' + name;
    panel.classList.add('drawer-open');
    backdrop.classList.add('drawer-backdrop-visible');
    document.body.style.overflow = 'hidden';
    content.innerHTML = '<div style="padding: 60px 20px; text-align: center; color: var(--text-muted); font-size: 13px;">加载中...</div>';

    fetch(url, { headers: { 'Accept': 'text/html' }, credentials: 'same-origin' })
      .then(function(resp) { if (!resp.ok) throw new Error('HTTP ' + resp.status); return resp.text(); })
      .then(function(html) { content.innerHTML = html; })
      .catch(function(e) {
        content.innerHTML = '<div style="padding: 40px 20px; text-align: center; color: var(--danger); font-size: 13px;">加载失败：' + e.message + '</div>';
      });
  }

  function closeKolDrawer() {
    var panel = document.querySelector('[data-drawer-role="panel"]');
    var backdrop = document.querySelector('[data-drawer-role="backdrop"]');
    panel.classList.remove('drawer-open');
    backdrop.classList.remove('drawer-backdrop-visible');
    document.body.style.overflow = '';
  }

  document.addEventListener('click', function(e) {
    var trigger = e.target.closest('[data-kol-drawer-trigger]');
    if (trigger) {
      e.preventDefault();
      openKolDrawer(trigger.dataset.kolUrl, trigger.dataset.kolName || '');
      return;
    }

    var contactTab = e.target.closest('.kol-contact-tab');
    if (contactTab) {
      var id = contactTab.dataset.contactId;
      document.querySelectorAll('.kol-contact-tab').forEach(function(t){ t.classList.remove('active'); });
      document.querySelectorAll('[data-contact-panel]').forEach(function(p){
        p.classList.toggle('active', p.getAttribute('data-contact-panel') === id);
      });
      contactTab.classList.add('active');
      return;
    }

    if (e.target.closest('[data-drawer-role="close"]')) { closeKolDrawer(); return; }
    if (e.target.matches('[data-drawer-role="backdrop"]')) { closeKolDrawer(); return; }
  });

  document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeKolDrawer(); });
})();
</script>

<script>
  // 会话抽屉里的快捷回复 / 改状态 / 备注（inline onclick 调用，需全局）
  function kolCsrfToken() {
    var meta = document.querySelector('meta[name="csrf-token"]');
    return meta ? meta.content : '';
  }

  function kolRefresh(kolId) {
    var content = document.querySelector('[data-drawer-role="content"]');
    content.innerHTML = '<div style="padding: 40px 20px; text-align: center; color: var(--text-muted); font-size: 13px;">刷新中...</div>';
    fetch('/admin/kols/' + kolId + '/conversation', { headers: { 'Accept': 'text/html' }, credentials: 'same-origin' })
      .then(function(r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.text(); })
      .then(function(html) { content.innerHTML = html; })
      .catch(function(e) { content.innerHTML = '<div style="padding: 40px 20px; text-align: center; color: var(--danger); font-size: 13px;">刷新失败：' + e.message + '</div>'; });
  }

  function kolPost(url, body, cb) {
    fetch(url, {
      method: 'POST',
      headers: {
        'X-CSRF-Token': kolCsrfToken(),
        'Content-Type': 'application/json',
        'Accept': 'application/json'
      },
      body: JSON.stringify(body || {}),
      credentials: 'same-origin'
    })
      .then(function(r) { return r.json(); })
      .then(function(data) { cb(data); })
      .catch(function(e) { alert('操作失败：' + e.message); });
  }

  function kolApplyTemplate(kolId) {
    var hidden = document.querySelector('input[name="reply_template_id"]');
    var tid = hidden ? hidden.value : '';
    var dataEl = document.getElementById('kol-reply-templates');
    var textarea = document.getElementById('kol-reply-content');
    var hint = document.getElementById('kol-reply-var-hint');
    if (!tid || !dataEl || !textarea) return;
    var templates = JSON.parse(dataEl.textContent);
    var found = templates.find(function(t) { return String(t.id) === String(tid); });
    if (!found) return;
    textarea.value = found.content;
    if (hint) {
      if (found.missing && found.missing.length) {
        hint.textContent = '该模板包含未填写的变量：' + found.missing.map(function(m){ return '${' + m + '}'; }).join('、') + '，请在内容中替换这些占位符';
        hint.style.display = 'block';
      } else {
        hint.style.display = 'none';
      }
    }
  }

  function kolReply(kolId) {
    var textarea = document.getElementById('kol-reply-content');
    var hidden = document.querySelector('input[name="reply_template_id"]');
    var content = textarea ? textarea.value : '';
    var tid = hidden ? hidden.value : '';
    if (!content.trim()) { alert('回复内容不能为空'); return; }
    kolPost('/admin/kols/' + kolId + '/reply_message', { content: content, template_id: tid }, function(data) {
      if (data.success) { kolRefresh(kolId); } else { alert(data.message || '发送失败'); }
    });
  }

  function kolQuickStatus(kolId, status) {
    kolPost('/admin/kols/' + kolId + '/quick_status', { status: status }, function(data) {
      if (data.success) { kolRefresh(kolId); } else { alert(data.message || '更新失败'); }
    });
  }

  function kolSaveNote(kolId) {
    var input = document.getElementById('kol-note-input');
    var note = input ? input.value : '';
    if (!note.trim()) { alert('请输入备注'); return; }
    kolPost('/admin/kols/' + kolId + '/quick_status', { note: note }, function(data) {
      if (data.success) { kolRefresh(kolId); } else { alert(data.message || '保存失败'); }
    });
  }

  function kolMarkAutoReply(kolId) {
    kolPost('/admin/kols/' + kolId + '/mark_auto_reply', {}, function(data) {
      if (data.success) { kolRefresh(kolId); } else { alert(data.message || '操作失败'); }
    });
  }
</script>
