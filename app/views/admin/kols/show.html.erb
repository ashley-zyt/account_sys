<% content_for :page_title do %>
  KOL 详情
<% end %>
<% content_for :page_subtitle do %>
  <%= @kol.name %> 的档案、名片夹与跨渠道对话流
<% end %>

<style>
  .kol-platform-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 10px; }
  .kol-platform-card { display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 14px; border: 1px solid rgba(148,163,184,0.25); border-radius: 8px; text-align: center; }
  .kol-platform-icon { font-size: 26px; }
  .kol-chat { display: flex; flex-direction: column; gap: 10px; max-height: 560px; overflow-y: auto; padding: 4px; }
  .kol-chat-row { display: flex; }
  .kol-chat-row.out { justify-content: flex-end; }
  .kol-chat-row.in { justify-content: flex-start; }
  .kol-bubble { max-width: 72%; padding: 10px 12px; border-radius: 12px; font-size: 13px; line-height: 1.55; }
  .kol-bubble.out { background: rgba(59,130,246,0.14); border: 1px solid rgba(59,130,246,0.32); color: #e2e8f0; }
  .kol-bubble.in { background: rgba(148,163,184,0.12); border: 1px solid rgba(148,163,184,0.26); color: #e2e8f0; }
  .kol-bubble-meta { display: flex; gap: 8px; align-items: center; font-size: 11px; color: #94a3b8; margin-bottom: 4px; flex-wrap: wrap; }
  .kol-bubble-content { white-space: pre-wrap; word-break: break-word; }
</style>

<% if @kol.variables_incomplete? %>
  <div style="display: flex; align-items: center; gap: 10px; padding: 12px 16px; background: rgba(251,146,60,0.12); border: 1px solid rgba(251,146,60,0.4); border-radius: 8px; margin-bottom: 16px; color: #fdba74;">
    <span style="font-size: 16px;">⚠️</span>
    <span style="font-size: 13px;">该 KOL 缺少模板所需变量，自动触达已暂停。请编辑并补全「需要填写的变量」后重新转为待联系。</span>
  </div>
<% end %>

<div class="admin-card">
  <div class="admin-card-header">
    <div>
      <div class="admin-card-title">
        <%= @kol.name %>
      </div>
      <div class="admin-card-subtitle" style="display: flex; gap: 6px; flex-wrap: wrap; align-items: center; margin-top: 6px;">
        <% if @kol.domain&.name %><span class="admin-pill-status" style="background: rgba(59,130,246,0.12); color: #60a5fa;"><%= @kol.domain.name %></span><% end %>
        <% if @kol.language&.name %><span class="admin-pill-status" style="background: rgba(148,163,184,0.12); color: #cbd5e1;"><%= @kol.language.name %></span><% end %>
        <span class="admin-label-muted"><%= @kol.owner %> 负责</span>
      </div>
    </div>
    <div class="admin-card-header-right">
      <%= render "status_badge", status: @kol.status %>
      <%= link_to "编辑", edit_admin_kol_path(@kol), class: "admin-button-secondary" %>
      <%= link_to "删除", admin_kol_path(@kol), data: { turbo_method: :delete, turbo_confirm: "确定要删除该 KOL 吗？" }, class: "admin-button-secondary" %>
    </div>
  </div>

  <div class="admin-two-column">
    <div>
      <div class="admin-field-label">名称</div>
      <div class="admin-field-value"><%= @kol.name %></div>
    </div>
    <div>
      <div class="admin-field-label">所属领域</div>
      <div class="admin-field-value"><%= @kol.domain&.name || "-" %></div>
    </div>
    <div>
      <div class="admin-field-label">粉丝量级</div>
      <div class="admin-field-value"><%= @kol.follower_tier_label || "-" %></div>
    </div>
    <div>
      <div class="admin-field-label">国家/地区</div>
      <div class="admin-field-value"><%= @kol.country.presence || "-" %></div>
    </div>
    <div>
      <div class="admin-field-label">使用语言</div>
      <div class="admin-field-value"><%= @kol.language&.name || "-" %></div>
    </div>
    <div>
      <div class="admin-field-label">归属人</div>
      <div class="admin-field-value"><%= @kol.owner %></div>
    </div>
    <div>
      <div class="admin-field-label">最近触达</div>
      <div class="admin-field-value"><%= @kol.last_contacted_at&.strftime("%Y-%m-%d %H:%M") || "暂无" %></div>
    </div>
    <div>
      <div class="admin-field-label">下次自动化动作</div>
      <div class="admin-field-value"><%= @kol.next_action_at&.strftime("%Y-%m-%d %H:%M") || "暂无" %></div>
    </div>
    <div style="grid-column: 1 / -1;">
      <div class="admin-field-label">备注</div>
      <div class="admin-field-value"><%= @kol.notes.presence || "无" %></div>
    </div>
  </div>
</div>

<div class="admin-card" style="margin-top: 16px;">
  <div class="admin-card-header">
    <div>
      <div class="admin-card-title">变量值</div>
      <div class="admin-card-subtitle">消息模板中 ${变量} 的实际取值</div>
    </div>
  </div>
  <% if @kol.kol_variables.any? %>
    <div class="admin-two-column">
      <% @kol.kol_variables.each do |kv| %>
        <div>
          <div class="admin-field-label"><%= kv.variable_key %></div>
          <div class="admin-field-value"><%= kv.value %></div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="admin-empty-state">暂无变量值。</div>
  <% end %>
</div>

<div class="admin-card" style="margin-top: 16px;">
  <div class="admin-card-header">
    <div>
      <div class="admin-card-title">多平台名片夹</div>
      <div class="admin-card-subtitle">点击跳转至 KOL 各平台主页，浏览最新内容调性</div>
    </div>
  </div>

  <% if @contacts.any? %>
    <div class="kol-platform-grid">
      <% @contacts.each do |c| %>
        <div class="kol-platform-card">
          <div class="kol-platform-icon"><%= c.platform_icon %></div>
          <div style="font-size: 13px; color: #cbd5e1;"><%= c.platform %></div>
          <div style="font-size: 12px; color: #94a3b8; word-break: break-all;"><%= c.nickname.presence || "-" %></div>
          <% if c.url.present? %>
            <%= link_to "打开主页", c.url, target: "_blank", class: "admin-link-quiet", style: "color: var(--accent); font-size: 12px;" %>
          <% else %>
            <span class="admin-label-muted" style="font-size: 12px;">无链接</span>
          <% end %>
          <% if c.messaging_enabled %>
            <span class="admin-pill-status" style="background: rgba(34,197,94,0.1); color: #22c55e; font-size: 11px;">触达渠道 P<%= c.priority %></span>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="admin-empty-state">暂无平台主页，请在编辑页录入。</div>
  <% end %>
</div>

<div class="admin-card" style="margin-top: 16px;">
  <div class="admin-card-header">
    <div>
      <div class="admin-card-title">联系方式与优先级</div>
      <div class="admin-card-subtitle">自动化将严格按优先级降级触达</div>
    </div>
  </div>

  <% if @contacts.any? %>
    <div class="admin-table-wrapper admin-table-scroll">
      <table class="admin-table">
        <thead>
          <tr>
            <th>优先级</th>
            <th>平台/渠道</th>
            <th>昵称/账号</th>
            <th>链接/联系方式</th>
            <th>可发私信</th>
            <th>状态</th>
          </tr>
        </thead>
        <tbody>
          <% @contacts.each do |c| %>
            <tr>
              <td><span class="admin-label-muted"><%= c.priority %></span></td>
              <td><%= c.platform_icon %> <span style="color: #cbd5e1;"><%= c.platform %></span></td>
              <td><span class="admin-label-muted"><%= c.nickname.presence || "-" %></span></td>
              <td>
                <% if c.url.present? %>
                  <%= link_to truncate(c.url, length: 40), c.url, target: "_blank", class: "admin-link-quiet", style: "color: var(--accent);", title: c.url %>
                <% else %>
                  <span class="admin-label-muted">-</span>
                <% end %>
              </td>
              <td>
                <% if c.messaging_enabled %>
                  <span class="admin-pill-status" style="background: rgba(34,197,94,0.1); color: #22c55e;">是</span>
                <% else %>
                  <span class="admin-label-muted">否</span>
                <% end %>
              </td>
              <td>
                <% if c.disabled? %>
                  <span class="admin-pill-status" style="background: rgba(239,68,68,0.1); color: #ef4444;">失效</span>
                <% else %>
                  <span class="admin-pill-status" style="background: rgba(34,197,94,0.1); color: #22c55e;">有效</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="admin-empty-state">暂无联系方式。</div>
  <% end %>
</div>

<div class="admin-card" style="margin-top: 16px;">
  <div class="admin-card-header">
    <div>
      <div class="admin-card-title">跨渠道对话流</div>
      <div class="admin-card-subtitle">系统消息与对方回复按时间轴交织展示</div>
    </div>
    <div class="admin-card-header-right">
      <% if @kol.replied_unprocessed? && @kol.latest_incoming_reply.present? %>
        <%= link_to "标记为自动回复", mark_auto_reply_admin_kol_path(@kol), data: { turbo_method: :post, turbo_confirm: "确认对方这条回复是系统自动回复吗？标记后将恢复等待倒计时。" }, class: "admin-button-secondary" %>
      <% end %>
    </div>
  </div>

  <% if @messages.any? %>
    <%= render "message_thread", messages: @messages %>
  <% else %>
    <div class="admin-empty-state">暂无对话记录。</div>
  <% end %>
</div>

<div class="admin-card" style="margin-top: 16px;">
  <div class="admin-card-header">
    <div>
      <div class="admin-card-title">操作</div>
      <div class="admin-card-subtitle">人工触发与状态流转</div>
    </div>
  </div>

  <div>
    <div class="admin-section-title">人工发送消息</div>
    <div class="admin-section-subtitle">负责人发送消息；可选择模板，模板含变量时会提醒填写</div>
    <%= form_with url: add_message_admin_kol_path(@kol), method: :post, class: "admin-form" do %>
      <div style="margin-bottom: 10px;">
        <div class="admin-field-label">联系渠道（可选）</div>
        <select name="kol_contact_id" class="admin-input">
          <option value="">当前渠道</option>
          <% @kol.active_contacts.each do |c| %>
            <option value="<%= c.id %>"><%= c.platform %> / <%= c.nickname.presence || c.url %></option>
          <% end %>
        </select>
      </div>
      <div style="margin-bottom: 10px;">
        <div class="admin-field-label">消息模板（可选）</div>
        <select name="template_id" id="kol-manual-template" class="admin-input" onchange="kolApplyManualTemplate()">
          <option value="">手动输入</option>
          <% @manual_templates.each do |t| %>
            <option value="<%= t[:id] %>"><%= t[:label] %></option>
          <% end %>
        </select>
      </div>
      <div id="kol-manual-var-hint" style="display: none; margin-bottom: 10px; font-size: 12px; color: #f59e0b;"></div>
      <div style="margin-bottom: 10px;">
        <div class="admin-field-label">消息内容</div>
        <textarea name="content" id="kol-manual-content" class="admin-input" rows="4" placeholder="输入要发送的内容..."></textarea>
      </div>
      <button type="submit" class="admin-button-primary">发送</button>
    <% end %>
  </div>

  <div style="margin-top: 16px; display: flex; flex-wrap: wrap; gap: 10px;">
    <% if @kol.reserved? %>
      <%= link_to "转为待联系", activate_admin_kol_path(@kol), data: { turbo_method: :post }, class: "admin-button-primary" %>
    <% elsif @kol.pending? %>
      <%= link_to "转为未开始", deactivate_admin_kol_path(@kol), data: { turbo_method: :post }, class: "admin-button-secondary" %>
    <% end %>
    <% if @kol.replied_unprocessed? %>
      <%= link_to "人工接管", take_over_admin_kol_path(@kol), data: { turbo_method: :post }, class: "admin-button-primary" %>
    <% end %>
    <%= link_to "标记已合作", mark_outcome_admin_kol_path(@kol, outcome: "cooperating"), data: { turbo_method: :post }, class: "admin-button-secondary" %>
    <%= link_to "标记已拒绝", mark_outcome_admin_kol_path(@kol, outcome: "failed"), data: { turbo_method: :post }, class: "admin-button-secondary" %>
  </div>
</div>

<script type="application/json" id="kol-manual-templates">
<%= raw @manual_templates.to_json %>
</script>

<script>
function kolApplyManualTemplate() {
  var select = document.getElementById('kol-manual-template');
  var tid = select ? select.value : '';
  var dataEl = document.getElementById('kol-manual-templates');
  var textarea = document.getElementById('kol-manual-content');
  var hint = document.getElementById('kol-manual-var-hint');
  if (!tid || !dataEl || !textarea) return;
  var templates = JSON.parse(dataEl.textContent);
  var found = templates.find(function(t) { return String(t.id) === String(tid); });
  if (!found) return;
  textarea.value = found.content;
  if (hint) {
    if (found.missing && found.missing.length) {
      hint.textContent = '该模板包含未填写的变量：' + found.missing.map(function(m){ return '${' + m + '}'; }).join('、') + '，请在内容中替换这些占位符';
      hint.style.display = 'block';
    } else {
      hint.style.display = 'none';
    }
  }
}
</script>
