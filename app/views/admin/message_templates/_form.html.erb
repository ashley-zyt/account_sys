<%= render "admin/shared/select_widgets" %>

<%= form_with model: [:admin, message_template], class: "admin-form" do |f| %>
  <% if message_template.errors.any? %>
    <div class="admin-empty-state" style="margin-bottom: 12px;">
      <ul class="admin-list">
        <% message_template.errors.full_messages.each do |msg| %>
          <li class="admin-list-item">
            <div class="admin-list-title"><%= msg %></div>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="admin-two-column">
    <div>
      <div class="admin-field-label">模板名称 <span style="color: #ef4444;">*</span></div>
      <%= f.text_field :name, class: "admin-input", required: true %>
    </div>
    <div>
      <div class="admin-field-label">场景 <span style="color: #ef4444;">*</span></div>
      <%= render "admin/shared/searchable_select",
            name: "message_template[scenario]",
            options: MessageTemplate::SCENARIOS.map { |k, v| [v, k] },
            selected: message_template.scenario,
            selected_label: message_template.scenario_label,
            placeholder: "选择场景",
            include_blank: "选择场景" %>
    </div>
    <div>
      <div class="admin-field-label">适用平台（空 = 通用）</div>
      <%= render "admin/shared/searchable_select",
            name: "message_template[platform]",
            options: MessageTemplate.platforms.keys.map { |k| [k, k] },
            selected: message_template.platform,
            selected_label: message_template.platform,
            placeholder: "通用",
            include_blank: "通用" %>
    </div>
    <div>
      <div class="admin-field-label">适用领域 <span style="color: #ef4444;">*</span></div>
      <%= render "admin/shared/combobox",
            name: "message_template[domain_name]",
            value: message_template.domain&.name,
            list_id: "template-domain-list",
            options: @domains.map(&:name),
            placeholder: "选择或输入领域（必填）",
            required: true %>
    </div>
  </div>

  <div class="admin-section-title" style="margin-top: 16px;">所需变量</div>
  <div class="admin-section-subtitle">模板正文里用到哪些变量就勾选哪些（发送时若 KOL 缺值会按场景阻断/跳过）</div>
  <div style="display: flex; flex-wrap: wrap; gap: 12px; padding: 8px 0;">
    <% @message_variables.each do |mv| %>
      <label style="display: flex; align-items: center; gap: 6px; color: #cbd5e1; font-size: 13px;">
        <input type="checkbox"
               name="message_variable_ids[]"
               value="<%= mv.id %>"
               <%= "checked" if message_template.message_variable_ids.include?(mv.id) %>>
        <%= mv.name %>（<%= mv.identifier %>）
      </label>
    <% end %>
  </div>

  <div class="admin-section-title" style="margin-top: 16px;">多语言版本</div>
  <div class="admin-section-subtitle">每个语言一条内容；发送时优先选与 KOL 语言一致的版本</div>

  <div id="template-versions">
    <%= f.fields_for :message_template_versions do |vf| %>
      <%= render "message_template_version_fields", f: vf %>
    <% end %>
  </div>

  <button type="button" id="add-template-version" class="admin-button-secondary" style="margin-bottom: 16px;">+ 添加语言版本</button>

  <template id="template-version-template">
    <%= f.fields_for :message_template_versions, MessageTemplateVersion.new, child_index: "NEW_RECORD" do |vf| %>
      <%= render "message_template_version_fields", f: vf %>
    <% end %>
  </template>

  <div style="margin-top: 16px;">
    <button type="submit" class="admin-button-primary">保存</button>
    <%= link_to "取消", admin_message_templates_path, class: "admin-button-secondary" %>
  </div>
<% end %>

<script>
  (function () {
    var container = document.getElementById('template-versions');
    var addBtn = document.getElementById('add-template-version');
    var template = document.getElementById('template-version-template');
    if (!container || !addBtn || !template) return;

    addBtn.addEventListener('click', function () {
      var idx = new Date().getTime();
      var html = template.innerHTML.replace(/NEW_RECORD/g, idx);
      container.insertAdjacentHTML('beforeend', html);
    });
  })();
</script>
