<% content_for :page_title do %>
  消息模板
<% end %>
<% content_for :page_subtitle do %>
  多语言消息模板库（首次建联 / 跟进询问）
<% end %>

<%= render "admin/shared/select_widgets" %>

<div class="admin-card">
  <div class="admin-card-header">
    <div>
      <div class="admin-card-title">消息模板列表</div>
      <div class="admin-card-subtitle">按场景 / 平台 / 领域 / 语言维护自动化触达话术</div>
    </div>
    <div class="admin-card-header-right">
      <span class="admin-tag">共 <%= @templates.total_count %> 条</span>
      <%= link_to "新建模板", new_admin_message_template_path, class: "admin-button-primary" %>
    </div>
  </div>

  <div class="admin-filter-form">
    <%= search_form_for [:admin, @q], class: "admin-filter-form" do |f| %>
      <div class="admin-filter-group">
        <label class="admin-filter-label">名称</label>
        <%= f.search_field :name_cont, class: "admin-input admin-filter-input", placeholder: "搜索模板名称..." %>
      </div>
      <div class="admin-filter-group">
        <label class="admin-filter-label">场景</label>
        <%= render "admin/shared/searchable_select",
              name: "q[scenario_eq]",
              options: MessageTemplate::SCENARIOS.map { |k, v| [v, k] },
              selected: params.dig(:q, :scenario_eq),
              selected_label: MessageTemplate::SCENARIOS[params.dig(:q, :scenario_eq)],
              placeholder: "所有场景",
              include_blank: "所有场景" %>
      </div>
      <div class="admin-filter-group">
        <label class="admin-filter-label">平台</label>
        <%= render "admin/shared/searchable_select",
              name: "q[platform_eq]",
              options: MessageTemplate.platforms.keys.map { |k| [k, k] },
              selected: params.dig(:q, :platform_eq),
              selected_label: params.dig(:q, :platform_eq),
              placeholder: "所有平台",
              include_blank: "所有平台" %>
      </div>
      <div class="admin-filter-group">
        <label class="admin-filter-label">领域</label>
        <%= render "admin/shared/searchable_select",
              name: "q[domain_id_eq]",
              options: @domains.map { |d| [d.name, d.id] },
              selected: params.dig(:q, :domain_id_eq),
              selected_label: @domains.find { |d| d.id.to_s == params.dig(:q, :domain_id_eq).to_s }&.name,
              placeholder: "所有领域",
              include_blank: "所有领域" %>
      </div>
      <div style="margin-left: auto;">
        <%= f.submit "筛选", class: "admin-button-primary" %>
        <%= link_to "重置", admin_message_templates_path, class: "admin-button-secondary" %>
      </div>
    <% end %>
  </div>

  <% if @templates.any? %>
    <div class="admin-table-wrapper admin-table-scroll">
      <table class="admin-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>名称</th>
            <th>场景</th>
            <th>平台</th>
            <th>领域</th>
            <th>所需变量</th>
            <th>语言版本</th>
            <th>操作</th>
          </tr>
        </thead>
        <tbody>
          <% @templates.each do |t| %>
            <tr>
              <td><%= t.id %></td>
              <td><span style="color: var(--text-primary);"><%= t.name %></span></td>
              <td>
                <span class="admin-pill-status" style="background: rgba(59, 130, 246, 0.1); color: #3b82f6;"><%= t.scenario_label %></span>
              </td>
              <td><span class="admin-label-muted"><%= t.platform || "通用" %></span></td>
              <td><span class="admin-label-muted"><%= t.domain&.name || "通用" %></span></td>
              <td><span class="admin-label-muted"><%= t.message_variables.pluck(:identifier).join("、").presence || "-" %></span></td>
              <td><span class="admin-label-muted"><%= t.message_template_versions.map { |v| v.language&.name }.compact.join(" / ").presence || "-" %></span></td>
              <td>
                <div style="display: flex; gap: 8px;">
                  <%= link_to "编辑", edit_admin_message_template_path(t), class: "admin-link-quiet", style: "color: var(--accent);" %>
                  <%= link_to "删除", admin_message_template_path(t), data: { turbo_method: :delete, turbo_confirm: "确定要删除该模板吗？" }, class: "admin-link-quiet", style: "color: var(--danger);" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <div class="admin-pagination">
      <%= paginate @templates %>
    </div>
  <% else %>
    <div class="admin-empty-state">暂无消息模板。</div>
  <% end %>
</div>
