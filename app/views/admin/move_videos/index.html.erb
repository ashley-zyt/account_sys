<% content_for :page_title do %>
  搬运视频储备
<% end %>
<% content_for :page_subtitle do %>
  源视频录入及下载/剪映处理进度
<% end %>

<%= render "admin/shared/select_widgets" %>

<div class="admin-card">
  <div class="admin-card-header">
    <div>
      <div class="admin-card-title">
        视频储备列表
      </div>
      <div class="admin-card-subtitle">
        监控下载转存与剪映处理流转
      </div>
    </div>
    <div class="admin-card-header-right">
      <span class="admin-tag">
        共 <%= @move_videos.total_count %> 条
      </span>
    </div>
  </div>

  <div class="admin-filter-form">
    <%= search_form_for [:admin, @q], class: "admin-filter-form" do |f| %>
      <div class="admin-filter-group">
        <label class="admin-filter-label">源视频URL</label>
        <%= f.search_field :source_video_url_cont, class: "admin-input admin-filter-input", placeholder: "搜索源视频链接..." %>
      </div>
      <div class="admin-filter-group">
        <label class="admin-filter-label">原视频标题</label>
        <%= f.search_field :source_title_cont, class: "admin-input admin-filter-input", placeholder: "搜索原视频标题..." %>
      </div>
      <div class="admin-filter-group">
        <label class="admin-filter-label">主题</label>
        <%= f.search_field :theme_cont, class: "admin-input admin-filter-input", placeholder: "搜索主题..." %>
      </div>
      <div class="admin-filter-group">
        <label class="admin-filter-label">下载状态</label>
        <%= f.searchable_select :status_eq, MoveVideo.statuses.map { |k, v| [MoveVideo.human_status(k), v] }, { include_blank: "所有状态" }, class: "admin-input admin-filter-input" %>
      </div>
      <div class="admin-filter-group">
        <label class="admin-filter-label">剪映状态</label>
        <%= f.searchable_select :jianying_status_eq, MoveVideo.jianying_statuses.map { |k, v| [MoveVideo::JIANYING_STATUS_LABELS[k.to_s], v] }, { include_blank: "所有状态" }, class: "admin-input admin-filter-input" %>
      </div>
      <div class="admin-filter-group">
        <label class="admin-filter-label">混剪状态</label>
        <%= f.searchable_select :hunjian_status_eq, MoveVideo.hunjian_statuses.map { |k, v| [MoveVideo::HUNJIAN_STATUS_LABELS[k.to_s], v] }, { include_blank: "所有状态" }, class: "admin-input admin-filter-input" %>
      </div>
      <div style="margin-left: auto;">
        <%= f.submit "筛选", class: "admin-button-primary" %>
        <%= link_to "重置", admin_move_videos_path, class: "admin-button-secondary" %>
      </div>
    <% end %>
  </div>

  <% if @move_videos.any? %>
    <div class="admin-table-wrapper" style="overflow-x: auto;">
      <table class="admin-table" style="table-layout: fixed; min-width: 850px;">
        <colgroup>
          <col style="width: 60px;">
          <col style="width: auto;">
          <col style="width: 100px;">
          <col style="width: 100px;">
          <col style="width: 110px;">
          <col style="width: 110px;">
          <col style="width: 120px;">
          <col style="width: 70px;">
        </colgroup>
        <thead>
          <tr>
            <th>ID</th>
            <th>源视频</th>
            <th>主题</th>
            <th>目标平台</th>
            <th>状态</th>
            <th>处理结果</th>
            <th>创建时间</th>
            <th>操作</th>
          </tr>
        </thead>
        <tbody>
          <% @move_videos.each do |video| %>
            <tr>
              <td>
                <span class="admin-label-muted"><%= video.id %></span>
              </td>
              <td style="white-space: normal; word-break: break-all;">
                <% if video.source_title.present? %>
                  <div style="font-weight: 600; margin-bottom: 2px;">
                    <%= link_to truncate(video.source_title, length: 60), admin_move_video_path(video), class: "admin-link-quiet", style: "color: var(--text);" %>
                  </div>
                <% end %>
                <%= link_to video.source_video_url, admin_move_video_path(video), class: "admin-link-quiet", style: "word-break: break-all;" %>
              </td>
              <td>
                <span class="admin-label-muted" style="display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="<%= video.theme %>"><%= video.theme %></span>
              </td>
              <td>
                <span class="admin-label-muted" style="display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="<%= video.platforms %>"><%= video.platforms %></span>
              </td>
              <td>
                <% case video.status %>
                <% when "pending_download", "downloading" %>
                  <span class="admin-pill-status admin-pill-status-pending">
                    <span class="admin-pill-status-dot"></span>
                    <%= video.human_status %>
                  </span>
                <% when "downloaded" %>
                  <span class="admin-pill-status admin-pill-status-success">
                    <span class="admin-pill-status-dot"></span>
                    <%= video.human_status %>
                  </span>
                <% when "failed" %>
                  <span class="admin-pill-status admin-pill-status-failed">
                    <span class="admin-pill-status-dot"></span>
                    <%= video.human_status %>
                  </span>
                <% end %>
              </td>
              <td>
                <div class="admin-label-muted">剪映：<%= link_to video.jianying_status_label, admin_move_videos_path(q: { jianying_status_eq: video[:jianying_status] }), class: "admin-link-quiet", style: "color: var(--accent);" %></div>
                <div class="admin-label-muted">混剪：<%= link_to video.hunjian_status_label, admin_move_videos_path(q: { hunjian_status_eq: video[:hunjian_status] }), class: "admin-link-quiet", style: "color: var(--accent);" %></div>
              </td>
              <td>
                <span class="admin-label-muted"><%= video.created_at&.strftime("%m-%d %H:%M") %></span>
              </td>
              <td>
                <%= link_to "详情", admin_move_video_path(video), class: "admin-link-quiet", style: "color: var(--accent);" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <div class="admin-pagination">
      <%= paginate @move_videos %>
    </div>
  <% else %>
    <div class="admin-empty-state">
      暂无视频储备数据。
    </div>
  <% end %>
</div>
