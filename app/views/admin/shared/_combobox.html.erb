<%# 可搜索 + 可自由创建的组合框（点开后搜索已有值，无匹配时可「＋ 添加」新值）
    locals: name, value(当前值), options [String], placeholder, required %>
<div class="custom-select-container">
  <div class="custom-select" data-placeholder="<%= placeholder %>">
    <div class="custom-select-trigger">
      <input type="text"
             name="<%= name %>"
             class="custom-select-input"
             value="<%= value %>"
             placeholder="<%= placeholder %>"
             autocomplete="off"
             oninput="filterCreatableSelect(this)"
             onfocus="openCreatableSelect(this)"
             <%= 'required' if local_assigns[:required] %>>
      <span class="custom-select-arrow">▼</span>
    </div>
    <div class="custom-select-options" style="display: none;">
      <div class="custom-select-options-list">
        <% options.each do |opt| %>
          <div class="custom-select-option" data-value="<%= opt %>" onclick="selectCreatableOption(this)"><%= opt %></div>
        <% end %>
      </div>
      <div class="custom-select-add" style="display: none;" onclick="confirmCreatableAdd(this)">＋ 添加「<span class="custom-select-add-text"></span>」</div>
    </div>
  </div>
</div>
