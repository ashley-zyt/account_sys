<%# 主题可搜索下拉（单选）。依赖 _select_widgets 提供的样式与 JS。
    locals: name, themes [String], selected, placeholder, include_blank, required %>
<div class="custom-select-container">
  <div class="custom-select" data-placeholder="<%= placeholder %>">
    <div class="custom-select-trigger" onclick="toggleCustomSelect(this)">
      <span class="custom-select-value">
        <%= selected.present? ? selected : placeholder %>
      </span>
      <span class="custom-select-arrow">▼</span>
    </div>
    <div class="custom-select-options" style="display: none;">
      <input type="text" class="custom-select-search" oninput="filterCustomSelect(this)" placeholder="搜索主题...">
      <div class="custom-select-options-list">
        <% if include_blank %>
          <div class="custom-select-option" data-value="" onclick="selectCustomOption(this)">
            <%= include_blank %>
          </div>
        <% end %>
        <% themes.each do |theme| %>
          <div class="custom-select-option" data-value="<%= theme %>" onclick="selectCustomOption(this)">
            <%= theme %>
          </div>
        <% end %>
      </div>
    </div>
    <input type="hidden" name="<%= name %>" value="<%= selected %>" class="custom-select-hidden-input" <%= 'required' if local_assigns[:required] %>>
  </div>
</div>
