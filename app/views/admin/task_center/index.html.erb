<% content_for :page_title do %>
  异步任务
<% end %>
<% content_for :page_subtitle do %>
  实时查看各运营机器任务的执行进度与堆积，统一管理下发中的异步任务
<% end %>

<% statuses = MachineTaskMonitor::STATUSES %>
<% if @auto %>
  <script>
    setTimeout(function () { window.location.reload(); }, 30000);
  </script>
<% end %>

<%# ============ 全局概览 ============ %>
<%
  ok_results = @results.select(&:ok)
  g = Hash.new(0)
  ok_results.each { |r| (r.data['status_counts'] || {}).each { |k, v| g[k] += v.to_i } }
  overview = [
    { label: '机器',        value: @results.size,            color: '#8b5cf6' },
    { label: '排队中',      value: g['queued'],              color: '#f59e0b' },
    { label: '执行中',      value: g['running'],             color: '#3b82f6' },
    { label: '成功',        value: g['success'],             color: '#22c55e' },
    { label: '失败',        value: g['failed'],              color: '#ef4444' },
    { label: '已中断',      value: g['interrupted'],         color: '#94a3b8' }
  ]
%>

<div class="admin-card">
  <div class="admin-card-header">
    <div>
      <div class="admin-card-title">全局概览</div>
      <div class="admin-card-subtitle">
        采集于 <%= @fetched_at.strftime('%H:%M:%S') %> ·
        只统计 account_sys 下发的任务（按 ref 前缀过滤）·
        数据来自机器端，实时读取
      </div>
    </div>
    <div class="admin-card-header-right">
      <%= link_to "刷新", admin_task_center_index_path, class: "admin-button-secondary" %>
      <%= link_to(@auto ? "关闭自动刷新" : "开启自动刷新",
                  admin_task_center_index_path(auto: @auto ? nil : 1),
                  class: "admin-button-secondary") %>
    </div>
  </div>

  <div style="display: flex; gap: 12px; flex-wrap: wrap; padding: 16px;">
    <% overview.each do |o| %>
      <div style="flex: 1; min-width: 110px; background: rgba(30, 41, 59, 0.6); border: 1px solid #334155; border-radius: 8px; padding: 16px 12px; text-align: center;">
        <div style="font-size: 26px; font-weight: 600; line-height: 1; color: <%= o[:color] %>;"><%= o[:value] %></div>
        <div style="color: #94a3b8; font-size: 12px; margin-top: 8px;"><%= o[:label] %></div>
      </div>
    <% end %>
  </div>
</div>

<%# ============ 管理操作 ============ %>
<div class="admin-card" style="margin-top: 16px;">
  <div class="admin-card-header">
    <div>
      <div class="admin-card-title">管理操作</div>
      <div class="admin-card-subtitle">同步状态 / 重跑丢失任务 / 按机器清除任务</div>
    </div>
    <div class="admin-card-header-right">
      <%= link_to "同步状态", sync_admin_task_center_index_path, data: { turbo_method: :post, turbo_confirm: "将主动查机器端真实状态并补结果/重置超时任务，确认？" }, class: "admin-button-secondary" %>
      <%= link_to "重跑丢失任务", retry_interrupted_admin_task_center_index_path, data: { turbo_method: :post, turbo_confirm: "将把「机器端丢失/超时被重置」的发布任务立即重新分配并下发，不等平台固定时间窗口。\n\n只会补发受影响账号，且今天已发布成功的不会重复发。确认执行？" }, class: "admin-button-secondary" %>
    </div>
  </div>

  <%# 清除任务：破坏性操作，独立成危险区 %>
  <div style="padding: 0 16px 16px;">
    <div style="border: 1px solid rgba(239, 68, 68, 0.35); border-radius: 8px; padding: 12px 16px; background: rgba(239, 68, 68, 0.05);">
      <div style="color: #fca5a5; font-size: 13px; margin-bottom: 10px;">
        ⚠️ 清除任务（破坏性）：会中断执行中/排队中的任务，被清除任务不再回调
      </div>
      <%= form_with url: clear_admin_task_center_index_path, method: :post, data: { turbo_confirm: "确定清除所选机器上指定类型/状态的任务？这会中断执行中/排队中的任务，且被清除任务不再回调。\n\n类型和状态都未选则会全量清空，请谨慎。" } do |f| %>
        <div style="display: flex; gap: 16px; flex-wrap: wrap; align-items: flex-end;">
          <div class="admin-filter-group">
            <label class="admin-filter-label">机器（必选）</label>
            <%= f.select :machine_ip,
                         options_for_select(@machines.map { |m| [m, m] }),
                         { include_blank: "选择机器..." },
                         { class: "admin-input admin-filter-input", required: true } %>
          </div>
          <div class="admin-filter-group">
            <label class="admin-filter-label">任务类型（可多选）</label>
            <%= f.select :type,
                         options_for_select(@task_types.map { |k, v| [v, k] }),
                         {},
                         { class: "admin-input admin-filter-input", multiple: true, size: 5 } %>
          </div>
          <div class="admin-filter-group">
            <label class="admin-filter-label">状态（可多选）</label>
            <%= f.select :status,
                         options_for_select(MachineTaskMonitor::STATUS_LABELS.map { |k, v| [v, k] }),
                         {},
                         { class: "admin-input admin-filter-input", multiple: true, size: 5 } %>
          </div>
          <div>
            <%= f.submit "清除任务", class: "admin-button-danger" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<%# ============ 机器端实时进度 ============ %>
<div style="margin-top: 20px; color: #e2e8f0; font-size: 15px; font-weight: 600;">各机器实时进度</div>

<% if @results.empty? %>
  <div class="admin-card" style="margin-top: 10px;">
    <div style="padding: 20px 16px;">没有配置 machine_ip 的浏览器，无需监控。</div>
  </div>
<% end %>

<% @results.each do |result| %>
  <% data   = result.ok ? (result.data || {}) : {} %>
  <% table  = result.ok ? MachineTaskMonitor.rows(data) : { types: [], backlog: [] } %>
  <% sc     = data['status_counts'] || {} %>
  <% queued = sc['queued'].to_i %>
  <% running = sc['running'].to_i %>
  <% oldest = data['oldest_queued_seconds'].to_i %>

  <div class="admin-card" style="margin-top: 12px;">
    <div class="admin-card-header">
      <div>
        <div class="admin-card-title">
          <%= result.machine_ip %>
          <% if result.ok %>
            <% if queued >= 20 %>
              <span class="admin-tag" style="background:#fee2e2;color:#b91c1c;">堆积 <%= queued %></span>
            <% elsif queued.positive? %>
              <span class="admin-tag" style="background:#fef3c7;color:#b45309;">排队 <%= queued %></span>
            <% else %>
              <span class="admin-tag" style="background:#dcfce7;color:#15803d;">空闲</span>
            <% end %>
          <% else %>
            <span class="admin-tag" style="background:#fee2e2;color:#b91c1c;">不可达</span>
          <% end %>
        </div>
        <div class="admin-card-subtitle">
          <% if result.ok %>
            排队 <%= queued %> · 执行中 <%= running %> ·
            成功 <%= sc['success'].to_i %> · 失败 <%= sc['failed'].to_i %> ·
            中断 <%= sc['interrupted'].to_i %>
            <% if oldest.positive? %>
              · 最久排队 <%= (oldest / 60.0).round(1) %> 分钟
            <% end %>
          <% else %>
            查询失败：<%= result.error %>
          <% end %>
        </div>
      </div>
    </div>

    <% if result.ok %>
      <% if table[:types].any? %>
        <div class="admin-table-wrapper admin-table-scroll">
          <table class="admin-table">
            <thead>
              <tr>
                <th>任务类型</th>
                <% statuses.each do |st| %>
                  <th><%= MachineTaskMonitor::STATUS_LABELS[st] %></th>
                <% end %>
                <th>小计</th>
              </tr>
            </thead>
            <tbody>
              <% table[:types].each do |row| %>
                <tr>
                  <td><%= row[:label] %></td>
                  <td style="color: #f59e0b; font-weight: 600;"><%= row[:queued] %></td>
                  <td style="color: #3b82f6; font-weight: 600;"><%= row[:running] %></td>
                  <td style="color: #22c55e;"><%= row[:success] %></td>
                  <td style="color: #ef4444;"><%= row[:failed] %></td>
                  <td style="color: #94a3b8;"><%= row[:interrupted] %></td>
                  <td><%= row[:total] %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div style="padding: 16px;">暂无任务记录（机器端可能刚重启过）。</div>
      <% end %>

      <% if table[:backlog].any? %>
        <div style="padding: 0 16px 16px;">
          <div class="admin-card-subtitle" style="margin: 8px 0;">堆积落点（按排队数倒序，最多 20 个浏览器）</div>
          <table class="admin-table">
            <thead>
              <tr>
                <th>指纹浏览器</th><th>排队</th><th>执行中</th><th>成功</th><th>失败</th><th>小计</th>
              </tr>
            </thead>
            <tbody>
              <% table[:backlog].first(20).each do |p| %>
                <tr>
                  <td><%= p['profile_name'] %></td>
                  <td style="color: #f59e0b; font-weight: 600;"><%= p['queued'].to_i %></td>
                  <td style="color: #3b82f6;"><%= p['running'].to_i %></td>
                  <td style="color: #22c55e;"><%= p['success'].to_i %></td>
                  <td style="color: #ef4444;"><%= p['failed'].to_i %></td>
                  <td><%= p['total'].to_i %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    <% end %>
  </div>
<% end %>

<%# ============ 本地登记明细 ============ %>
<div style="margin-top: 20px; color: #e2e8f0; font-size: 15px; font-weight: 600;">本地登记明细</div>

<div class="admin-card" style="margin-top: 10px;">
  <div class="admin-card-header">
    <div>
      <div class="admin-card-subtitle">
        下发到机器端的异步任务登记（pending=执行中/排队中，success/failed=机器端已回调结果）
      </div>
    </div>
    <span class="admin-tag">共 <%= @records.total_count %> 条</span>
  </div>

  <div class="admin-filter-form">
    <%= search_form_for [:admin, @q], url: admin_task_center_index_path, class: "admin-filter-form" do |f| %>
      <div class="admin-filter-group">
        <label class="admin-filter-label">状态</label>
        <%= f.searchable_select :status_eq, BrowserTaskRecord::STATUS_LABELS.map { |k, v| [v, k] }, { include_blank: "所有状态" }, class: "admin-input admin-filter-input" %>
      </div>
      <div class="admin-filter-group">
        <label class="admin-filter-label">任务类型</label>
        <%= f.searchable_select :task_type_eq, BrowserTaskRecord::TASK_TYPE_LABELS.map { |k, v| [v, k] }, { include_blank: "所有类型" }, class: "admin-input admin-filter-input" %>
      </div>
      <div class="admin-filter-group">
        <label class="admin-filter-label">浏览器</label>
        <%= f.search_field :profile_name_cont, class: "admin-input admin-filter-input", placeholder: "指纹浏览器名..." %>
      </div>
      <div class="admin-filter-group">
        <label class="admin-filter-label">机器</label>
        <%= f.search_field :machine_ip_cont, class: "admin-input admin-filter-input", placeholder: "IP/域名..." %>
      </div>
      <div class="admin-filter-group">
        <label class="admin-filter-label">任务ID</label>
        <%= f.search_field :machine_task_id_cont, class: "admin-input admin-filter-input", placeholder: "机器端 task_id..." %>
      </div>
      <div style="margin-left: auto;">
        <%= f.submit "筛选", class: "admin-button-primary" %>
        <%= link_to "重置", admin_task_center_index_path, class: "admin-button-secondary" %>
      </div>
    <% end %>
  </div>

  <% if @records.any? %>
    <div class="admin-table-wrapper admin-table-scroll">
      <table class="admin-table">
        <thead>
          <tr>
            <th>机器端任务ID</th>
            <th>业务标识(ref)</th>
            <th>任务类型</th>
            <th>浏览器</th>
            <th>机器</th>
            <th>状态</th>
            <th>消息</th>
            <th>提交时间</th>
          </tr>
        </thead>
        <tbody>
          <% @records.each do |r| %>
            <tr>
              <td>
                <span class="admin-label-muted" title="<%= r.machine_task_id %>">
                  <%= truncate(r.machine_task_id.to_s, length: 18) %>
                </span>
              </td>
              <td>
                <span class="admin-label-muted"><%= r.ref %></span>
              </td>
              <td>
                <span class="admin-pill-status" style="background: rgba(99, 102, 241, 0.12); color: #818cf8;">
                  <%= r.task_type_label %>
                </span>
              </td>
              <td>
                <span class="admin-label-muted"><%= r.profile_name.presence || "-" %></span>
              </td>
              <td>
                <span class="admin-label-muted"><%= r.machine_ip.presence || "-" %></span>
              </td>
              <td>
                <% case r.status
                   when 'success' %>
                  <span class="admin-pill-status admin-pill-status-success">
                    <span class="admin-pill-status-dot"></span>成功
                  </span>
                <% when 'failed' %>
                  <span class="admin-pill-status admin-pill-status-failed">
                    <span class="admin-pill-status-dot"></span>失败
                  </span>
                <% when 'unknown' %>
                  <span class="admin-pill-status" style="background: rgba(148, 163, 184, 0.15); color: #94a3b8;">
                    <span class="admin-pill-status-dot"></span>已丢失
                  </span>
                <% else %>
                  <span class="admin-pill-status" style="background: rgba(245, 158, 11, 0.15); color: #f59e0b;">
                    <span class="admin-pill-status-dot"></span>执行中
                  </span>
                <% end %>
              </td>
              <td>
                <span class="admin-label-muted" title="<%= r.message %>">
                  <%= truncate(r.message.to_s, length: 40) %>
                </span>
              </td>
              <td>
                <span class="admin-label-muted"><%= r.created_at&.strftime("%m-%d %H:%M") %></span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <div class="admin-pagination">
      <%= paginate @records %>
    </div>
  <% else %>
    <div class="admin-empty-state">暂无异步任务记录。</div>
  <% end %>
</div>
