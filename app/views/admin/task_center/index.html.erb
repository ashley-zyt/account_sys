<% content_for :page_title do %>
  异步任务
<% end %>
<% content_for :page_subtitle do %>
  实时查看各运营机器任务的执行进度与堆积，统一管理下发中的异步任务
<% end %>

<%= render "admin/shared/select_widgets" %>

<%
  statuses      = MachineTaskMonitor::STATUSES
  status_labels = MachineTaskMonitor::STATUS_LABELS
  task_types    = MachineTaskMonitor::TYPE_LABELS

  ok_results = @results.select(&:ok)
  g   = Hash.new(0)
  src = Hash.new(0)
  ok_results.each do |r|
    (r.data['status_counts'] || {}).each { |k, v| g[k]   += v.to_i }
    (r.data['source_counts'] || {}).each { |k, v| src[k] += v.to_i }
  end

  stats = [
    { label: '机器',   value: @results.size,    tx: 'admin-tx-accent' },
    { label: '排队中', value: g['queued'],      tx: 'admin-tx-queued' },
    { label: '执行中', value: g['running'],     tx: 'admin-tx-running' },
    { label: '成功',   value: g['success'],     tx: 'admin-tx-success' },
    { label: '失败',   value: g['failed'],      tx: 'admin-tx-failed' },
    { label: '已中断', value: g['interrupted'], tx: 'admin-tx-interrupted' },
    { label: '已暂停', value: g['paused'],      tx: 'admin-tx-paused' }
  ]
%>

<% if @auto %>
  <script>
    setTimeout(function () { window.location.reload(); }, 30000);
  </script>
<% end %>

<%# ============ 1. 全局概览 ============ %>
<div class="admin-card">
  <div class="admin-card-header">
    <div>
      <div class="admin-card-title">全局概览</div>
      <div class="admin-card-subtitle">
        采集于 <%= @fetched_at.strftime('%H:%M:%S') %> ·
        机器端全部任务（含 account_sys 下发 + 人工/外部调用）· 实时读取
        <% if ok_results.size < @results.size %>
          · <span class="admin-tx-failed"><%= @results.size - ok_results.size %> 台机器不可达</span>
        <% end %>
      </div>
    </div>
    <div class="admin-card-header-right">
      <%= link_to "刷新", admin_task_center_index_path, class: "admin-button-secondary" %>
      <%= link_to(@auto ? "关闭自动刷新" : "开启自动刷新",
                  admin_task_center_index_path(auto: @auto ? nil : 1),
                  class: "admin-button-secondary") %>
      <%= link_to "同步状态", sync_admin_task_center_index_path,
                  data: { turbo_method: :post, turbo_confirm: "将主动查机器端真实状态并补结果/重置超时任务，确认？" },
                  class: "admin-button-secondary" %>
      <%= link_to "重跑丢失任务", retry_interrupted_admin_task_center_index_path,
                  data: { turbo_method: :post, turbo_confirm: "将把「机器端丢失/超时被重置」的发布任务立即重新分配并下发，不等平台固定时间窗口。\n\n只会补发受影响账号，且今天已发布成功的不会重复发。确认执行？" },
                  class: "admin-button-secondary" %>
    </div>
  </div>

  <div class="admin-stat-grid">
    <% stats.each do |s| %>
      <div class="admin-stat">
        <div class="admin-stat-value <%= s[:tx] %>"><%= s[:value] %></div>
        <div class="admin-stat-label"><%= s[:label] %></div>
      </div>
    <% end %>
  </div>

  <div class="admin-chip-row">
    <span class="admin-label-muted">来源：</span>
    <span class="admin-chip">
      <%= MachineTaskMonitor::SOURCE_LABELS['account_sys'] %> <%= src['account_sys'] %>
    </span>
    <span class="admin-chip">
      <%= MachineTaskMonitor::SOURCE_LABELS['manual'] %> <%= src['manual'] %>
    </span>
  </div>
</div>

<%# ============ 2. 各机器实时进度（两列卡片，点击展开） ============ %>
<div class="admin-card tc-section">
  <div class="admin-card-header">
    <div>
      <div class="admin-card-title">各机器实时进度</div>
      <div class="admin-card-subtitle">
        点击卡片展开「类型小计 / 堆积落点 / 批次进度」，卡片底部可进入该机器的任务明细
      </div>
    </div>
  </div>

  <% if @results.empty? %>
    <div class="admin-empty-state">没有配置 machine_ip 的浏览器，无需监控。</div>
  <% else %>
    <div class="tc-machine-grid">
      <% @results.each do |result| %>
        <% data  = result.ok ? (result.data || {}) : {} %>
        <% table = result.ok ? MachineTaskMonitor.rows(data)
                             : { types: [], backlog: [], batches: [], batch_total: 0, unbatched: 0 } %>
        <% sc     = data['status_counts'] || {} %>
        <% msrc   = data['source_counts'] || {} %>
        <% queued  = sc['queued'].to_i %>
        <% running = sc['running'].to_i %>
        <% oldest  = data['oldest_queued_seconds'].to_i %>

        <details class="tc-machine">
          <summary>
            <div class="tc-machine-head">
              <span class="tc-machine-name">
                <span class="tc-machine-arrow">▸</span>
                <%= result.machine_ip %>
              </span>
              <% if result.ok %>
                <% if queued >= 20 %>
                  <span class="admin-pill-status admin-pill--failed">
                    <span class="admin-pill-status-dot"></span>堆积 <%= queued %>
                  </span>
                <% elsif queued.positive? %>
                  <span class="admin-pill-status admin-pill--queued">
                    <span class="admin-pill-status-dot"></span>排队 <%= queued %>
                  </span>
                <% else %>
                  <span class="admin-pill-status admin-pill--success">
                    <span class="admin-pill-status-dot"></span>空闲
                  </span>
                <% end %>
              <% else %>
                <span class="admin-pill-status admin-pill--failed">
                  <span class="admin-pill-status-dot"></span>不可达
                </span>
              <% end %>
            </div>

            <div class="tc-kv-row">
              <% if result.ok %>
                <span class="tc-kv">排队<b class="admin-tx-queued"><%= queued %></b></span>
                <span class="tc-kv">执行中<b class="admin-tx-running"><%= running %></b></span>
                <span class="tc-kv">成功<b class="admin-tx-success"><%= sc['success'].to_i %></b></span>
                <span class="tc-kv">失败<b class="admin-tx-failed"><%= sc['failed'].to_i %></b></span>
                <span class="tc-kv">中断<b class="admin-tx-interrupted"><%= sc['interrupted'].to_i %></b></span>
                <span class="tc-kv">暂停<b class="admin-tx-paused"><%= sc['paused'].to_i %></b></span>
                <span class="tc-kv">account_sys<b><%= msrc['account_sys'].to_i %></b></span>
                <span class="tc-kv">人工/外部<b><%= msrc['manual'].to_i %></b></span>
                <% if oldest.positive? %>
                  <span class="tc-kv">最久排队<b class="admin-tx-queued"><%= (oldest / 60.0).round(1) %> 分钟</b></span>
                <% end %>
              <% else %>
                <span class="tc-kv admin-tx-failed">查询失败：<%= result.error %></span>
              <% end %>
            </div>
          </summary>

          <div class="tc-machine-body">
            <% if result.ok %>
              <% if table[:types].any? %>
                <div class="tc-subtable-title">任务类型 × 状态</div>
                <div class="admin-table-wrapper tc-scroll">
                  <table class="admin-table">
                    <thead>
                      <tr>
                        <th>任务类型</th>
                        <% statuses.each do |st| %>
                          <th class="tc-right"><%= status_labels[st] %></th>
                        <% end %>
                        <th class="tc-right">小计</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% table[:types].each do |row| %>
                        <tr>
                          <td><%= row[:label] %></td>
                          <% statuses.each do |st| %>
                            <td class="tc-right tc-num admin-tx-<%= st %>"><%= row[st.to_sym].to_i %></td>
                          <% end %>
                          <td class="tc-right tc-num"><%= row[:total] %></td>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                </div>
              <% else %>
                <div class="admin-empty-state">暂无任务记录（机器端可能刚重启过）。</div>
              <% end %>

              <% if table[:backlog].any? %>
                <div class="tc-subtable-title">堆积落点（按排队数倒序，最多 20 个浏览器）</div>
                <div class="admin-table-wrapper tc-scroll">
                  <table class="admin-table">
                    <thead>
                      <tr>
                        <th>指纹浏览器</th>
                        <th class="tc-right">排队</th>
                        <th class="tc-right">执行中</th>
                        <th class="tc-right">成功</th>
                        <th class="tc-right">失败</th>
                        <th class="tc-right">中断</th>
                        <th class="tc-right">暂停</th>
                        <th class="tc-right">小计</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% table[:backlog].first(20).each do |p| %>
                        <tr>
                          <td><%= p['profile_name'] %></td>
                          <td class="tc-right tc-num admin-tx-queued"><%= p['queued'].to_i %></td>
                          <td class="tc-right tc-num admin-tx-running"><%= p['running'].to_i %></td>
                          <td class="tc-right tc-num admin-tx-success"><%= p['success'].to_i %></td>
                          <td class="tc-right tc-num admin-tx-failed"><%= p['failed'].to_i %></td>
                          <td class="tc-right tc-num admin-tx-interrupted"><%= p['interrupted'].to_i %></td>
                          <td class="tc-right tc-num admin-tx-paused"><%= p['paused'].to_i %></td>
                          <td class="tc-right tc-num"><%= p['total'].to_i %></td>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                </div>
              <% end %>

              <% if table[:batches].any? %>
                <div class="tc-subtable-title">
                  批次进度（按首次提交时间倒序，最多 50 个批次 ·
                  共 <%= table[:batch_total] %> 个批次 · 未分批 <%= table[:unbatched] %> 条）
                </div>
                <div class="admin-table-wrapper tc-scroll">
                  <table class="admin-table">
                    <thead>
                      <tr>
                        <th>批次</th>
                        <th class="tc-right">排队</th>
                        <th class="tc-right">执行中</th>
                        <th class="tc-right">成功</th>
                        <th class="tc-right">失败</th>
                        <th class="tc-right">中断</th>
                        <th class="tc-right">暂停</th>
                        <th class="tc-right">合计</th>
                        <th class="tc-right">待执行</th>
                        <th>状态</th>
                        <th class="tc-right">耗时</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% table[:batches].each do |b| %>
                        <tr>
                          <td><span class="admin-label-muted"><%= b[:batch] %></span></td>
                          <td class="tc-right tc-num admin-tx-queued"><%= b[:queued] %></td>
                          <td class="tc-right tc-num admin-tx-running"><%= b[:running] %></td>
                          <td class="tc-right tc-num admin-tx-success"><%= b[:success] %></td>
                          <td class="tc-right tc-num admin-tx-failed"><%= b[:failed] %></td>
                          <td class="tc-right tc-num admin-tx-interrupted"><%= b[:interrupted] %></td>
                          <td class="tc-right tc-num admin-tx-paused"><%= b[:paused] %></td>
                          <td class="tc-right tc-num"><%= b[:total] %></td>
                          <td class="tc-right tc-num admin-tx-muted"><%= b[:pending] %></td>
                          <td>
                            <% if b[:done] %>
                              <% if b[:failed].zero? && b[:interrupted].zero? %>
                                <span class="admin-pill-status admin-pill--success">
                                  <span class="admin-pill-status-dot"></span>完成
                                </span>
                              <% else %>
                                <span class="admin-pill-status admin-pill--queued" title="done=true 只表示没有待执行任务，仍可能含失败/中断">
                                  <span class="admin-pill-status-dot"></span>跑完但有失败
                                </span>
                              <% end %>
                            <% else %>
                              <span class="admin-pill-status admin-pill--running">
                                <span class="admin-pill-status-dot"></span>运行中
                              </span>
                            <% end %>
                          </td>
                          <td class="tc-right">
                            <span class="admin-label-muted"><%= (b[:duration_seconds] / 60.0).round(1) %> 分钟</span>
                          </td>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                </div>
              <% end %>
            <% else %>
              <div class="admin-callout admin-callout-danger">
                <div class="admin-callout-title">该机器查询失败</div>
                <%= result.error %>
              </div>
            <% end %>

            <div class="tc-machine-actions">
              <%= link_to "查看任务明细 →",
                          machines_admin_task_center_index_path(machine_ip: result.machine_ip),
                          class: "admin-button-secondary" %>
              <span class="admin-label-muted">机器端任务列表，可按状态/类型/批次筛选、看单条详情</span>
            </div>
          </div>
        </details>
      <% end %>
    </div>
  <% end %>
</div>

<%# ============ 3. 本地登记明细 ============ %>
<div class="admin-card tc-section">
  <div class="admin-card-header">
    <div>
      <div class="admin-card-title">本地登记明细</div>
      <div class="admin-card-subtitle">
        下发到机器端的异步任务登记（pending=执行中/排队中，success/failed=机器端已回调结果）· 只有「失败」可勾选重新启动
      </div>
    </div>
    <div class="admin-card-header-right">
      <span class="admin-tag">共 <%= @records.total_count %> 条</span>
      <button type="button" class="admin-button-primary" onclick="submitRetrySelected()">重新启动选中</button>
    </div>
  </div>

  <%= search_form_for [:admin, @q], url: admin_task_center_index_path, class: "admin-filter-form" do |f| %>
    <div class="admin-filter-group">
      <label class="admin-filter-label">状态</label>
      <%= f.searchable_select :status_eq, BrowserTaskRecord::STATUS_LABELS.map { |k, v| [v, k] }, { include_blank: "所有状态" }, class: "admin-input admin-filter-input" %>
    </div>
    <div class="admin-filter-group">
      <label class="admin-filter-label">任务类型</label>
      <%= f.searchable_select :task_type_eq, BrowserTaskRecord::TASK_TYPE_LABELS.map { |k, v| [v, k] }, { include_blank: "所有类型" }, class: "admin-input admin-filter-input" %>
    </div>
    <div class="admin-filter-group">
      <label class="admin-filter-label">浏览器</label>
      <%= f.search_field :profile_name_cont, class: "admin-input admin-filter-input", placeholder: "指纹浏览器名..." %>
    </div>
    <div class="admin-filter-group">
      <label class="admin-filter-label">机器</label>
      <%= f.search_field :machine_ip_cont, class: "admin-input admin-filter-input", placeholder: "IP/域名..." %>
    </div>
    <div class="admin-filter-group">
      <label class="admin-filter-label">任务ID</label>
      <%= f.search_field :machine_task_id_cont, class: "admin-input admin-filter-input", placeholder: "机器端 task_id..." %>
    </div>
    <div class="admin-filter-group">
      <label class="admin-filter-label">错误信息</label>
      <%= f.search_field :message_cont, class: "admin-input admin-filter-input", placeholder: "按错误信息内容搜索..." %>
    </div>
    <div class="admin-filter-actions">
      <%= f.submit "筛选", class: "admin-button-primary" %>
      <%= link_to "重置", admin_task_center_index_path, class: "admin-button-secondary" %>
    </div>
  <% end %>

  <% if @records.any? %>
    <div class="admin-table-wrapper tc-scroll">
      <table class="admin-table">
        <thead>
          <tr>
            <th class="admin-col-check">
              <input type="checkbox" id="retry-check-all" onclick="toggleAllRetry()" title="全选失败任务">
            </th>
            <th>机器端任务ID</th>
            <th>业务标识(ref)</th>
            <th>任务类型</th>
            <th>浏览器</th>
            <th>机器</th>
            <th>状态</th>
            <th>消息</th>
            <th>提交时间</th>
          </tr>
        </thead>
        <tbody>
          <% @records.each do |r| %>
            <tr>
              <td>
                <% if r.status == 'failed' %>
                  <input type="checkbox" class="retry-check" value="<%= r.id %>" title="重新启动该失败任务">
                <% end %>
              </td>
              <td>
                <span class="admin-label-muted" title="<%= r.machine_task_id %>">
                  <%= truncate(r.machine_task_id.to_s, length: 18) %>
                </span>
              </td>
              <td><span class="admin-label-muted"><%= r.ref %></span></td>
              <td>
                <span class="admin-pill-status admin-pill--info"><%= r.task_type_label %></span>
              </td>
              <td><span class="admin-label-muted"><%= r.profile_name.presence || "—" %></span></td>
              <td><span class="admin-label-muted"><%= r.machine_ip.presence || "—" %></span></td>
              <td>
                <% case r.status
                   when 'success' %>
                  <span class="admin-pill-status admin-pill--success">
                    <span class="admin-pill-status-dot"></span>成功
                  </span>
                <% when 'failed' %>
                  <span class="admin-pill-status admin-pill--failed">
                    <span class="admin-pill-status-dot"></span>失败
                  </span>
                <% when 'unknown' %>
                  <span class="admin-pill-status admin-pill--interrupted">
                    <span class="admin-pill-status-dot"></span>已丢失
                  </span>
                <% else %>
                  <span class="admin-pill-status admin-pill--queued">
                    <span class="admin-pill-status-dot"></span>执行中
                  </span>
                <% end %>
              </td>
              <td>
                <span class="admin-label-muted" title="<%= r.message %>">
                  <%= truncate(r.message.to_s, length: 40).presence || "—" %>
                </span>
              </td>
              <td><span class="admin-label-muted"><%= r.created_at&.strftime("%m-%d %H:%M") %></span></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <div class="admin-pagination">
      <%= paginate @records %>
    </div>
  <% else %>
    <div class="admin-empty-state">暂无异步任务记录。</div>
  <% end %>
</div>

<%# ============ 4. 任务操作（确认启动 + 清除任务危险区） ============ %>
<div class="admin-card tc-section">
  <div class="admin-card-header">
    <div>
      <div class="admin-card-title">任务操作</div>
      <div class="admin-card-subtitle">按机器执行：确认启动（恢复暂停任务）/ 清除任务（中断并清空）</div>
    </div>
  </div>

  <div class="admin-callout admin-callout-success">
    <div class="admin-callout-title">✅ 确认启动</div>
    当 Undetectable 已手动启动后，点这里恢复该机器上「因未启动而暂停」的发布任务（不回调、不标失败，等确认后才恢复）。

    <%= form_with url: resume_admin_task_center_index_path, method: :post,
                  data: { turbo_confirm: "确认该机器的 Undetectable 已启动？将立即探测并恢复其暂停的发布任务。" } do %>
      <div class="admin-form-row">
        <div class="admin-filter-group">
          <label class="admin-filter-label">机器（必选）</label>
          <%= select_tag :machine_ip,
                         options_for_select(@machines.map { |m| [m, m] }),
                         include_blank: "选择机器...",
                         class: "admin-input admin-filter-input",
                         required: true %>
        </div>
        <%= submit_tag "确认启动并恢复", class: "admin-button-primary" %>
      </div>
    <% end %>
  </div>

  <details class="admin-danger-zone">
    <summary>清除任务（破坏性操作，点开查看）</summary>

    <div class="admin-danger-zone-body">
      <div class="admin-callout admin-callout-danger">
        <div class="admin-callout-title">⚠️ 被清除的任务不再回调 account_sys</div>
        queued 会被取消、running 会被中断。类型与状态都不选＝全量清空该机器，请谨慎操作。
      </div>

      <%= form_with url: clear_admin_task_center_index_path, method: :post,
                    data: { turbo_confirm: "确定清除所选机器上指定类型/状态的任务？\n\n这会中断执行中/排队中的任务，且被清除任务不再回调。\n类型和状态都未选则会全量清空。" } do %>
        <div class="admin-form-stack">
          <div class="admin-filter-group">
            <label class="admin-filter-label">机器（必选）</label>
            <%= select_tag :machine_ip,
                           options_for_select(@machines.map { |m| [m, m] }),
                           include_blank: "选择机器...",
                           class: "admin-input admin-filter-input",
                           required: true %>
          </div>

          <div class="admin-filter-group">
            <label class="admin-filter-label">任务类型（不选＝不限类型）</label>
            <div class="admin-check-group">
              <% task_types.each do |k, v| %>
                <label class="admin-check"><input type="checkbox" name="type[]" value="<%= k %>"><%= v %></label>
              <% end %>
            </div>
          </div>

          <div class="admin-filter-group">
            <label class="admin-filter-label">状态（不选＝不限状态）</label>
            <div class="admin-check-group">
              <% status_labels.each do |k, v| %>
                <label class="admin-check"><input type="checkbox" name="status[]" value="<%= k %>"><%= v %></label>
              <% end %>
            </div>
          </div>

          <div>
            <%= submit_tag "清除任务", class: "admin-button-danger" %>
          </div>
        </div>
      <% end %>
    </div>
  </details>
</div>

<script>
  function toggleAllRetry() {
    var all = document.getElementById('retry-check-all').checked;
    document.querySelectorAll('.retry-check').forEach(function (c) { c.checked = all; });
  }

  function submitRetrySelected() {
    var ids = [];
    document.querySelectorAll('.retry-check:checked').forEach(function (c) { ids.push(c.value); });
    if (ids.length === 0) { alert('请先勾选要重新启动的失败任务'); return; }
    if (!confirm('确定重新启动选中的 ' + ids.length + ' 条失败任务？')) return;

    var form = document.createElement('form');
    form.method = 'POST';
    form.action = '<%= retry_failed_admin_task_center_index_path %>';

    var csrf = document.querySelector('meta[name="csrf-token"]');
    if (csrf) {
      var t = document.createElement('input');
      t.type = 'hidden'; t.name = 'authenticity_token'; t.value = csrf.content;
      form.appendChild(t);
    }

    ids.forEach(function (id) {
      var i = document.createElement('input');
      i.type = 'hidden'; i.name = 'record_ids[]'; i.value = id;
      form.appendChild(i);
    });

    document.body.appendChild(form);
    form.submit();
  }

  // 复选胶囊选中态（不依赖 :has()，兼容性更稳）
  document.querySelectorAll('.admin-check input[type="checkbox"]').forEach(function (cb) {
    var box = cb.closest('.admin-check');
    var sync = function () { box.classList.toggle('admin-check-on', cb.checked); };
    cb.addEventListener('change', sync);
    sync();
  });
</script>
