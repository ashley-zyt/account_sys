<% content_for :page_title do %>
  机器端任务详情
<% end %>
<% content_for :page_subtitle do %>
  机器端单条任务的完整记录（GET /tasks/{id}）
<% end %>

<%
  data = @result&.ok ? (@result.data || {}) : {}
  norm = data.any? ? MachineTaskMonitor.normalize_task(data) : {}
  src_labels = MachineTaskMonitor::SOURCE_LABELS

  pill_class = lambda do |status|
    key = status.to_s
    MachineTaskMonitor::STATUS_COLORS.key?(key) ? "admin-pill--#{key}" : 'admin-pill--interrupted'
  end

  # 字段中文名（顶层字段）
  label_map = {
    'task_id' => '任务ID',
    'type' => '任务类型',
    'status' => '状态',
    'ref' => '业务标识(ref)',
    'profile_name' => '指纹浏览器',
    'batch' => '批次标识',
    'message' => '结果说明',
    'created_at' => '提交时间',
    'updated_at' => '最近状态变更',
    'payload' => '原始请求体（重启重放用）',
    'dingtalk_webhook' => '钉钉 Webhook（仅人工/外部调用）',
    'dingtalk_keyword' => '钉钉关键字（仅人工/外部调用）',
    'dingtalk_owner' => '钉钉接收人（仅人工/外部调用）'
  }

  fmt_value = lambda do |v|
    case v
    when nil then '—'
    when Hash, Array then JSON.pretty_generate(v)
    else
      s = v.to_s
      s.empty? ? '—' : s
    end
  end

  # 关键字段（按机器端字段名取，缺的自动跳过）
  key_fields = [
    ['任务ID',        norm[:id]],
    ['任务类型',      norm[:type_label].presence || norm[:type]],
    ['状态',          norm[:status_label].presence || norm[:status]],
    ['指纹浏览器',    norm[:profile_name]],
    ['业务标识(ref)', norm[:ref]],
    ['批次标识',      norm[:batch]],
    ['来源',          src_labels[norm[:source].to_s] || norm[:source]],
    ['提交时间',      norm[:created_at]],
    ['最近状态变更',  norm[:updated_at]]
  ].reject { |(_, v)| v.nil? || v.to_s.strip.empty? }

  failed = norm[:status].to_s == 'failed'
%>

<div class="admin-card">
  <div class="admin-card-header">
    <div>
      <div class="admin-card-title">
        任务详情
        <span class="admin-label-muted">#<%= @task_id.presence || '—' %></span>
      </div>
      <div class="admin-card-subtitle">
        机器 <strong><%= @machine_ip.presence || '—' %></strong> ·
        <% if @result&.ok %>
          读取成功
        <% else %>
          <span class="admin-tx-failed">读取失败：<%= @result&.error %></span>
        <% end %>
      </div>
    </div>
    <div class="admin-card-header-right">
      <%= link_to "← 返回任务列表", machines_admin_task_center_index_path(@back_params), class: "admin-button-secondary" %>
      <%= link_to "任务总览", admin_task_center_index_path, class: "admin-button-secondary" %>
    </div>
  </div>

  <% if @result&.ok %>
    <% if norm[:status].present? %>
      <div class="admin-chip-row">
        <span class="admin-pill-status <%= pill_class.call(norm[:status]) %>">
          <span class="admin-pill-status-dot"></span><%= norm[:status_label].presence || norm[:status] %>
        </span>
        <% if norm[:type_label].present? %>
          <span class="admin-pill-status admin-pill--info"><%= norm[:type_label] %></span>
        <% end %>
        <% if norm[:source].present? %>
          <span class="admin-pill-status <%= norm[:source] == 'manual' ? 'admin-pill--source-manual' : 'admin-pill--source' %>">
            <%= src_labels[norm[:source].to_s] || norm[:source] %>
          </span>
        <% end %>
      </div>
    <% end %>

    <% if key_fields.any? %>
      <div class="admin-detail-grid">
        <% key_fields.each do |(label, value)| %>
          <div class="admin-detail-item">
            <div class="admin-detail-label"><%= label %></div>
            <div class="admin-detail-value"><%= value %></div>
          </div>
        <% end %>
      </div>
    <% end %>

    <% if norm[:message].present? %>
      <div class="admin-callout admin-gap-top <%= failed ? 'admin-callout-danger' : 'admin-callout-info' %>">
        <div class="admin-callout-title"><%= failed ? '⚠️ 结果说明' : 'ℹ️ 结果说明' %></div>
        <div class="admin-code admin-code-plain"><%= norm[:message] %></div>
      </div>
    <% end %>

    <div class="tc-subtable-title">完整字段</div>
    <div class="admin-table-wrapper tc-scroll">
      <table class="admin-table">
        <thead>
          <tr>
            <th class="admin-field-key">字段</th>
            <th>值</th>
          </tr>
        </thead>
        <tbody>
          <% data.each do |k, v| %>
            <tr>
              <td>
                <span class="admin-label-muted"><%= label_map[k.to_s] || k %></span>
                <div class="admin-label-muted admin-detail-hint"><%= k %></div>
              </td>
              <td class="admin-cell-wrap">
                <% if v.is_a?(Hash) || v.is_a?(Array) %>
                  <pre class="admin-code"><%= fmt_value.call(v) %></pre>
                <% else %>
                  <span class="admin-label-muted admin-cell-pre"><%= fmt_value.call(v) %></span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <details class="admin-raw-toggle">
      <summary>查看机器端原始 JSON 响应</summary>
      <pre class="admin-code admin-code-tall"><%= JSON.pretty_generate(data) %></pre>
    </details>
  <% else %>
    <div class="admin-callout admin-callout-danger">
      <div class="admin-callout-title">读取失败</div>
      <%= @result ? @result.error : '未发起查询' %>

      <% if @result&.code.to_i == 404 %>
        <div class="admin-callout-note">
          <strong>HTTP 404 · task not found</strong>：该记录已不在机器端。只有两种可能——
          超出保留期（默认 30 天）被清理，或被 <code>POST /tasks/clear</code> 清掉。
          机器端任务已落盘 SQLite，<strong>服务重启不会导致 404</strong>。
        </div>
      <% elsif @result&.code.to_i == 400 %>
        <div class="admin-callout-note">
          <strong>HTTP 400</strong>：task_id 为空或格式不合法（含 <code>/</code>）。
        </div>
      <% else %>
        <div class="admin-callout-note">
          常见原因：机器不可达 / 网络超时 / 鉴权失败（401）、或任务已被清理。
        </div>
      <% end %>
    </div>
  <% end %>
</div>
