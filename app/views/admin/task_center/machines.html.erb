<% content_for :page_title do %>
  机器端任务明细
<% end %>
<% content_for :page_subtitle do %>
  实时读取机器端任务队列（GET /tasks），可按状态 / 类型 / 浏览器 / 批次 / ref 前缀筛选；点任务 ID 查看单条详情
<% end %>

<%
  status_labels = MachineTaskMonitor::STATUS_LABELS
  limit_options = [50, 100, 200, 500]
  data = @result&.ok ? (@result.data || {}) : {}
  sc   = data['status_counts'] || {}    # /tasks 上是全局口径，不受筛选影响
  tc   = data['source_counts'] || {}    # 同上
  store = data['store'] || {}
  # 支持逗号分隔多值，也兼容多选数组
  sel_type   = MachineTaskMonitor.split_multi(params[:type])
  sel_status = MachineTaskMonitor.split_multi(params[:status])
  matched  = data['matched'].to_i
  returned = data.key?('returned') ? data['returned'].to_i : @tasks.size
  has_more = data['has_more'] == true
  fmt_time = lambda do |v|
    s = v.to_s
    s.empty? ? '—' : s.tr('T', ' ')[0, 19]
  end
%>

<%# ============ 筛选 ============ %>
<div class="admin-card">
  <div class="admin-card-header">
    <div>
      <div class="admin-card-title">筛选条件</div>
      <div class="admin-card-subtitle">
        <%= @machine_ip.presence || '未选择机器' %>
        · 采集于 <%= @fetched_at.strftime('%H:%M:%S') %>（机器端落盘 SQLite，重启不丢、保留 30 天）
        <% if @result && !@result.ok %>
          · <span style="color: #fca5a5;">查询失败：<%= @result.error %></span>
        <% end %>
      </div>
    </div>
    <div class="admin-card-header-right">
      <%= link_to "刷新", machines_admin_task_center_index_path(@back_params), class: "admin-button-secondary" %>
      <%= link_to "← 返回总览", admin_task_center_index_path, class: "admin-button-secondary" %>
    </div>
  </div>

  <%= form_with url: machines_admin_task_center_index_path, method: :get, local: true, class: "admin-filter-form" do %>
    <div class="admin-filter-group">
      <label class="admin-filter-label">机器</label>
      <%= select_tag :machine_ip,
                     options_for_select(@machines.map { |m| [m, m] }, @machine_ip),
                     include_blank: "选择机器...",
                     class: "admin-input admin-filter-input",
                     onchange: "this.form.submit()" %>
    </div>

    <div class="admin-filter-group">
      <label class="admin-filter-label">状态（可多选）</label>
      <%= select_tag :status,
                     options_for_select(status_labels.map { |k, v| [v, k] }, sel_status),
                     multiple: true, size: 6, class: "admin-input admin-filter-input" %>
    </div>

    <div class="admin-filter-group">
      <label class="admin-filter-label">任务类型（可多选）</label>
      <%= select_tag :type,
                     options_for_select(@task_types.map { |k, v| [v, k] }, sel_type),
                     multiple: true, size: 6, class: "admin-input admin-filter-input" %>
    </div>

    <div class="admin-filter-group">
      <label class="admin-filter-label">浏览器</label>
      <%= text_field_tag :profile_name, @filters[:profile_name],
                         class: "admin-input admin-filter-input", placeholder: "profile_name，可逗号分隔多个" %>
    </div>

    <div class="admin-filter-group">
      <label class="admin-filter-label">批次</label>
      <%= text_field_tag :batch, @filters[:batch],
                         class: "admin-input admin-filter-input", placeholder: "batch，可逗号分隔多个" %>
    </div>

    <div class="admin-filter-group">
      <label class="admin-filter-label">ref 前缀</label>
      <%= text_field_tag :ref_prefix, @filters[:ref_prefix],
                         class: "admin-input admin-filter-input", placeholder: "如 MoveTask:,Account:（前缀匹配，可多个）" %>
    </div>

    <div class="admin-filter-group">
      <label class="admin-filter-label">任务范围</label>
      <%= select_tag :own_only,
                     options_for_select([['全部（含人工/外部）', '0'], ['仅本系统下发', '1']], @own_only ? '1' : '0'),
                     class: "admin-input admin-filter-input" %>
    </div>

    <div class="admin-filter-group">
      <label class="admin-filter-label">返回条数</label>
      <%= select_tag :limit,
                     options_for_select(limit_options.map { |n| ["#{n} 条", n] }, @limit),
                     class: "admin-input admin-filter-input" %>
    </div>

    <div style="margin-left: auto;">
      <%= submit_tag "筛选", class: "admin-button-primary" %>
      <%= link_to "重置", machines_admin_task_center_index_path(machine_ip: @machine_ip), class: "admin-button-secondary" %>
    </div>
  <% end %>

  <div style="padding: 0 16px 16px; display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
    <span style="color: #64748b; font-size: 12px;">快捷筛选：</span>
    <%= link_to "排队 + 执行中", machines_admin_task_center_index_path(machine_ip: @machine_ip, status: 'queued,running'), class: "admin-tag" %>
    <%= link_to "失败", machines_admin_task_center_index_path(machine_ip: @machine_ip, status: 'failed'), class: "admin-tag" %>
    <%= link_to "已暂停", machines_admin_task_center_index_path(machine_ip: @machine_ip, status: 'paused'), class: "admin-tag" %>
  </div>
</div>

<%# ============ 统计 ============ %>
<% if @result&.ok %>
  <div class="admin-card" style="margin-top: 16px;">
    <div class="admin-card-header">
      <div>
        <div class="admin-card-title">统计</div>
        <div class="admin-card-subtitle">
          ⚠️ 机器端 <code>/tasks</code> 的「库内总数 / 各状态 / 来源」是<strong>全局口径，不受上面筛选影响</strong>；
          「筛选命中」才是当前条件的真实条数（limit 截断前）
        </div>
      </div>
    </div>

    <div style="padding: 0 16px 16px; display: flex; gap: 12px; flex-wrap: wrap;">
      <div style="flex: 1; min-width: 140px; background: rgba(30, 41, 59, 0.6); border: 1px solid #334155; border-radius: 8px; padding: 12px;">
        <div style="color: #94a3b8; font-size: 12px;">库内总数 · 全局</div>
        <div style="font-size: 24px; font-weight: 600; color: #e2e8f0; margin-top: 6px;"><%= data['total'].to_i %></div>
      </div>
      <div style="flex: 1; min-width: 140px; background: rgba(59, 130, 246, 0.08); border: 1px solid rgba(59, 130, 246, 0.35); border-radius: 8px; padding: 12px;">
        <div style="color: #93c5fd; font-size: 12px;">筛选命中 · 截断前</div>
        <div style="font-size: 24px; font-weight: 600; color: #3b82f6; margin-top: 6px;"><%= matched %></div>
      </div>
      <div style="flex: 1; min-width: 140px; background: rgba(30, 41, 59, 0.6); border: 1px solid #334155; border-radius: 8px; padding: 12px;">
        <div style="color: #94a3b8; font-size: 12px;">本次返回</div>
        <div style="font-size: 24px; font-weight: 600; color: #e2e8f0; margin-top: 6px;"><%= returned %></div>
      </div>
      <div style="flex: 1; min-width: 140px; background: rgba(30, 41, 59, 0.6); border: 1px solid #334155; border-radius: 8px; padding: 12px;">
        <div style="color: #94a3b8; font-size: 12px;">是否被截断</div>
        <div style="font-size: 24px; font-weight: 600; margin-top: 6px; color: <%= has_more ? '#ef4444' : '#22c55e' %>;"><%= has_more ? '是' : '否' %></div>
      </div>
    </div>

    <div style="padding: 0 16px 16px; display: flex; gap: 10px; flex-wrap: wrap; align-items: center;">
      <span class="admin-label-muted" style="font-size: 12px;">全局状态分布：</span>
      <% sc.each do |k, v| %>
        <% fg, bg = MachineTaskMonitor.status_color(k) %>
        <span class="admin-pill-status" style="background: <%= bg %>; color: <%= fg %>;">
          <span class="admin-pill-status-dot"></span><%= status_labels[k.to_s] || k %> <%= v.to_i %>
        </span>
      <% end %>
      <span class="admin-label-muted" style="font-size: 12px;">· 全局来源：</span>
      <% tc.each do |k, v| %>
        <span class="admin-tag"><%= MachineTaskMonitor::SOURCE_LABELS[k.to_s] || k %> <%= v.to_i %></span>
      <% end %>
    </div>

    <% if store.present? %>
      <div style="padding: 0 16px 16px; color: #64748b; font-size: 12px;">
        存储：<%= store['file'] || '—' %> ·
        保留 <%= store['retention_days'] || '—' %> 天 ·
        大小 <%= (store['size_bytes'].to_i / 1024.0).round(1) %> KB ·
        最近落盘 <%= fmt_time.call(store['saved_at']) %>
        <% if store['enabled'] == false %>
          · <span style="color: #fca5a5;">⚠️ 落盘未启用（重启后历史会丢）</span>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>

<%# ============ 任务列表 ============ %>
<div class="admin-card" style="margin-top: 16px;">
  <div class="admin-card-header">
    <div>
      <div class="admin-card-title">任务列表</div>
      <div class="admin-card-subtitle">
        显示 <%= @tasks.size %> 条 · 按提交时间倒序
        <% if has_more %>
          · <span style="color: #fca5a5;">命中 <%= matched %> 条，被「返回条数」截断</span>
        <% end %>
      </div>
    </div>
  </div>

  <% if @result.nil? %>
    <div class="admin-empty-state">没有配置 machine_ip 的浏览器，无可查询的机器。</div>
  <% elsif !@result.ok %>
    <div class="admin-empty-state" style="color: #fca5a5;">查询失败：<%= @result.error %></div>
  <% elsif @tasks.empty? %>
    <div class="admin-empty-state">该筛选条件下没有任务。</div>
  <% else %>
    <div class="admin-table-wrapper admin-table-scroll">
      <table class="admin-table">
        <thead>
          <tr>
            <th>任务ID</th>
            <th>类型</th>
            <th>状态</th>
            <th>浏览器</th>
            <th>业务标识(ref)</th>
            <th>批次</th>
            <th>来源</th>
            <th>消息</th>
            <th>提交时间</th>
            <th>最近变更</th>
          </tr>
        </thead>
        <tbody>
          <% @tasks.each do |t| %>
            <% fg, bg = MachineTaskMonitor.status_color(t[:status]) %>
            <tr>
              <td>
                <% if t[:id].present? %>
                  <%= link_to truncate(t[:id].to_s, length: 22),
                              machine_task_admin_task_center_index_path(@back_params.merge('task_id' => t[:id])),
                              class: "admin-link-quiet", title: t[:id].to_s %>
                <% else %>
                  <span class="admin-label-muted">—</span>
                <% end %>
              </td>
              <td>
                <span class="admin-pill-status" style="background: rgba(99, 102, 241, 0.12); color: #818cf8;">
                  <%= t[:type_label].presence || '—' %>
                </span>
              </td>
              <td>
                <span class="admin-pill-status" style="background: <%= bg %>; color: <%= fg %>;">
                  <span class="admin-pill-status-dot"></span><%= t[:status_label].presence || '—' %>
                </span>
              </td>
              <td><span class="admin-label-muted"><%= t[:profile_name].presence || '—' %></span></td>
              <td><span class="admin-label-muted"><%= t[:ref].presence || '—' %></span></td>
              <td><span class="admin-label-muted"><%= t[:batch].presence || '—' %></span></td>
              <td>
                <span class="admin-tag" style="<%= t[:source] == 'manual' ? 'color:#f472b6;' : 'color:#38bdf8;' %>">
                  <%= t[:source_label] %>
                </span>
              </td>
              <td>
                <span class="admin-label-muted" title="<%= t[:message] %>">
                  <%= truncate(t[:message].to_s, length: 40).presence || '—' %>
                </span>
              </td>
              <td><span class="admin-label-muted"><%= fmt_time.call(t[:created_at]) %></span></td>
              <td><span class="admin-label-muted"><%= fmt_time.call(t[:updated_at]) %></span></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <div style="padding: 12px 16px; color: #64748b; font-size: 12px;">
      来源判定：带 dingtalk_webhook ＝ 人工/外部直接调 API；不带 ＝ account_sys 下发。
      想看某类堆积的真实总量，可把「返回条数」调小（如 1 条），「筛选命中」即总数。
    </div>
  <% end %>
</div>

<%# ============ 任务操作（预填当前机器与筛选，直接作用于这批任务） ============ %>
<div class="admin-card" style="margin-top: 16px;">
  <div class="admin-card-header">
    <div>
      <div class="admin-card-title">任务操作</div>
      <div class="admin-card-subtitle">对 <strong><%= @machine_ip.presence || '（未选机器）' %></strong> 上符合条件的任务中断/清空，或确认启动恢复暂停任务</div>
    </div>
  </div>

  <div style="padding: 0 16px 16px;">
    <div style="border: 1px solid rgba(34, 197, 94, 0.35); border-radius: 8px; padding: 12px 16px; background: rgba(34, 197, 94, 0.05);">
      <div style="color: #86efac; font-size: 13px; margin-bottom: 10px;">
        ✅ 确认启动：Undetectable 已手动启动后，探测并恢复该机器上「因未启动而暂停」的发布任务
        （只恢复 paused 且类型以 <code>_publish</code> 结尾、带 payload 的任务）
      </div>
      <%= form_with url: resume_admin_task_center_index_path, method: :post,
                    data: { turbo_confirm: "确认 #{@machine_ip} 的 Undetectable 已启动？将立即探测（最长约 60 秒）并恢复其暂停的发布任务。" } do %>
        <%= hidden_field_tag :machine_ip, @machine_ip %>
        <%= submit_tag "确认启动并恢复", class: "admin-button-primary" %>
      <% end %>
    </div>
  </div>

  <div style="padding: 0 16px 16px;">
    <div style="border: 1px solid rgba(239, 68, 68, 0.35); border-radius: 8px; padding: 12px 16px; background: rgba(239, 68, 68, 0.05);">
      <div style="color: #fca5a5; font-size: 13px; margin-bottom: 10px;">
        ⚠️ 清除任务（破坏性）：queued 会被取消、running 会被中断，记录从机器端删除且<strong>不再回调 account_sys</strong>。
        类型与状态都不选即全量清空该机器任务
      </div>
      <%= form_with url: clear_admin_task_center_index_path, method: :post,
                    data: { turbo_confirm: "确定清除 #{@machine_ip} 上所选类型/状态的任务？这会中断执行中/排队中的任务，且被清除任务不再回调。" } do %>
        <%= hidden_field_tag :machine_ip, @machine_ip %>
        <div style="display: flex; gap: 16px; flex-wrap: wrap; align-items: flex-end;">
          <div class="admin-filter-group">
            <label class="admin-filter-label">状态（可多选，默认取当前筛选）</label>
            <%= select_tag :status,
                           options_for_select(status_labels.map { |k, v| [v, k] }, sel_status),
                           multiple: true, size: 6, class: "admin-input admin-filter-input" %>
          </div>
          <div class="admin-filter-group">
            <label class="admin-filter-label">任务类型（可多选，默认取当前筛选）</label>
            <%= select_tag :type,
                           options_for_select(@task_types.map { |k, v| [v, k] }, sel_type),
                           multiple: true, size: 6, class: "admin-input admin-filter-input" %>
          </div>
          <div>
            <%= submit_tag "清除任务", class: "admin-button-danger" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
