<% content_for :page_title do %>
  机器端任务明细
<% end %>
<% content_for :page_subtitle do %>
  实时读取机器端任务队列（GET /tasks），可按状态 / 类型 / 浏览器 / 批次 / ref 前缀筛选；点任务 ID 查看单条详情
<% end %>

<%
  status_labels = MachineTaskMonitor::STATUS_LABELS
  limit_options = [50, 100, 200, 500]

  data   = @result&.ok ? (@result.data || {}) : {}
  sc     = data['status_counts'] || {}   # /tasks 上是全局口径，不受筛选影响
  tc     = data['source_counts'] || {}   # 同上
  store  = data['store'] || {}

  # 支持逗号分隔多值，也兼容多选数组
  sel_type   = MachineTaskMonitor.split_multi(params[:type])
  sel_status = MachineTaskMonitor.split_multi(params[:status])

  matched  = data['matched'].to_i
  returned = data.key?('returned') ? data['returned'].to_i : @tasks.size
  has_more = data['has_more'] == true

  fmt_time = lambda do |v|
    s = v.to_s
    s.empty? ? '—' : s.tr('T', ' ')[0, 19]
  end

  pill_class = lambda do |status|
    key = status.to_s
    MachineTaskMonitor::STATUS_COLORS.key?(key) ? "admin-pill--#{key}" : 'admin-pill--interrupted'
  end

  stat_items = [
    { label: '库内总数 · 全局', value: data['total'].to_i,            tx: '',                  hint: '不受筛选影响' },
    { label: '筛选命中 · 截断前', value: matched,                     tx: 'admin-tx-running',  hint: '当前条件的真实条数' },
    { label: '本次返回',         value: returned,                    tx: '',                  hint: '受「返回条数」限制' },
    { label: '是否被截断',       value: has_more ? '是' : '否',       tx: has_more ? 'admin-tx-failed' : 'admin-tx-success', hint: has_more ? '命中数大于返回条数' : '命中已全部返回' }
  ]
%>

<%# ============ 1. 筛选条件 ============ %>
<div class="admin-card">
  <div class="admin-card-header">
    <div>
      <div class="admin-card-title">筛选条件</div>
      <div class="admin-card-subtitle">
        机器 <strong><%= @machine_ip.presence || '未选择机器' %></strong>
        · 采集于 <%= @fetched_at.strftime('%H:%M:%S') %>
        （机器端落盘 SQLite，重启不丢、保留 30 天）
        <% if @result && !@result.ok %>
          · <span class="admin-tx-failed">查询失败：<%= @result.error %></span>
        <% end %>
      </div>
    </div>
    <div class="admin-card-header-right">
      <%= link_to "刷新", machines_admin_task_center_index_path(@back_params), class: "admin-button-secondary" %>
      <%= link_to "← 返回总览", admin_task_center_index_path, class: "admin-button-secondary" %>
    </div>
  </div>

  <%= form_with url: machines_admin_task_center_index_path, method: :get, local: true, class: "admin-filter-form" do %>
    <div class="admin-filter-group">
      <label class="admin-filter-label">机器</label>
      <%= select_tag :machine_ip,
                     options_for_select(@machines.map { |m| [m, m] }, @machine_ip),
                     include_blank: "选择机器...",
                     class: "admin-input admin-filter-input",
                     onchange: "this.form.submit()" %>
    </div>

    <div class="admin-filter-group">
      <label class="admin-filter-label">浏览器 profile_name</label>
      <%= text_field_tag :profile_name, @filters[:profile_name],
                         class: "admin-input admin-filter-input", placeholder: "可逗号分隔多个" %>
    </div>

    <div class="admin-filter-group">
      <label class="admin-filter-label">批次 batch</label>
      <%= text_field_tag :batch, @filters[:batch],
                         class: "admin-input admin-filter-input", placeholder: "可逗号分隔多个" %>
    </div>

    <div class="admin-filter-group">
      <label class="admin-filter-label">ref 前缀</label>
      <%= text_field_tag :ref_prefix, @filters[:ref_prefix],
                         class: "admin-input admin-filter-input", placeholder: "如 MoveTask:,Account:" %>
    </div>

    <div class="admin-filter-group">
      <label class="admin-filter-label">任务范围</label>
      <%= select_tag :own_only,
                     options_for_select([['全部（含人工/外部）', '0'], ['仅本系统下发', '1']], @own_only ? '1' : '0'),
                     class: "admin-input admin-filter-input" %>
    </div>

    <div class="admin-filter-group">
      <label class="admin-filter-label">返回条数</label>
      <%= select_tag :limit,
                     options_for_select(limit_options.map { |n| ["#{n} 条", n] }, @limit),
                     class: "admin-input admin-filter-input" %>
    </div>

    <div class="admin-filter-group admin-filter-group-full">
      <label class="admin-filter-label">状态（多选，可任意组合）</label>
      <div class="admin-check-group">
        <% status_labels.each do |k, v| %>
          <label class="admin-check">
            <input type="checkbox" name="status[]" value="<%= k %>" <%= "checked" if sel_status.include?(k) %>>
            <%= v %>
          </label>
        <% end %>
      </div>
    </div>

    <div class="admin-filter-group admin-filter-group-full">
      <label class="admin-filter-label">任务类型（多选，可任意组合）</label>
      <div class="admin-check-group">
        <% @task_types.each do |k, v| %>
          <label class="admin-check">
            <input type="checkbox" name="type[]" value="<%= k %>" <%= "checked" if sel_type.include?(k) %>>
            <%= v %>
          </label>
        <% end %>
      </div>
    </div>

    <div class="admin-filter-actions">
      <%= submit_tag "筛选", class: "admin-button-primary" %>
      <%= link_to "重置", machines_admin_task_center_index_path(machine_ip: @machine_ip), class: "admin-button-secondary" %>
    </div>
  <% end %>

  <div class="admin-chip-row">
    <span class="admin-label-muted">快捷筛选：</span>
    <%= link_to "排队 + 执行中", machines_admin_task_center_index_path(machine_ip: @machine_ip, status: 'queued,running'), class: "admin-chip" %>
    <%= link_to "失败",         machines_admin_task_center_index_path(machine_ip: @machine_ip, status: 'failed'),         class: "admin-chip" %>
    <%= link_to "已暂停",       machines_admin_task_center_index_path(machine_ip: @machine_ip, status: 'paused'),         class: "admin-chip" %>
  </div>
</div>

<%# ============ 2. 统计 ============ %>
<% if @result&.ok %>
  <div class="admin-card tc-section">
    <div class="admin-card-header">
      <div>
        <div class="admin-card-title">统计</div>
        <div class="admin-card-subtitle">
          机器端 <code>/tasks</code> 的「库内总数 / 各状态 / 来源」是<strong>全局口径，不受筛选影响</strong>；
          「筛选命中」才是当前条件的真实条数（limit 截断前）
        </div>
      </div>
    </div>

    <div class="admin-stat-grid">
      <% stat_items.each do |s| %>
        <div class="admin-stat">
          <div class="admin-stat-value <%= s[:tx] %>"><%= s[:value] %></div>
          <div class="admin-stat-label"><%= s[:label] %></div>
          <div class="admin-stat-hint"><%= s[:hint] %></div>
        </div>
      <% end %>
    </div>

    <div class="admin-chip-row">
      <span class="admin-label-muted">全局状态分布：</span>
      <% sc.each do |k, v| %>
        <span class="admin-pill-status <%= pill_class.call(k) %>">
          <span class="admin-pill-status-dot"></span><%= status_labels[k.to_s] || k %> <%= v.to_i %>
        </span>
      <% end %>
      <span class="admin-label-muted">· 全局来源：</span>
      <% tc.each do |k, v| %>
        <span class="admin-chip"><%= MachineTaskMonitor::SOURCE_LABELS[k.to_s] || k %> <%= v.to_i %></span>
      <% end %>
    </div>

    <% if store.present? %>
      <div class="admin-chip-row">
        <span class="admin-label-muted">
          存储：<%= store['file'] || '—' %> ·
          保留 <%= store['retention_days'] || '—' %> 天 ·
          大小 <%= (store['size_bytes'].to_i / 1024.0).round(1) %> KB ·
          最近落盘 <%= fmt_time.call(store['saved_at']) %>
        </span>
        <% if store['enabled'] == false %>
          <span class="admin-pill-status admin-pill--failed">
            <span class="admin-pill-status-dot"></span>落盘未启用（重启后历史会丢）
          </span>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>

<%# ============ 3. 任务列表 ============ %>
<div class="admin-card tc-section">
  <div class="admin-card-header">
    <div>
      <div class="admin-card-title">任务列表</div>
      <div class="admin-card-subtitle">
        显示 <%= @tasks.size %> 条 · 按提交时间倒序
        <% if has_more %>
          · <span class="admin-tx-failed">命中 <%= matched %> 条，被「返回条数」截断</span>
        <% end %>
      </div>
    </div>
  </div>

  <% if @result.nil? %>
    <div class="admin-empty-state">没有配置 machine_ip 的浏览器，无可查询的机器。</div>
  <% elsif !@result.ok %>
    <div class="admin-callout admin-callout-danger">
      <div class="admin-callout-title">查询失败</div>
      <%= @result.error %>
    </div>
  <% elsif @tasks.empty? %>
    <div class="admin-empty-state">该筛选条件下没有任务。</div>
  <% else %>
    <div class="admin-table-wrapper tc-scroll">
      <table class="admin-table">
        <thead>
          <tr>
            <th>任务ID</th>
            <th>类型</th>
            <th>状态</th>
            <th>浏览器</th>
            <th>业务标识(ref)</th>
            <th>批次</th>
            <th>来源</th>
            <th>消息</th>
            <th>提交时间</th>
            <th>最近变更</th>
          </tr>
        </thead>
        <tbody>
          <% @tasks.each do |t| %>
            <tr>
              <td>
                <% if t[:id].present? %>
                  <%= link_to truncate(t[:id].to_s, length: 22),
                              machine_task_admin_task_center_index_path(@back_params.merge('task_id' => t[:id])),
                              class: "admin-link-quiet", title: t[:id].to_s %>
                <% else %>
                  <span class="admin-label-muted">—</span>
                <% end %>
              </td>
              <td>
                <span class="admin-pill-status admin-pill--info"><%= t[:type_label].presence || '—' %></span>
              </td>
              <td>
                <span class="admin-pill-status <%= pill_class.call(t[:status]) %>">
                  <span class="admin-pill-status-dot"></span><%= t[:status_label].presence || '—' %>
                </span>
              </td>
              <td><span class="admin-label-muted"><%= t[:profile_name].presence || '—' %></span></td>
              <td><span class="admin-label-muted"><%= t[:ref].presence || '—' %></span></td>
              <td><span class="admin-label-muted"><%= t[:batch].presence || '—' %></span></td>
              <td>
                <span class="admin-pill-status <%= t[:source] == 'manual' ? 'admin-pill--source-manual' : 'admin-pill--source' %>">
                  <%= t[:source_label] %>
                </span>
              </td>
              <td>
                <span class="admin-label-muted" title="<%= t[:message] %>">
                  <%= truncate(t[:message].to_s, length: 40).presence || '—' %>
                </span>
              </td>
              <td><span class="admin-label-muted"><%= fmt_time.call(t[:created_at]) %></span></td>
              <td><span class="admin-label-muted"><%= fmt_time.call(t[:updated_at]) %></span></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="admin-chip-row">
      <span class="admin-label-muted">
        来源判定：带 dingtalk_webhook ＝ 人工/外部直接调 API；不带 ＝ account_sys 下发。
        想看某类堆积的真实总量，可把「返回条数」调小（如 1 条），「筛选命中」即总数。
      </span>
    </div>
  <% end %>
</div>

<%# ============ 4. 任务操作（作用于当前机器） ============ %>
<div class="admin-card tc-section">
  <div class="admin-card-header">
    <div>
      <div class="admin-card-title">任务操作</div>
      <div class="admin-card-subtitle">
        对 <strong><%= @machine_ip.presence || '（未选机器）' %></strong> 上符合条件的任务中断/清空，或确认启动恢复暂停任务
      </div>
    </div>
  </div>

  <div class="admin-callout admin-callout-success">
    <div class="admin-callout-title">✅ 确认启动</div>
    Undetectable 已手动启动后，探测并恢复该机器上「因未启动而暂停」的发布任务
    （只恢复 paused、类型以 <code>_publish</code> 结尾且带 payload 的任务）。

    <%= form_with url: resume_admin_task_center_index_path, method: :post,
                  data: { turbo_confirm: "确认 #{@machine_ip} 的 Undetectable 已启动？将立即探测（最长约 60 秒）并恢复其暂停的发布任务。" } do %>
      <div class="admin-form-row">
        <%= hidden_field_tag :machine_ip, @machine_ip %>
        <%= submit_tag "确认启动并恢复", class: "admin-button-primary" %>
      </div>
    <% end %>
  </div>

  <details class="admin-danger-zone">
    <summary>清除任务（破坏性操作，点开查看）</summary>

    <div class="admin-danger-zone-body">
      <div class="admin-callout admin-callout-danger">
        <div class="admin-callout-title">⚠️ 被清除的任务不再回调 account_sys</div>
        queued 会被取消、running 会被中断，记录从机器端删除。
        类型与状态都不选 = 全量清空该机器任务。
      </div>

      <%= form_with url: clear_admin_task_center_index_path, method: :post,
                    data: { turbo_confirm: "确定清除 #{@machine_ip} 上所选类型/状态的任务？这会中断执行中/排队中的任务，且被清除任务不再回调。" } do %>
        <div class="admin-form-stack">
          <%= hidden_field_tag :machine_ip, @machine_ip %>

          <div class="admin-filter-group">
            <label class="admin-filter-label">状态（默认取当前筛选，可改）</label>
            <div class="admin-check-group">
              <% status_labels.each do |k, v| %>
                <label class="admin-check">
                  <input type="checkbox" name="status[]" value="<%= k %>" <%= "checked" if sel_status.include?(k) %>>
                  <%= v %>
                </label>
              <% end %>
            </div>
          </div>

          <div class="admin-filter-group">
            <label class="admin-filter-label">任务类型（默认取当前筛选，可改）</label>
            <div class="admin-check-group">
              <% @task_types.each do |k, v| %>
                <label class="admin-check">
                  <input type="checkbox" name="type[]" value="<%= k %>" <%= "checked" if sel_type.include?(k) %>>
                  <%= v %>
                </label>
              <% end %>
            </div>
          </div>

          <div>
            <%= submit_tag "清除任务", class: "admin-button-danger" %>
          </div>
        </div>
      <% end %>
    </div>
  </details>
</div>

<script>
  // 复选胶囊选中态（不依赖 :has()，兼容性更稳）
  document.querySelectorAll('.admin-check input[type="checkbox"]').forEach(function (cb) {
    var box = cb.closest('.admin-check');
    var sync = function () { box.classList.toggle('admin-check-on', cb.checked); };
    cb.addEventListener('change', sync);
    sync();
  });
</script>
