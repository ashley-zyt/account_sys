<% content_for :page_title do %>
  对标账号储备
<% end %>
<% content_for :page_subtitle do %>
  维护各主题的搬运对标账号（主页链接），视频入库时按来源账号自动归类主题
<% end %>

<div class="admin-card">
  <div class="admin-card-header">
    <div>
      <div class="admin-card-title">对标账号列表</div>
      <div class="admin-card-subtitle">维护「主题 → 对标账号」映射</div>
    </div>
    <div class="admin-card-header-right">
      <span class="admin-tag">共 <%= @themes.size %> 个主题</span>
    </div>
  </div>

  <% if @themes.any? %>
    <div class="admin-table-wrapper admin-table-scroll">
      <table class="admin-table">
        <thead>
          <tr>
            <th>主题</th>
            <th>账号数</th>
            <th>待下载</th>
            <th>对标账号</th>
            <th>操作</th>
          </tr>
        </thead>
        <tbody>
          <% @themes.each do |theme| %>
            <tr>
              <td><%= theme.name %></td>
              <td><%= theme.source_accounts_array.size %></td>
              <td><%= @pending_counts[theme.name] || 0 %></td>
              <td>
                <span class="admin-label-muted" title="<%= theme.source_accounts.to_s %>"><%= theme.source_accounts.present? ? theme.source_accounts.truncate(60) : '未配置' %></span>
              </td>
              <td>
                <button type="button" onclick="openEditSourceAccountsModal(<%= theme.id %>)" style="padding: 4px 10px; font-size: 11px; background-color: #3b82f6; color: white; border-radius: 4px; border: none; cursor: pointer;">编辑对标账号</button>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="admin-empty-state">暂无主题。</div>
  <% end %>
</div>

<div id="source-accounts-modal" class="admin-modal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.7); z-index: 1000; justify-content: center; align-items: center;">
  <div class="admin-modal-content" style="background: #1e293b; border-radius: 12px; width: 600px; max-width: 90%; max-height: 90%; overflow: hidden;">
    <iframe id="source-accounts-iframe" style="width: 100%; height: 100%; border: none; min-height: 420px;" src=""></iframe>
  </div>
</div>

<script>
  var modal = document.getElementById('source-accounts-modal');
  var iframe = document.getElementById('source-accounts-iframe');

  function openEditSourceAccountsModal(id) {
    iframe.src = '/admin/themes/' + id + '/edit_source_accounts';
    modal.style.display = 'flex';
  }

  function closeSourceAccountsModal(refresh) {
    modal.style.display = 'none';
    iframe.src = '';
    if (refresh) {
      location.reload();
    }
  }

  modal.addEventListener('click', function(e) {
    if (e.target === modal) {
      closeSourceAccountsModal(false);
    }
  });
</script>
