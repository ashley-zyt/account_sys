<% content_for :page_title do %>
  养号统计
<% end %>
<% content_for :page_subtitle do %>
  按运营机器IP分组的养号任务执行统计
<% end %>

<div class="admin-card">
  <div class="admin-card-header">
    <div>
      <div class="admin-card-title">
        养号统计
      </div>
      <div class="admin-card-subtitle">
        按运营机器IP分组展示养号任务执行数据
      </div>
    </div>
    <div class="admin-card-header-right">
      <%= link_to "返回列表", admin_warmup_tasks_path, class: "admin-button-secondary" %>
    </div>
  </div>

  <div class="admin-stats-grid">
    <div class="admin-stat-card">
      <div class="admin-stat-value"><%= @machine_stats.sum { |s| s[:total_accounts] } %></div>
      <div class="admin-stat-label">可用账号总数</div>
    </div>
    <div class="admin-stat-card">
      <div class="admin-stat-value"><%= @machine_stats.sum { |s| s[:enabled_accounts] } %></div>
      <div class="admin-stat-label">启用养号账号</div>
    </div>
    <div class="admin-stat-card" style="background: rgba(34, 197, 94, 0.1);">
      <div class="admin-stat-value" style="color: #22c55e;"><%= @total_success %></div>
      <div class="admin-stat-label">养号成功</div>
    </div>
    <div class="admin-stat-card" style="background: rgba(239, 68, 68, 0.1);">
      <div class="admin-stat-value" style="color: #ef4444;"><%= @total_failed %></div>
      <div class="admin-stat-label">养号失败</div>
    </div>
  </div>

  <% if @machine_stats.any? %>
    <% @machine_stats.each do |stat| %>
      <div class="admin-section">
        <div class="admin-section-title">
          运营机器
          <span class="admin-pill-status" style="background: rgba(59, 130, 246, 0.1); color: #3b82f6; margin-left: 8px;"><%= stat[:ip] %></span>
        </div>
        <div style="font-size: 12px; color: var(--text-secondary); margin-bottom: 10px;">
          可用账号 <%= stat[:total_accounts] %> · 启用养号 <%= stat[:enabled_accounts] %>
        </div>
        <div class="admin-table-wrapper">
          <table class="admin-table">
            <thead>
              <tr>
                <th>状态</th>
                <th>数量</th>
                <th>占比</th>
              </tr>
            </thead>
            <tbody>
              <% total = stat[:task_counts].values.sum %>
              <% WarmupTask.statuses.each do |status, _v| %>
                <% count = stat[:task_counts][WarmupTask.statuses[status]] || 0 %>
                <tr>
                  <td>
                    <% case status.to_s %>
                    <% when 'success' %>
                      <span class="admin-pill-status" style="background: rgba(34, 197, 94, 0.1); color: #22c55e;">成功</span>
                    <% when 'failed' %>
                      <span class="admin-pill-status" style="background: rgba(239, 68, 68, 0.1); color: #ef4444;">失败</span>
                    <% when 'executing' %>
                      <span class="admin-pill-status" style="background: rgba(59, 130, 246, 0.1); color: #3b82f6;">执行中</span>
                    <% else %>
                      <span class="admin-pill-status" style="background: rgba(156, 163, 175, 0.1); color: #9ca3af;">待执行</span>
                    <% end %>
                  </td>
                  <td><%= count %></td>
                  <td><%= total > 0 ? (count.to_f / total * 100).round(1) : 0 %>%</td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="admin-empty-state">
      暂无养号任务执行记录（任务执行后机器IP会自动记录到任务中）。
    </div>
  <% end %>
</div>
