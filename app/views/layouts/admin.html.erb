<!DOCTYPE html>
<html>
  <head>
    <title>Admin · AccountSys</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head if content_for?(:head) %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="admin">
    <div class="admin-layout" data-controller="sidebar">
      <aside class="admin-sidebar">
        <div class="admin-logo">
          <div class="admin-logo-badge">
            <div class="admin-logo-inner">
              AS
            </div>
          </div>
          <div class="admin-logo-text">
            <div class="admin-logo-title">
              AccountSys
            </div>
            <div class="admin-logo-subtitle">
              Admin Console
            </div>
          </div>
          <button type="button"
                  class="admin-sidebar-toggle"
                  title="折叠/展开侧边栏"
                  data-action="click->sidebar#toggleCollapse">
            <span class="admin-sidebar-toggle-icon">☰</span>
          </button>
        </div>

        <nav class="admin-sidebar-nav">
        <div class="admin-sidebar-section" data-section-name="overview" data-sidebar-target="section">
          <div class="admin-sidebar-section-title"
               data-action="click->sidebar#toggleSection">
            <span>概览</span>
            <span class="section-arrow">▾</span>
          </div>
          <ul class="admin-nav">
            <% dashboard_active = controller_path == "admin/dashboard" %>
            <li class="admin-nav-item <%= "active" if dashboard_active %>">
              <%= link_to admin_root_path, class: "admin-nav-link", data: { tooltip: "仪表盘" } do %>
                <div class="admin-nav-link-main">
                  <div class="admin-nav-icon">
                    📊
                  </div>
                  <div class="admin-nav-label">
                    仪表盘
                  </div>
                </div>
                <div class="admin-nav-meta">
                  Dashboard
                </div>
              <% end %>
            </li>

            <% data_alerts_active = controller_path == "admin/data_alerts" %>
            <li class="admin-nav-item <%= "active" if data_alerts_active %>">
              <%= link_to admin_data_alerts_path, class: "admin-nav-link", data: { tooltip: "数据预警" } do %>
                <div class="admin-nav-link-main">
                  <div class="admin-nav-icon">
                    🚨
                  </div>
                  <div class="admin-nav-label">
                    数据预警
                  </div>
                </div>
                <div class="admin-nav-meta">
                  Data Alerts
                </div>
              <% end %>
            </li>
          </ul>
        </div>

        <div class="admin-sidebar-section" data-section-name="accounts" data-sidebar-target="section">
          <div class="admin-sidebar-section-title"
               data-action="click->sidebar#toggleSection">
            <span>账号与浏览器</span>
            <span class="section-arrow">▾</span>
          </div>
          <ul class="admin-nav">
            <% browsers_active = controller_path == "admin/browsers" %>
            <li class="admin-nav-item <%= "active" if browsers_active %>">
              <%= link_to admin_browsers_path, class: "admin-nav-link", data: { tooltip: "浏览器池" } do %>
                <div class="admin-nav-link-main">
                  <div class="admin-nav-icon">
                    🌐
                  </div>
                  <div class="admin-nav-label">
                    浏览器池
                  </div>
                </div>
                <div class="admin-nav-meta">
                  Browsers
                </div>
              <% end %>
            </li>
            
            <% accounts_active = controller_path == "admin/accounts" %>
            <li class="admin-nav-item <%= "active" if accounts_active %>">
              <%= link_to admin_accounts_path, class: "admin-nav-link", data: { tooltip: "账号管理" } do %>
                <div class="admin-nav-link-main">
                  <div class="admin-nav-icon">
                    👤
                  </div>
                  <div class="admin-nav-label">
                    账号管理
                  </div>
                </div>
                <div class="admin-nav-meta">
                  Accounts
                </div>
              <% end %>
            </li>
          </ul>
        </div>

        <div class="admin-sidebar-section" data-section-name="content" data-sidebar-target="section">
          <div class="admin-sidebar-section-title"
               data-action="click->sidebar#toggleSection">
            <span>内容储备</span>
            <span class="section-arrow">▾</span>
          </div>
          <ul class="admin-nav">

            <% grok_image_active = controller_path == "admin/grok_image_resources" %>
            <li class="admin-nav-item <%= "active" if grok_image_active %>">
              <%= link_to admin_grok_image_resources_path, class: "admin-nav-link", data: { tooltip: "Grok 图片储备" } do %>
                <div class="admin-nav-link-main">
                  <div class="admin-nav-icon">
                    🖼️
                  </div>
                  <div class="admin-nav-label">
                    Grok 图片储备
                  </div>
                </div>
                <div class="admin-nav-meta">
                  Grok Images
                </div>
              <% end %>
            </li>

            <% move_videos_active = controller_path == "admin/move_videos" %>
            <li class="admin-nav-item <%= "active" if move_videos_active %>">
              <%= link_to admin_move_videos_path, class: "admin-nav-link", data: { tooltip: "搬运视频储备" } do %>
                <div class="admin-nav-link-main">
                  <div class="admin-nav-icon">
                    🎞️
                  </div>
                  <div class="admin-nav-label">
                    搬运视频储备
                  </div>
                </div>
                <div class="admin-nav-meta">
                  Move Videos
                </div>
              <% end %>
            </li>

            <% red_note_active = controller_path == "admin/red_note_keywords" %>
            <li class="admin-nav-item <%= "active" if red_note_active %>">
              <%= link_to admin_red_note_keywords_path, class: "admin-nav-link", data: { tooltip: "RedNote照片" } do %>
                <div class="admin-nav-link-main">
                  <div class="admin-nav-icon">
                    📷
                  </div>
                  <div class="admin-nav-label">
                    RedNote照片
                  </div>
                </div>
                <div class="admin-nav-meta">
                  RedNote Photos
                </div>
              <% end %>
            </li>

            <% huasheng_active = controller_path == "admin/huasheng_keywords" %>
            <li class="admin-nav-item <%= "active" if huasheng_active %>">
              <%= link_to admin_huasheng_keywords_path, class: "admin-nav-link", data: { tooltip: "花生视频储备" } do %>
                <div class="admin-nav-link-main">
                  <div class="admin-nav-icon">
                    🎥
                  </div>
                  <div class="admin-nav-label">
                    花生视频储备
                  </div>
                </div>
                <div class="admin-nav-meta">
                  Huasheng Videos
                </div>
              <% end %>
            </li>

            <% notebooklm_active = controller_path == "admin/notebooklm_keywords" %>
            <li class="admin-nav-item <%= "active" if notebooklm_active %>">
              <%= link_to admin_notebooklm_keywords_path, class: "admin-nav-link", data: { tooltip: "NotebookLM 视频储备" } do %>
                <div class="admin-nav-link-main">
                  <div class="admin-nav-icon">
                    📓
                  </div>
                  <div class="admin-nav-label">
                    NotebookLM 视频储备
                  </div>
                </div>
                <div class="admin-nav-meta">
                  NotebookLM Videos
                </div>
              <% end %>
            </li>
          </ul>
        </div>

        <div class="admin-sidebar-section" data-section-name="tasks" data-sidebar-target="section">
          <div class="admin-sidebar-section-title"
               data-action="click->sidebar#toggleSection">
            <span>资源队列</span>
            <span class="section-arrow">▾</span>
          </div>
          <ul class="admin-nav">
            <% WorkMode.resource_modes.each do |mode| %>
              <% active = controller_path == mode.controller_path %>
              <li class="admin-nav-item <%= "active" if active %>">
                <%= link_to public_send(mode.route_helper), class: "admin-nav-link", data: { tooltip: mode.sidebar_label } do %>
                  <div class="admin-nav-link-main">
                    <div class="admin-nav-icon">
                      <%= mode.icon %>
                    </div>
                    <div class="admin-nav-label">
                      <%= mode.sidebar_label %>
                    </div>
                  </div>
                  <div class="admin-nav-meta">
                    <%= mode.sidebar_meta %>
                  </div>
                <% end %>
              </li>
            <% end %>
            
            <% logs_active = controller_path == "admin/task_logs" %>
            <li class="admin-nav-item <%= "active" if logs_active %>">
              <%= link_to admin_task_logs_path, class: "admin-nav-link", data: { tooltip: "任务日志" } do %>
                <div class="admin-nav-link-main">
                  <div class="admin-nav-icon">
                    📜
                  </div>
                  <div class="admin-nav-label">
                    任务日志
                  </div>
                </div>
                <div class="admin-nav-meta">
                  Logs
                </div>
              <% end %>
            </li>
          </ul>
        </div>

        <div class="admin-sidebar-section" data-section-name="warmup" data-sidebar-target="section">
          <div class="admin-sidebar-section-title"
               data-action="click->sidebar#toggleSection">
            <span>养号管理</span>
            <span class="section-arrow">▾</span>
          </div>
          <ul class="admin-nav">
            <% queue_active = controller_path == "admin/warmup_queue" %>
            <li class="admin-nav-item <%= "active" if queue_active %>">
              <%= link_to admin_warmup_queue_index_path, class: "admin-nav-link", data: { tooltip: "养号配置" } do %>
                <div class="admin-nav-link-main">
                  <div class="admin-nav-icon">
                    🧑‍💻
                  </div>
                  <div class="admin-nav-label">
                    养号配置
                  </div>
                </div>
                <div class="admin-nav-meta">
                  Config
                </div>
              <% end %>
            </li>
            <% warmup_active = controller_path == "admin/warmup_tasks" %>
            <li class="admin-nav-item <%= "active" if warmup_active %>">
              <%= link_to admin_warmup_tasks_path, class: "admin-nav-link", data: { tooltip: "养号日志" } do %>
                <div class="admin-nav-link-main">
                  <div class="admin-nav-icon">
                    📋
                  </div>
                  <div class="admin-nav-label">
                    养号日志
                  </div>
                </div>
                <div class="admin-nav-meta">
                  Logs
                </div>
              <% end %>
            </li>
          </ul>
        </div>

        <div class="admin-sidebar-section" data-section-name="kol" data-sidebar-target="section">
          <div class="admin-sidebar-section-title"
               data-action="click->sidebar#toggleSection">
            <span>KOL 触达</span>
            <span class="section-arrow">▾</span>
          </div>
          <ul class="admin-nav">
            <% kols_active = controller_path == "admin/kols" %>
            <li class="admin-nav-item <%= "active" if kols_active %>">
              <%= link_to admin_kols_path, class: "admin-nav-link", data: { tooltip: "KOL 管理" } do %>
                <div class="admin-nav-link-main">
                  <div class="admin-nav-icon">
                    ⭐
                  </div>
                  <div class="admin-nav-label">
                    KOL 管理
                  </div>
                </div>
                <div class="admin-nav-meta">
                  KOLs
                </div>
              <% end %>
            </li>
            <% templates_active = controller_path == "admin/message_templates" %>
            <li class="admin-nav-item <%= "active" if templates_active %>">
              <%= link_to admin_message_templates_path, class: "admin-nav-link", data: { tooltip: "消息模板" } do %>
                <div class="admin-nav-link-main">
                  <div class="admin-nav-icon">
                    💬
                  </div>
                  <div class="admin-nav-label">
                    消息模板
                  </div>
                </div>
                <div class="admin-nav-meta">
                  Templates
                </div>
              <% end %>
            </li>
            <% variables_active = controller_path == "admin/message_variables" %>
            <li class="admin-nav-item <%= "active" if variables_active %>">
              <%= link_to admin_message_variables_path, class: "admin-nav-link", data: { tooltip: "变量管理" } do %>
                <div class="admin-nav-link-main">
                  <div class="admin-nav-icon">
                    🧩
                  </div>
                  <div class="admin-nav-label">
                    变量管理
                  </div>
                </div>
                <div class="admin-nav-meta">
                  Variables
                </div>
              <% end %>
            </li>
          </ul>
        </div>

        <div class="admin-sidebar-section" data-section-name="stats" data-sidebar-target="section">
          <div class="admin-sidebar-section-title"
               data-action="click->sidebar#toggleSection">
            <span>数据统计</span>
            <span class="section-arrow">▾</span>
          </div>
          <ul class="admin-nav">
            <% post_stats_active = controller_path == "admin/post_stats" %>
            <li class="admin-nav-item <%= "active" if post_stats_active %>">
              <%= link_to admin_post_stats_path, class: "admin-nav-link", data: { tooltip: "发文数据统计" } do %>
                <div class="admin-nav-link-main">
                  <div class="admin-nav-icon">
                    📈
                  </div>
                  <div class="admin-nav-label">
                    发文数据统计
                  </div>
                </div>
                <div class="admin-nav-meta">
                  Post Stats
                </div>
              <% end %>
            </li>

            <% account_stats_active = controller_path == "admin/account_stats" %>
            <li class="admin-nav-item <%= "active" if account_stats_active %>">
              <%= link_to admin_account_stats_path, class: "admin-nav-link", data: { tooltip: "账号数据统计" } do %>
                <div class="admin-nav-link-main">
                  <div class="admin-nav-icon">
                    🎯
                  </div>
                  <div class="admin-nav-label">
                    账号数据统计
                  </div>
                </div>
                <div class="admin-nav-meta">
                  Account Stats
                </div>
              <% end %>
            </li>
          </ul>
        </div>

        <div class="admin-sidebar-section" data-section-name="config" data-sidebar-target="section">
          <div class="admin-sidebar-section-title"
               data-action="click->sidebar#toggleSection">
            <span>系统设置</span>
            <span class="section-arrow">▾</span>
          </div>
          <ul class="admin-nav">
            <% themes_active = controller_path == "admin/themes" %>
            <li class="admin-nav-item <%= "active" if themes_active %>">
              <%= link_to admin_themes_path, class: "admin-nav-link", data: { tooltip: "主题管理" } do %>
                <div class="admin-nav-link-main">
                  <div class="admin-nav-icon">
                    🏷️
                  </div>
                  <div class="admin-nav-label">
                    主题管理
                  </div>
                </div>
                <div class="admin-nav-meta">
                  Themes
                </div>
              <% end %>
            </li>
          </ul>
        </div>

        </nav>

        <div class="admin-sidebar-footer">
          <div class="admin-sidebar-footer-label">
            已登录管理员
          </div>
          <div class="admin-sidebar-footer-email">
            <%= current_admin&.email %>
          </div>
        </div>
      </aside>

      <main class="admin-main">
        <header class="admin-topbar">
          <div class="admin-topbar-left">
            <div class="admin-topbar-title">
              <%= content_for?(:page_title) ? yield(:page_title) : "控制台" %>
            </div>
            <div class="admin-topbar-subtitle">
              <%= content_for?(:page_subtitle) ? yield(:page_subtitle) : "账号与任务调度的可视化后台" %>
            </div>
          </div>
          <div class="admin-topbar-right">
            <div class="admin-pill">
              <span class="admin-pill-dot"></span>
              在线
            </div>
            <%= link_to "退出登录", destroy_admin_session_path, data: { "turbo-method": :delete }, class: "admin-link-quiet" %>
          </div>
        </header>

        <div class="admin-content">
          <% if notice %>
            <div style="padding: 12px 16px; background: rgba(34, 197, 94, 0.15); border: 1px solid rgba(34, 197, 94, 0.4); border-radius: 6px; margin-bottom: 16px; color: #86efac; font-size: 13px;">
              <%= notice %>
            </div>
          <% end %>
          <% if alert %>
            <div style="padding: 12px 16px; background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.4); border-radius: 6px; margin-bottom: 16px; color: #fca5a5; font-size: 13px;">
              <%= alert %>
            </div>
          <% end %>
          <%= yield %>
        </div>
      </main>
    </div>
  </body>
</html>